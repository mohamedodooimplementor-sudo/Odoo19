<odoo>
    <!-- ============ Reports (analysis) ============ -->
    <record id="action_report_incoming" model="ir.actions.act_window">
        <field name="name">Checks Received (Incoming)</field>
        <field name="res_model">check.management</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('check_type', '=', 'incoming')]</field>
        <field name="context">{'default_check_type': 'incoming'}</field>
        <field name="search_view_id" ref="view_check_management_search"/>
    </record>

    <record id="action_report_outgoing" model="ir.actions.act_window">
        <field name="name">Checks Sent (Outgoing)</field>
        <field name="res_model">check.management</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('check_type', '=', 'outgoing')]</field>
        <field name="context">{'default_check_type': 'outgoing'}</field>
        <field name="search_view_id" ref="view_check_management_search"/>
    </record>

    <record id="action_report_maturity" model="ir.actions.act_window">
        <field name="name">Maturity Analysis (Open Checks)</field>
        <field name="res_model">check.management</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', 'in', ('draft', 'received', 'deposited', 'under_collection', 'handed_over'))]</field>
        <field name="search_view_id" ref="view_check_management_search"/>
    </record>
    <record id="action_report_maturity_pivot" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_check_management_pivot_maturity"/>
        <field name="act_window_id" ref="action_report_maturity"/>
    </record>
    <record id="action_report_maturity_graph" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_check_management_graph"/>
        <field name="act_window_id" ref="action_report_maturity"/>
    </record>
    <record id="action_report_maturity_list" model="ir.actions.act_window.view">
        <field name="sequence">3</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_check_management_list"/>
        <field name="act_window_id" ref="action_report_maturity"/>
    </record>

    <record id="action_report_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Checks</field>
        <field name="res_model">check.management</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('is_overdue', '=', True)]</field>
        <field name="search_view_id" ref="view_check_management_search"/>
    </record>

    <record id="action_report_bounced" model="ir.actions.act_window">
        <field name="name">Bounced Checks</field>
        <field name="res_model">check.management</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('state', '=', 'bounced')]</field>
        <field name="search_view_id" ref="view_check_management_search"/>
    </record>

    <!-- ============ Journal entries generated by checks ============ -->
    <record id="action_check_journal_entries" model="ir.actions.act_window">
        <field name="name">Check Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_id', '!=', False)]</field>
    </record>
</odoo>
