<odoo>
    <!-- Groups are attached to a privilege; record rules now live in ir.access.csv (Odoo 20) -->
    <record id="res_groups_privilege_check_management" model="res.groups.privilege">
        <field name="name">Check Management</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="sequence">60</field>
    </record>

    <record id="check_management_group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_check_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="check_management_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_check_management"/>
        <field name="implied_ids" eval="[(4, ref('check_management_group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
