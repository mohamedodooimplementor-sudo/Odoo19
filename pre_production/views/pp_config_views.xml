<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pp_stage_list" model="ir.ui.view">
        <field name="name">pp.stage.list</field>
        <field name="model">pp.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="fold"/>
            </list>
        </field>
    </record>
    <record id="action_pp_stage" model="ir.actions.act_window">
        <field name="name">Stage Configuration</field>
        <field name="res_model">pp.stage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_pp_template_list" model="ir.ui.view">
        <field name="name">pp.quality.template.list</field>
        <field name="model">pp.quality.template</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="stage_code"/></list></field>
    </record>
    <record id="view_pp_template_form" model="ir.ui.view">
        <field name="name">pp.quality.template.form</field>
        <field name="model">pp.quality.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="stage_code"/><field name="active"/></group>
                    <field name="line_ids">
                        <list editable="bottom"><field name="sequence" widget="handle"/><field name="line_type"/><field name="name" required="line_type == 'manual'" placeholder="Write the inspection item..."/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_pp_template" model="ir.actions.act_window">
        <field name="name">Quality Report Templates</field>
        <field name="res_model">pp.quality.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_config_settings_view_form_pp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Pre-Production" string="Pre-Production" name="pre_production"
                     groups="pre_production.group_pp_manager">
                    <block title="Warehouse" name="pp_wh">
                        <setting string="Manufacturing Warehouse" help="Warehouse where final manufacturing takes place.">
                            <field name="pp_manufacturing_warehouse_id"/>
                        </setting>
                    </block>
                    <block title="Stock Transfers" name="pp_transfers">
                        <setting string="Auto-validate Issue Transfers"
                                 help="When enabled, the issue transfers are validated automatically when you press Issue. When disabled, the transfers are created and reserved, and the stock user validates them manually; the order moves to the next stage once all of them are done.">
                            <field name="pp_auto_validate_issue"/>
                        </setting>
                    </block>
                    <block title="Workflow Requirements" name="pp_req">
                        <setting string="Lot Number Required" help="A lot must be selected for each lot-tracked material before issue.">
                            <field name="pp_lot_required"/>
                        </setting>
                        <setting string="Material Issue Required" help="Material issue must be done before leaving the issue stage.">
                            <field name="pp_material_issue_required"/>
                        </setting>
                        <setting string="Packaging Issue Required" help="Packaging issue must be done before leaving the issue stage.">
                            <field name="pp_packaging_issue_required"/>
                        </setting>
                        <setting string="Weight Confirmation Required" help="Weight must be confirmed (checkbox) on all lines.">
                            <field name="pp_weight_required"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
