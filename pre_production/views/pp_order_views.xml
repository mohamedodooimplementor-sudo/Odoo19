<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pp_order_list" model="ir.ui.view">
        <field name="name">pp.order.list</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'done'"
                  decoration-info="state == 'in_progress'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="order_date" optional="show"/>
                <field name="partner_id"/>
                <field name="sale_order_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_qty" sum="Planned Total"/><field name="actual_product_qty" optional="show"/><field name="waste_qty" optional="show"/>
                <field name="current_stage_id" widget="badge" decoration-info="state == 'in_progress'"
                       decoration-success="state == 'done'" decoration-danger="state == 'rejected'"/>
                <field name="components_availability" widget="badge" optional="show"
                       decoration-success="components_availability in ('available', 'issued')"
                       decoration-danger="components_availability == 'not_available'"/>
                <field name="mo_id" optional="show"/>
                <field name="lot_producing_id" optional="show"/>
                <field name="production_date" optional="show"/>
                <field name="activity_exception_decoration" widget="activity_exception"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'" decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('draft', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_pp_order_form" model="ir.ui.view">
        <field name="name">pp.order.form</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <form>
                <field name="stage_code" invisible="1"/>
                <field name="rejected_check_id" invisible="1"/>
                <field name="material_issue_done" invisible="1"/>
                <field name="packaging_issue_done" invisible="1"/>
                <field name="mo_confirmed" invisible="1"/>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_issue" type="object" string="Issue" class="btn-primary"
                            invisible="state != 'in_progress' or stage_code != 'material_issue'"/>
                    <button name="action_confirm_weights" type="object" string="Confirm Weights" class="btn-primary"
                            invisible="state != 'in_progress' or stage_code != 'weight'"/>
                    <button name="action_create_mo" type="object" string="Create MO &amp; Final Transfer" class="btn-primary"
                            invisible="state != 'in_progress' or stage_code != 'done'"
                            groups="pre_production.group_pp_final"
                            confirm="Create the Manufacturing Order and the final transfer now?"/>
                    <button name="action_print_final" type="object" string="Print Final Report" class="btn-secondary"
                            invisible="state != 'done'"/>
                    <button name="action_reinspect" type="object" string="Re-inspect" class="btn-primary" invisible="state != 'rejected'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancel')"/>
                    <field name="current_stage_id" widget="statusbar" options="{'clickable': False}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancel'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale" type="object" class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_id"><span>Sales Order</span></button>
                        <button name="action_open_pickings" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="picking_count" widget="statinfo" string="Transfers"/></button>
                        <button name="action_open_checks" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="check_count" widget="statinfo" string="Quality Checks"/></button>
                        <button name="action_open_mo" type="object" class="oe_stat_button" icon="fa-cogs"
                                invisible="not mo_id"><span>Manufacturing Order</span></button>
                        <button name="action_open_locks" type="object" class="oe_stat_button" icon="fa-barcode">
                            <field name="lock_count" widget="statinfo" string="Lots"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="product_tracking" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group name="pp_left">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="order_date" readonly="state == 'cancel'"/>
                            <field name="sale_order_id" invisible="not sale_order_id" readonly="1"/>
                            <field name="product_id" readonly="state != 'draft'"/>
                            <label for="product_qty"/>
                            <div class="o_row">
                                <field name="product_qty" class="oe_inline" readonly="state != 'draft'"/>
                                <field name="product_uom_id" class="oe_inline" readonly="state != 'draft'"/>
                            </div>
                            <label for="actual_product_qty"/>
                            <div class="o_row">
                                <field name="actual_product_qty" class="oe_inline" readonly="state != 'in_progress' or stage_code not in ('product_check2', 'done')"/>
                                <field name="product_uom_id" class="oe_inline" readonly="1"/>
                            </div>
                            <field name="waste_qty" readonly="1"/>
                        </group>
                        <group name="pp_right">
                            <field name="bom_id" readonly="state != 'draft'"/>
                            <field name="manufacturing_warehouse_id" readonly="state != 'draft'"/>
                            <field name="lot_producing_id"
                                   readonly="product_tracking == 'none' or state in ('done', 'cancel')"
                                   required="product_tracking != 'none' and state == 'in_progress' and stage_code == 'product_check2'"
                                   context="{'default_product_id': product_id, 'default_company_id': company_id}"/>
                            <field name="mo_id" invisible="not mo_id"/>
                            <field name="production_date" invisible="not production_date"/>
                            <field name="weight_all" invisible="state != 'in_progress' or stage_code != 'weight'"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials" name="materials" invisible="state == 'draft'">
                            <field name="material_line_ids" context="{'default_line_type': 'material'}">
                                <list editable="bottom" delete="0">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="tracking" column_invisible="1"/>
                                    <field name="allowed_warehouse_ids" column_invisible="1"/>
                                    <field name="issued" column_invisible="1"/>
                                    <field name="bom_product_id" optional="show" readonly="1"/>
                                    <field name="is_substituted" optional="show" readonly="1"/>
                                    <field name="product_id" string="Actual Material" readonly="issued"/>
                                    <field name="substitution_note" optional="hide" readonly="issued"/>
                                    <field name="required_qty" readonly="issued"/>
                                    <field name="uom_id" readonly="issued"/>
                                    <field name="unit_cost" optional="hide" groups="pre_production.group_pp_cost"/>
                                    <field name="cost" optional="show" groups="pre_production.group_pp_cost"/>
                                    <field name="source_warehouse_id" options="{'no_create': True}" readonly="issued"/>
                                    <field name="available_qty"/>
                                    <field name="available_lot_ids" column_invisible="1"/>
                                    <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}"
                                           readonly="tracking == 'none' or issued"/>
                                    <field name="lot_summary" optional="hide"/>
                                    <field name="selected_qty"/>
                                    <field name="weight_confirmed"/>
                                    <button name="action_remove_line" type="object" icon="fa-trash" title="Remove line"
                                            invisible="issued"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" col="2" invisible="state == 'draft'" groups="pre_production.group_pp_cost">
                                <field name="material_cost_total"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Packaging" name="packaging" invisible="state == 'draft'">
                            <field name="packaging_line_ids" context="{'default_line_type': 'packaging'}">
                                <list editable="bottom" delete="0">
                                    <field name="line_type" column_invisible="1"/>
                                    <field name="tracking" column_invisible="1"/>
                                    <field name="allowed_warehouse_ids" column_invisible="1"/>
                                    <field name="issued" column_invisible="1"/>
                                    <field name="bom_product_id" optional="show" readonly="1"/>
                                    <field name="is_substituted" optional="show" readonly="1"/>
                                    <field name="product_id" string="Actual Packaging" readonly="issued"/>
                                    <field name="substitution_note" optional="hide" readonly="issued"/>
                                    <field name="required_qty" readonly="issued"/>
                                    <field name="uom_id" readonly="issued"/>
                                    <field name="unit_cost" optional="hide" groups="pre_production.group_pp_cost"/>
                                    <field name="cost" optional="show" groups="pre_production.group_pp_cost"/>
                                    <field name="source_warehouse_id" options="{'no_create': True}" readonly="issued"/>
                                    <field name="available_qty"/>
                                    <field name="available_lot_ids" column_invisible="1"/>
                                    <field name="lot_ids" widget="many2many_tags" options="{'no_create': True}"
                                           readonly="tracking == 'none' or issued"/>
                                    <field name="lot_summary" optional="hide"/>
                                    <field name="selected_qty"/>
                                    <field name="weight_confirmed"/>
                                    <button name="action_remove_line" type="object" icon="fa-trash" title="Remove line"
                                            invisible="issued"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" col="2" invisible="state == 'draft'" groups="pre_production.group_pp_cost">
                                <field name="packaging_cost_total"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="view_pp_order_line_form" model="ir.ui.view">
        <field name="name">pp.order.line.form</field>
        <field name="model">pp.order.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="product_id" readonly="1"/>
                        <field name="required_qty" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="source_warehouse_id" readonly="1"/>
                        <field name="available_qty"/>
                        <field name="selected_qty"/>
                        <field name="issued" invisible="1"/>
                    </group>
                </group>
                <field name="lot_line_ids">
                    <list editable="bottom">
                        <field name="available_lot_ids" column_invisible="1"/>
                        <field name="lot_id" options="{'no_create': True}"/>
                        <field name="available_qty"/>
                        <field name="qty"/>
                    </list>
                </field>
            </form>
        </field>
    </record>

    <record id="view_pp_order_search" model="ir.ui.view">
        <field name="name">pp.order.search</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="lot_producing_id" string="Finished Product Lot" filter_domain="[('lot_producing_id.name', 'ilike', self)]"/>
                <field name="lock_ids" string="Material Lot" filter_domain="[('lock_ids.lot_id.name', 'ilike', self)]"/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="f_wait" string="Waiting Approval" domain="[('state', '=', 'in_progress'), ('check_ids.state', '=', 'pending')]"/>
                <filter name="f_issue" string="Material Issue Pending" domain="[('state', '=', 'in_progress'), ('stage_code', '=', 'material_issue')]"/>
                <filter name="f_weight" string="Weight Confirmation Pending" domain="[('state', '=', 'in_progress'), ('stage_code', '=', 'weight')]"/>
                <filter name="f_comp_ok" string="Components Available" domain="[('components_availability', '=', 'available')]"/>
                <filter name="f_comp_ko" string="Components Not Available" domain="[('components_availability', '=', 'not_available')]"/>
                <filter name="f_ready_mo" string="Ready for Manufacturing Order" domain="[('state', '=', 'in_progress'), ('stage_code', '=', 'done')]"/>
                <filter name="f_quality" string="Quality Check Pending" domain="[('state', '=', 'in_progress'), ('stage_code', 'in', ('prd_line','product_check1','product_check','filling','pack_line','product_check2'))]"/>
                <filter name="f_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <filter name="f_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="f_mo" string="MO Created" domain="[('mo_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="g_stage" string="Stage" context="{'group_by': 'current_stage_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    
                    <filter name="g_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_date" string="Order Date" context="{'group_by': 'order_date:month'}"/>
                    <filter name="g_pdate" string="Production Date" context="{'group_by': 'production_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pp_order_kanban" model="ir.ui.view">
        <field name="name">pp.order.kanban</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="current_stage_id" records_draggable="false" group_create="false"
                    group_delete="false" group_edit="false" quick_create="false" class="o_kanban_small_column">
                <field name="state"/>
                <field name="production_date"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="ps-2 border-start border-3 small #{record.state.raw_value == 'done' ? 'border-success' : record.state.raw_value == 'rejected' ? 'border-danger' : record.state.raw_value == 'in_progress' ? 'border-info' : record.state.raw_value == 'cancel' ? 'border-secondary opacity-50' : 'border-warning'}">
                            <div class="d-flex justify-content-between align-items-center">
                                <field name="name" class="fw-bold"/>
                                <field name="state" widget="badge" decoration-info="state == 'in_progress'"
                                       decoration-success="state == 'done'" decoration-danger="state in ('rejected', 'cancel')"
                                       decoration-warning="state == 'draft'"/>
                            </div>
                            <div class="text-truncate"><field name="product_id"/></div>
                            <div class="d-flex justify-content-between align-items-center text-muted">
                                <span class="text-truncate"><field name="partner_id"/></span>
                                <span class="text-truncate ms-2"><field name="sale_order_id"/></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="fw-semibold"><field name="product_qty"/> <field name="product_uom_id"/></span>
                                <field name="components_availability" widget="badge"
                                       decoration-success="components_availability in ('available', 'issued')"
                                       decoration-danger="components_availability == 'not_available'"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center text-muted">
                                <span>
                                    <i class="fa fa-calendar me-1" title="Order Date"/><field name="order_date" widget="date"/>
                                    <span t-if="record.production_date.raw_value" class="text-success ms-2">
                                        <i class="fa fa-check me-1" title="Production Date"/><field name="production_date" widget="date"/>
                                    </span>
                                </span>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_pp_order_graph" model="ir.ui.view">
        <field name="name">pp.order.graph</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <graph type="bar"><field name="current_stage_id"/></graph>
        </field>
    </record>
    <record id="view_pp_order_pivot" model="ir.ui.view">
        <field name="name">pp.order.pivot</field>
        <field name="model">pp.order</field>
        <field name="arch" type="xml">
            <pivot><field name="current_stage_id" type="row"/><field name="state" type="col"/></pivot>
        </field>
    </record>

    <record id="action_pp_order" model="ir.actions.act_window">
        <field name="name">Pre-Production Orders</field>
        <field name="res_model">pp.order</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>
    <record id="action_pp_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">pp.order</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_g_stage': 1}</field>
    </record>

    <!-- Quality checks -->
    <record id="view_pp_check_list" model="ir.ui.view">
        <field name="name">pp.quality.check.list</field>
        <field name="model">pp.quality.check</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state == 'approved'">
                <field name="order_id"/><field name="stage_id"/><field name="attempt"/>
                <field name="product_id"/><field name="state" widget="badge"/><field name="inspector_id"/><field name="date"/>
            </list>
        </field>
    </record>
    <record id="view_pp_check_form" model="ir.ui.view">
        <field name="name">pp.quality.check.form</field>
        <field name="model">pp.quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'pending'"/>
                    <button name="action_print" type="object" string="Print Report"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="order_id"/><field name="stage_id"/><field name="attempt"/><field name="template_id"/>
                        </group>
                        <group>
                            <field name="inspector_id"/><field name="date"/>
                            <field name="approved_by"/><field name="approved_date"/>
                            <field name="rejected_by"/><field name="rejected_date"/>
                        </group>
                    </group>
                    <group><field name="check_all" readonly="state != 'pending'"/></group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="checked"/>
                            <field name="notes"/>
                        </list>
                    </field>
                    <group>
                        <field name="notes"/>
                        <field name="reject_reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_pp_check_search" model="ir.ui.view">
        <field name="name">pp.quality.check.search</field>
        <field name="model">pp.quality.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/><field name="product_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0"><filter name="g_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="g_state" string="Result" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="view_pp_check_pivot" model="ir.ui.view">
        <field name="name">pp.quality.check.pivot</field>
        <field name="model">pp.quality.check</field>
        <field name="arch" type="xml">
            <pivot><field name="stage_id" type="row"/><field name="state" type="col"/></pivot>
        </field>
    </record>
    <record id="action_pp_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">pp.quality.check</field>
        <field name="view_mode">list,form,pivot</field>
    </record>
    <record id="action_pp_quality_report" model="ir.actions.act_window">
        <field name="name">Quality Report</field>
        <field name="res_model">pp.quality.check</field>
        <field name="view_mode">pivot,list,form</field>
    </record>

    <!-- Lots / traceability -->
    <record id="view_pp_lock_list" model="ir.ui.view">
        <field name="name">pp.lock.list</field>
        <field name="model">pp.lock</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="lot_id"/><field name="product_id"/><field name="qty"/>
                <field name="source_warehouse_id"/><field name="picking_id"/>
                <field name="order_id"/><field name="mo_id"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_pp_lock_search" model="ir.ui.view">
        <field name="name">pp.lock.search</field>
        <field name="model">pp.lock</field>
        <field name="arch" type="xml">
            <search>
                <field name="lot_id"/><field name="product_id"/><field name="order_id"/><field name="mo_id"/>
                <group expand="0"><filter name="g_lot" string="Lot" context="{'group_by': 'lot_id'}"/>
                    <filter name="g_order" string="Pre-Production" context="{'group_by': 'order_id'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_pp_lock" model="ir.actions.act_window">
        <field name="name">Lot Traceability</field>
        <field name="res_model">pp.lock</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Stock related actions -->
    <record id="action_pp_material_issues" model="ir.actions.act_window">
        <field name="name">Material Issues</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pp_issue_type', '=', 'material')]</field>
    </record>
    <record id="action_pp_packaging_issues" model="ir.actions.act_window">
        <field name="name">Packaging Issues</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pp_issue_type', '=', 'packaging')]</field>
    </record>
    <record id="action_pp_mos" model="ir.actions.act_window">
        <field name="name">Manufacturing Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pp_order_id', '!=', False)]</field>
    </record>
    <record id="action_pp_issue_report" model="ir.actions.act_window">
        <field name="name">Material Issue Report</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('picking_id.pp_order_id', '!=', False)]</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>
