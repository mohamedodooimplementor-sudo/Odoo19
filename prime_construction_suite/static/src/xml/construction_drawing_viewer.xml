<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="prime_construction_suite.DrawingMarkupViewer" owl="1">
    <div style="background:#f5f6fa;min-height:100%;padding:24px;font-family:'Segoe UI',Arial,sans-serif;">

        <div style="margin-bottom:16px;">
            <h2 style="margin:0;color:#1e293b;font-size:22px;font-weight:800;">Drawing Markup</h2>
            <p style="margin:0;color:#64748b;font-size:13px;" t-if="state.revision">
                <t t-esc="state.revision.file_name"/> — <t t-esc="state.revision.revision_code"/>
            </p>
        </div>

        <t t-if="state.loading">
            <div style="text-align:center;padding:60px;color:#94a3b8;">Loading…</div>
        </t>

        <t t-elif="!state.imageData">
            <div style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:60px;text-align:center;color:#94a3b8;">
                No image file on this revision (or the file is not an image format that can be previewed here).
            </div>
        </t>

        <t t-else="">
            <div style="display:grid;grid-template-columns:2.2fr 1fr;gap:18px;">

                <!-- Image + pins -->
                <div style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:14px;overflow:auto;">
                    <div style="position:relative;display:inline-block;">
                        <img t-ref="drawingImage" t-att-src="state.imageData" t-on-click="onImageClick"
                             style="max-width:100%;display:block;cursor:crosshair;border-radius:8px;"/>
                        <t t-foreach="state.markups" t-as="m" t-key="m.id">
                            <div t-attf-style="position:absolute;left:#{m.pos_x}%;top:#{m.pos_y}%;transform:translate(-50%,-50%);
                                        width:22px;height:22px;border-radius:50%;
                                        background:#{m.resolved ? '#10b981' : '#dc2626'};color:#fff;
                                        display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;
                                        border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.3);cursor:pointer;"
                                 t-att-title="m.comment"
                                 t-on-click.stop="() => this.toggleResolved(m)">
                                <i t-attf-class="fa #{m.resolved ? 'fa-check' : 'fa-exclamation'}"/>
                            </div>
                        </t>
                        <t t-if="state.pendingPin">
                            <div t-attf-style="position:absolute;left:#{state.pendingPin.x}%;top:#{state.pendingPin.y}%;transform:translate(-50%,-50%);
                                        width:22px;height:22px;border-radius:50%;background:#4f46e5;border:2px solid #fff;
                                        box-shadow:0 1px 4px rgba(0,0,0,.3);"/>
                        </t>
                    </div>
                </div>

                <!-- Sidebar: comment list + new pin form -->
                <div style="background:#fff;border-radius:16px;border:1px solid #e2e8f0;padding:18px;">
                    <t t-if="state.pendingPin">
                        <h6 style="margin:0 0 10px;color:#1e293b;font-size:14px;font-weight:700;">New Comment</h6>
                        <textarea t-on-input="setComment" t-att-value="state.newComment"
                                  placeholder="Describe the issue at this point..."
                                  style="width:100%;min-height:70px;border:1px solid #e2e8f0;border-radius:8px;padding:8px;font-size:13px;"/>
                        <div style="display:flex;gap:8px;margin-top:8px;">
                            <button t-on-click="savePin"
                                    style="background:#4f46e5;color:#fff;border:none;padding:7px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">Save Pin</button>
                            <button t-on-click="cancelPin"
                                    style="background:#f1f5f9;color:#475569;border:none;padding:7px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">Cancel</button>
                        </div>
                        <hr style="margin:16px 0;border-color:#f1f5f9;"/>
                    </t>
                    <h6 style="margin:0 0 10px;color:#1e293b;font-size:14px;font-weight:700;">
                        Comments (<t t-esc="state.markups.length"/>)
                    </h6>
                    <p style="color:#94a3b8;font-size:12px;margin-bottom:12px;">Click anywhere on the drawing to pin a new comment.</p>
                    <div style="max-height:420px;overflow-y:auto;">
                        <t t-foreach="state.markups" t-as="m" t-key="'c'+m.id">
                            <div style="padding:10px 0;border-bottom:1px solid #f8fafc;">
                                <div style="display:flex;justify-content:space-between;">
                                    <span t-attf-style="font-size:11px;font-weight:700;color:#{m.resolved ? '#10b981' : '#dc2626'};">
                                        <t t-esc="m.resolved ? 'RESOLVED' : 'OPEN'"/>
                                    </span>
                                    <span style="font-size:11px;color:#94a3b8;">
                                        <t t-esc="m.author_id ? m.author_id[1] : ''"/>
                                    </span>
                                </div>
                                <div style="font-size:13px;color:#334155;margin-top:4px;"><t t-esc="m.comment"/></div>
                            </div>
                        </t>
                    </div>
                </div>

            </div>
        </t>
    </div>
</t>

</templates>
