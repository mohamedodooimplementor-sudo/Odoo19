<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_rfq_list" model="ir.ui.view">
        <field name="name">construction.rfq.list</field>
        <field name="model">construction.rfq</field>
        <field name="arch" type="xml">
            <list string="RFQs" decoration-success="state == 'awarded'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="date_required"/>
                <field name="vendor_ids" widget="many2many_tags"/>
                <field name="state" widget="badge" decoration-success="state == 'awarded'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_rfq_form" model="ir.ui.view">
        <field name="name">construction.rfq.form</field>
        <field name="model">construction.rfq</field>
        <field name="arch" type="xml">
            <form string="RFQ">
                <header>
                    <button name="action_send" string="Send to Vendors" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_quote_matrix" string="Generate Quote Matrix" type="object" class="btn-secondary" invisible="state not in ('sent','quoted')"/>
                    <button name="action_mark_quoted" string="Mark Quotes Received" type="object" class="btn-secondary" invisible="state != 'sent'"/>
                    <button name="action_award_and_create_pos" string="Award &amp; Create POs" type="object" class="btn-primary" invisible="state != 'quoted'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('awarded','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('cancelled',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,quoted,awarded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="material_request_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="date_required"/>
                        </group>
                    </group>
                    <group string="Vendors Invited">
                        <field name="vendor_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="boq_line_id"/>
                                    <field name="description"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="best_vendor_name" readonly="1"/>
                                    <field name="best_price" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vendor Quotes">
                            <field name="quote_ids">
                                <list editable="bottom" decoration-success="is_awarded">
                                    <field name="rfq_line_id"/>
                                    <field name="vendor_id"/>
                                    <field name="unit_price"/>
                                    <field name="lead_time_days"/>
                                    <field name="is_awarded"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_rfq_search" model="ir.ui.view">
        <field name="name">construction.rfq.search</field>
        <field name="model">construction.rfq</field>
        <field name="arch" type="xml">
            <search string="Search RFQs">
                <field name="name"/>
                <field name="project_id"/>
                <field name="vendor_ids"/>
                <separator/>
                <filter name="draft"   string="Draft"   domain="[('state','=','draft')]"/>
                <filter name="sent"    string="Sent"     domain="[('state','=','sent')]"/>
                <filter name="quoted"  string="Quoted"   domain="[('state','=','quoted')]"/>
                <filter name="awarded" string="Awarded"  domain="[('state','=','awarded')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_state"   string="Status"  context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_construction_rfq_kanban" model="ir.ui.view">
        <field name="name">construction.rfq.kanban</field>
        <field name="model">construction.rfq</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="vendor_ids"/>
                <field name="date_required"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="project_id"/></div>
                            <div class="text-muted small"><field name="vendor_ids" widget="many2many_tags"/></div>
                            <div t-if="record.date_required.raw_value" class="text-muted small">
                                Due: <field name="date_required"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_construction_rfq" model="ir.actions.act_window">
        <field name="name">RFQs</field>
        <field name="res_model">construction.rfq</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_construction_rfq_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a new RFQ</p></field>
    </record>

</odoo>
