<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_guarantee_list" model="ir.ui.view">
        <field name="name">construction.guarantee.list</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <list string="Bank Guarantees" decoration-danger="state == 'expired'" decoration-warning="days_to_expiry &lt;= 30 and state == 'active'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="guarantee_type"/>
                <field name="bank_name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'released'" decoration-danger="state in ('expired','claimed')"/>
            </list>
        </field>
    </record>

    <record id="view_construction_guarantee_form" model="ir.ui.view">
        <field name="name">construction.guarantee.form</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank Guarantee">
                <header>
                    <button name="action_release"     string="Release"     type="object" class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_claim"        string="Mark Claimed" type="object" invisible="state != 'active'"/>
                    <button name="action_reactivate"   string="Reactivate"  type="object" invisible="state not in ('released','expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Guarantee Details">
                            <field name="project_id"/>
                            <field name="contract_id" domain="[('project_id','=',project_id)]"/>
                            <field name="guarantee_type"/>
                            <field name="bank_name"/>
                            <field name="guarantee_number"/>
                        </group>
                        <group string="Amount &amp; Validity">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="release_date" invisible="state not in ('released',)"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_guarantee_search" model="ir.ui.view">
        <field name="name">construction.guarantee.search</field>
        <field name="model">construction.guarantee</field>
        <field name="arch" type="xml">
            <search string="Bank Guarantees">
                <field name="name"/>
                <field name="project_id"/>
                <field name="bank_name"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="expiring_soon" string="Expiring Soon (30 days)" domain="[('state','=','active'),('days_to_expiry','&lt;=',30)]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_type"    string="Type"    context="{'group_by':'guarantee_type'}"/>
                <filter name="group_state"   string="Status"  context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_guarantee" model="ir.actions.act_window">
        <field name="name">Bank Guarantees</field>
        <field name="res_model">construction.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record a bank guarantee</p></field>
    </record>

</odoo>
