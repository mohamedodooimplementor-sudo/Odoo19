<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_cost_code_list" model="ir.ui.view">
        <field name="name">construction.cost.code.list</field>
        <field name="model">construction.cost.code</field>
        <field name="arch" type="xml">
            <list string="Cost Codes">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_construction_cost_code_form" model="ir.ui.view">
        <field name="name">construction.cost.code.form</field>
        <field name="model">construction.cost.code</field>
        <field name="arch" type="xml">
            <form string="Cost Code">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_cost_code" model="ir.actions.act_window">
        <field name="name">Cost Codes (WBS)</field>
        <field name="res_model">construction.cost.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Define a standard cost code</p></field>
    </record>

</odoo>
