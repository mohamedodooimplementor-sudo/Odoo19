<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_program_list" model="ir.ui.view">
        <field name="name">construction.program.list</field>
        <field name="model">construction.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="name"/>
                <field name="manager_id"/>
                <field name="project_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_contract_value"/>
            </list>
        </field>
    </record>

    <record id="view_construction_program_form" model="ir.ui.view">
        <field name="name">construction.program.form</field>
        <field name="model">construction.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_projects" class="oe_stat_button" icon="fa-building">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Program name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_contract_value" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <field name="project_ids">
                        <list>
                            <field name="name"/>
                            <field name="client_id"/>
                            <field name="state" widget="badge"/>
                            <field name="progress_percent" widget="progressbar"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="contract_value"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_program" model="ir.actions.act_window">
        <field name="name">Programs / Portfolios</field>
        <field name="res_model">construction.program</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Group related projects into a program</p></field>
    </record>

</odoo>
