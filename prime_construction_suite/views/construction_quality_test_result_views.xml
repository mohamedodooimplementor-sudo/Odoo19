<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_quality_test_result_list" model="ir.ui.view">
        <field name="name">construction.quality.test.result.list</field>
        <field name="model">construction.quality.test.result</field>
        <field name="arch" type="xml">
            <list string="Test Results" decoration-danger="result == 'fail'" decoration-success="result == 'pass'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="test_type" widget="badge"/>
                <field name="test_name"/>
                <field name="test_date"/>
                <field name="lab_id" optional="show"/>
                <field name="spec_value"/>
                <field name="actual_value"/>
                <field name="uom_label"/>
                <field name="result" widget="badge" decoration-danger="result == 'fail'" decoration-success="result == 'pass'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_quality_test_result_form" model="ir.ui.view">
        <field name="name">construction.quality.test.result.form</field>
        <field name="model">construction.quality.test.result</field>
        <field name="arch" type="xml">
            <form string="Test Result">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="boq_line_id"/>
                            <field name="inspection_id"/>
                            <field name="test_type"/>
                            <field name="test_name"/>
                        </group>
                        <group>
                            <field name="lab_id"/>
                            <field name="sample_date"/>
                            <field name="test_date"/>
                        </group>
                    </group>
                    <group string="Result">
                        <group>
                            <field name="spec_value"/>
                            <field name="actual_value"/>
                            <field name="uom_label"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="certificate" filename="certificate_filename"/>
                            <field name="certificate_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_quality_test_result_search" model="ir.ui.view">
        <field name="name">construction.quality.test.result.search</field>
        <field name="model">construction.quality.test.result</field>
        <field name="arch" type="xml">
            <search string="Search Test Results">
                <field name="name"/>
                <field name="project_id"/>
                <field name="lab_id"/>
                <separator/>
                <filter name="pass" string="Pass" domain="[('result','=','pass')]"/>
                <filter name="fail" string="Fail" domain="[('result','=','fail')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_type"    string="Test Type" context="{'group_by':'test_type'}"/>
                <filter name="group_result"  string="Result" context="{'group_by':'result'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_quality_test_result" model="ir.actions.act_window">
        <field name="name">Test Results</field>
        <field name="res_model">construction.quality.test.result</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_quality_test_result_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Log a new test result</p></field>
    </record>

</odoo>
