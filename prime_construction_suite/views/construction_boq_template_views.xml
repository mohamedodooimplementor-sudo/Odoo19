<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_boq_template_list" model="ir.ui.view">
        <field name="name">construction.boq.template.list</field>
        <field name="model">construction.boq.template</field>
        <field name="arch" type="xml">
            <list string="BOQ Templates">
                <field name="name"/>
                <field name="line_count"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_template_form" model="ir.ui.view">
        <field name="name">construction.boq.template.form</field>
        <field name="model">construction.boq.template</field>
        <field name="arch" type="xml">
            <form string="BOQ Template">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Standard Villa Finishing Package"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_code"/>
                            <field name="description"/>
                            <field name="cost_code_id"/>
                            <field name="uom_id"/>
                            <field name="default_qty"/>
                            <field name="default_unit_price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_boq_template" model="ir.actions.act_window">
        <field name="name">BOQ Templates</field>
        <field name="res_model">construction.boq.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create a reusable BOQ template</p></field>
    </record>

    <record id="view_apply_boq_template_wizard" model="ir.ui.view">
        <field name="name">construction.contract.apply.template.wizard.form</field>
        <field name="model">construction.contract.apply.template.wizard</field>
        <field name="arch" type="xml">
            <form string="Load BOQ from Template">
                <group>
                    <field name="contract_id" invisible="1"/>
                    <field name="template_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Load Lines" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_apply_boq_template_wizard" model="ir.actions.act_window">
        <field name="name">Load from Template</field>
        <field name="res_model">construction.contract.apply.template.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
