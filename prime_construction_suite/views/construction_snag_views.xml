<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_snag_list" model="ir.ui.view">
        <field name="name">construction.snag.list</field>
        <field name="model">construction.snag</field>
        <field name="arch" type="xml">
            <list string="Snagging List" decoration-muted="status == 'closed'" decoration-danger="priority == 'urgent' and status != 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="description"/>
                <field name="location"/>
                <field name="category"/>
                <field name="stage"/>
                <field name="priority" widget="badge"/>
                <field name="date_reported"/>
                <field name="status" widget="badge" decoration-success="status == 'closed'" decoration-warning="status == 'open'" decoration-info="status == 'in_progress'"/>
                <button name="action_close" string="Close" type="object" icon="fa-check" invisible="status == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_snag_form" model="ir.ui.view">
        <field name="name">construction.snag.form</field>
        <field name="model">construction.snag</field>
        <field name="arch" type="xml">
            <form string="Snagging Item">
                <header>
                    <button name="action_start" string="Start Progress" type="object" invisible="status != 'open'"/>
                    <button name="action_close" string="Close" type="object" class="btn-primary" invisible="status == 'closed'"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="status != 'closed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="description" placeholder="Describe the defect / snag..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="location"/>
                            <field name="category"/>
                            <field name="stage"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="date_reported"/>
                            <field name="reported_by"/>
                            <field name="date_closed" invisible="status != 'closed'"/>
                            <field name="closed_by" invisible="status != 'closed'"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_snag_search" model="ir.ui.view">
        <field name="name">construction.snag.search</field>
        <field name="model">construction.snag</field>
        <field name="arch" type="xml">
            <search string="Snagging List">
                <field name="description"/>
                <field name="project_id"/>
                <field name="location"/>
                <filter name="open"    string="Open"        domain="[('status','=','open')]"/>
                <filter name="dlp"     string="During DLP"  domain="[('stage','=','dlp')]"/>
                <separator/>
                <filter name="group_project"  string="Project"  context="{'group_by':'project_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
                <filter name="group_status"   string="Status"   context="{'group_by':'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_snag" model="ir.actions.act_window">
        <field name="name">Snagging List</field>
        <field name="res_model">construction.snag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Log a snag / defect item</p></field>
    </record>

</odoo>
