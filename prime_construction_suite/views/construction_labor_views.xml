<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_laborer_list" model="ir.ui.view">
        <field name="name">construction.laborer.list</field>
        <field name="model">construction.laborer</field>
        <field name="arch" type="xml">
            <list string="Laborers">
                <field name="name"/>
                <field name="trade"/>
                <field name="phone"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="daily_rate"/>
            </list>
        </field>
    </record>

    <record id="view_construction_laborer_form" model="ir.ui.view">
        <field name="name">construction.laborer.form</field>
        <field name="model">construction.laborer</field>
        <field name="arch" type="xml">
            <form string="Laborer">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="trade"/>
                            <field name="national_id"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="daily_rate"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_laborer" model="ir.actions.act_window">
        <field name="name">Laborers</field>
        <field name="res_model">construction.laborer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Register a daily laborer</p></field>
    </record>

    <record id="view_construction_labor_attendance_list" model="ir.ui.view">
        <field name="name">construction.labor.attendance.list</field>
        <field name="model">construction.labor.attendance</field>
        <field name="arch" type="xml">
            <list string="Labor Attendance" editable="bottom" decoration-muted="status == 'absent'">
                <field name="date"/>
                <field name="laborer_id"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="hours_worked"/>
                <field name="overtime_hours" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="daily_rate" optional="hide"/>
                <field name="advance_amount" optional="show"/>
                <field name="deduction_amount" optional="show"/>
                <field name="gross_cost" sum="Gross Total" readonly="1"/>
                <field name="net_cost" sum="Net Total" readonly="1"/>
                <field name="boq_line_id" optional="hide"/>
                <field name="cost_code_id" optional="hide"/>
                <field name="posted" widget="boolean_toggle"/>
                <button name="action_post_to_actual_cost" string="Post to Cost" type="object" icon="fa-arrow-right" invisible="posted"/>
            </list>
        </field>
    </record>

    <record id="view_construction_labor_attendance_search" model="ir.ui.view">
        <field name="name">construction.labor.attendance.search</field>
        <field name="model">construction.labor.attendance</field>
        <field name="arch" type="xml">
            <search string="Labor Attendance">
                <field name="laborer_id"/>
                <field name="project_id"/>
                <filter name="present" string="Present" domain="[('status','=','present')]"/>
                <filter name="absent"  string="Absent"  domain="[('status','=','absent')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_laborer" string="Laborer" context="{'group_by':'laborer_id'}"/>
                <filter name="group_date"    string="Date"    context="{'group_by':'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_labor_attendance" model="ir.actions.act_window">
        <field name="name">Daily Labor Attendance</field>
        <field name="res_model">construction.labor.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Record today's labor attendance</p></field>
    </record>

</odoo>
