<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_kpi_definition_list" model="ir.ui.view">
        <field name="name">construction.kpi.definition.list</field>
        <field name="model">construction.kpi.definition</field>
        <field name="arch" type="xml">
            <list string="KPI Definitions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="kpi_type"/>
                <field name="target_value"/>
                <field name="unit"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_construction_kpi_definition_form" model="ir.ui.view">
        <field name="name">construction.kpi.definition.form</field>
        <field name="model">construction.kpi.definition</field>
        <field name="arch" type="xml">
            <form string="KPI Definition">
                <header>
                    <button name="action_snapshot_all_projects" string="Snapshot Now (All Projects)" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Physical Completion"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kpi_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="target_value"/>
                            <field name="unit"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Recorded Values">
                            <field name="value_ids">
                                <list decoration-danger="status == 'off_track'" decoration-warning="status == 'at_risk'" decoration-success="status == 'on_track'">
                                    <field name="project_id"/>
                                    <field name="date"/>
                                    <field name="value"/>
                                    <field name="target_value"/>
                                    <field name="variance"/>
                                    <field name="status" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_construction_kpi_definition" model="ir.actions.act_window">
        <field name="name">KPI Definitions</field>
        <field name="res_model">construction.kpi.definition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a KPI to track across your projects</p>
            <p>Physical Completion, Cost Variance, Schedule Variance, Safety Incidents and Profit
               Margin are computed automatically. Manual KPIs are entered by hand via their
               recorded values.</p>
        </field>
    </record>

    <record id="view_construction_kpi_value_list" model="ir.ui.view">
        <field name="name">construction.kpi.value.list</field>
        <field name="model">construction.kpi.value</field>
        <field name="arch" type="xml">
            <list string="KPI Values" create="1" decoration-danger="status == 'off_track'" decoration-warning="status == 'at_risk'" decoration-success="status == 'on_track'">
                <field name="kpi_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="value"/>
                <field name="target_value"/>
                <field name="variance"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_construction_kpi_value_search" model="ir.ui.view">
        <field name="name">construction.kpi.value.search</field>
        <field name="model">construction.kpi.value</field>
        <field name="arch" type="xml">
            <search string="Search KPI Values">
                <field name="kpi_id"/>
                <field name="project_id"/>
                <separator/>
                <filter name="on_track"  string="On Track"  domain="[('status','=','on_track')]"/>
                <filter name="at_risk"   string="At Risk"   domain="[('status','=','at_risk')]"/>
                <filter name="off_track" string="Off Track" domain="[('status','=','off_track')]"/>
                <separator/>
                <filter name="group_kpi"     string="KPI"     context="{'group_by':'kpi_id'}"/>
                <filter name="group_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="group_status"  string="Status"  context="{'group_by':'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_kpi_value" model="ir.actions.act_window">
        <field name="name">KPI Dashboard</field>
        <field name="res_model">construction.kpi.value</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_construction_kpi_value_search"/>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

</odoo>
