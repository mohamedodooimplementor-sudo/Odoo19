<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_document_list" model="ir.ui.view">
        <field name="name">construction.document.list</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="date"/>
                <field name="file" widget="binary" filename="file_name"/>
                <field name="file_name" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_construction_document_form" model="ir.ui.view">
        <field name="name">construction.document.form</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Document name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="category"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_document_search" model="ir.ui.view">
        <field name="name">construction.document.search</field>
        <field name="model">construction.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="group_project"  string="Project"  context="{'group_by':'project_id'}"/>
                <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_construction_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">construction.document</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Upload a project document</p></field>
    </record>

</odoo>
