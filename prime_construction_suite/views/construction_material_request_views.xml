<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_material_request_list" model="ir.ui.view">
        <field name="name">construction.material.request.list</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <list string="Material Requests" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'fulfilled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="date_required"/>
                <field name="priority" widget="badge" decoration-danger="priority == 'urgent'" decoration-warning="priority == 'high'"/>
                <field name="line_count" string="Items"/>
                <field name="rfq_count" string="RFQs"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-success" invisible="state != 'submitted'" groups="prime_construction_suite.group_construction_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="prime_construction_suite.group_construction_manager"/>
                    <button name="action_create_rfq" string="Send to RFQ" type="object" class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted','rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,fulfilled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rfqs" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="rfq_count == 0">
                            <field name="rfq_count" widget="statinfo" string="RFQs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="contract_id"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="date_required"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="boq_line_id"/>
                                    <field name="description"/>
                                    <field name="qty_requested"/>
                                    <field name="uom_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_material_request_search" model="ir.ui.view">
        <field name="name">construction.material.request.search</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <search string="Search Material Requests">
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter name="draft"     string="Draft"     domain="[('state','=','draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state','=','submitted')]"/>
                <filter name="approved"  string="Approved"  domain="[('state','=','approved')]"/>
                <separator/>
                <filter name="group_project"  string="Project"  context="{'group_by':'project_id'}"/>
                <filter name="group_priority" string="Priority" context="{'group_by':'priority'}"/>
                <filter name="group_state"    string="Status"   context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_construction_material_request_kanban" model="ir.ui.view">
        <field name="name">construction.material.request.kanban</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="project_id"/>
                <field name="priority"/>
                <field name="date_required"/>
                <field name="line_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="name"/></strong>
                            <div class="text-muted"><field name="project_id"/></div>
                            <div>
                                <span t-attf-class="badge #{record.priority.raw_value == 'urgent' ? 'text-bg-danger' : record.priority.raw_value == 'high' ? 'text-bg-warning' : 'text-bg-secondary'}">
                                    <field name="priority"/>
                                </span>
                                <span class="text-muted float-end"><field name="line_count"/> items</span>
                            </div>
                            <div t-if="record.date_required.raw_value" class="text-muted small">
                                Due: <field name="date_required"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_construction_material_request" model="ir.actions.act_window">
        <field name="name">Material Requests</field>
        <field name="res_model">construction.material.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_construction_material_request_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Log a new material request</p></field>
    </record>

</odoo>
