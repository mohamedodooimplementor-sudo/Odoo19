            <field name="model_id" ref="model_construction_boq_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_construction_actual_cost_company" model="ir.rule">
            <field name="name">Construction Actual Cost: multi-company</field>
