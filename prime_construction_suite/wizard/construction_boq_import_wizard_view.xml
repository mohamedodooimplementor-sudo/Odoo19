<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_boq_import_wizard_form" model="ir.ui.view">
        <field name="name">construction.boq.import.wizard.form</field>
        <field name="model">construction.boq.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import BOQ from Excel">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <group>
                    <field name="note" nolabel="1" class="text-muted"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
