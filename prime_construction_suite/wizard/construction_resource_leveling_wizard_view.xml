<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_resource_leveling_wizard_form" model="ir.ui.view">
        <field name="name">construction.resource.leveling.wizard.form</field>
        <field name="model">construction.resource.leveling.wizard</field>
        <field name="arch" type="xml">
            <form string="Resource Leveling Assistant">
                <p class="text-muted">
                    Detected conflicts where a resource is allocated over 100% across overlapping
                    assignments. Each suggestion pushes the later assignment to start right after
                    the earlier one ends — review before applying, since this doesn't account for
                    project priority or critical-path impact.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="assignment_id" column_invisible="1"/>
                        <field name="resource_display"/>
                        <field name="project_id"/>
                        <field name="current_date_from" readonly="1"/>
                        <field name="current_date_to" readonly="1"/>
                        <field name="conflict_with" readonly="1"/>
                        <field name="suggested_date_from" readonly="1"/>
                        <field name="suggested_date_to" readonly="1"/>
                    </list>
                </field>
                <p class="text-muted" invisible="line_count">
                    No over-allocation conflicts detected right now.
                </p>
                <field name="line_count" invisible="1"/>
                <footer>
                    <button name="action_apply_all" string="Apply All Suggestions" type="object" class="btn-primary" invisible="not line_count"/>
                    <button name="action_refresh" string="Refresh" type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_construction_resource_leveling_wizard" model="ir.actions.act_window">
        <field name="name">Resource Leveling Assistant</field>
        <field name="res_model">construction.resource.leveling.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
