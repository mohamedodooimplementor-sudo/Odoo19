<odoo>
    <record id="view_check_print_template_list" model="ir.ui.view">
        <field name="name">check.print.template.list</field>
        <field name="model">check.print.template</field>
        <field name="arch" type="xml">
            <list string="Check Print Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bank_id"/>
                <field name="design_mode"/>
                <field name="width"/>
                <field name="height"/>
                <field name="words_lang"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_check_print_template_form" model="ir.ui.view">
        <field name="name">check.print.template.form</field>
        <field name="model">check.print.template</field>
        <field name="arch" type="xml">
            <form string="Check Print Template">
                <header>
                    <button name="action_print_sample" type="object" string="Print Sample" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Banque Misr - 17.5 x 8 cm"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="bank_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="design_mode" widget="radio"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="background_image" widget="image" options="{'size': [0, 120]}" invisible="design_mode != 'overlay'"/>
                        </group>
                    </group>

                    <field name="wkhtml_warning" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not wkhtml_warning">
                        <strong>wkhtmltopdf is not the official build.</strong>
                        Printed checks will be scaled down (about 77%) and will not match these millimetres.
                        Install the official wkhtmltopdf 0.12.6.1 <em>with patched Qt</em> (the one Odoo requires),
                        then restart Odoo.
                    </div>

                    <separator string="Live Preview"/>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                    <div class="text-muted small mb-3">
                        Upload a scan of a blank check as "Scanned Check" to align the fields visually, then use
                        <em>Print Sample</em> on real paper and adjust <em>Shift Right / Shift Down</em>.
                        The PDF page size comes from the paper format "Check Leaf"
                        (Settings &gt; Technical &gt; Paper Format).
                    </div>

                    <notebook>
                        <page string="Page &amp; Font" name="page">
                            <group>
                                <group string="Check Size">
                                    <field name="paper_preset"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                </group>
                                <group string="Printer Calibration">
                                    <field name="offset_x"/>
                                    <field name="offset_y"/>
                                </group>
                                <group string="Font">
                                    <field name="font_family"/>
                                    <field name="font_size"/>
                                    <field name="text_color" widget="color"/>
                                    <field name="arabic_digits"/>
                                </group>
                                <group string="Full Check Design" invisible="design_mode != 'full'">
                                    <field name="accent_color" widget="color"/>
                                    <field name="show_labels"/>
                                    <field name="show_signature_line"/>
                                    <field name="show_micr_line"/>
                                </group>
                            </group>
                        </page>
                        <page string="Fields Position" name="positions">
                            <group>
                                <group string="Date">
                                    <field name="date_source"/>
                                    <field name="date_x"/>
                                    <field name="date_y"/>
                                    <field name="date_format"/>
                                    <field name="date_spacing"/>
                                </group>
                                <group string="Amount in Figures">
                                    <field name="amount_x"/>
                                    <field name="amount_y"/>
                                    <field name="amount_width"/>
                                    <field name="amount_prefix"/>
                                    <field name="amount_suffix"/>
                                </group>
                                <group string="Payee">
                                    <field name="payee_x"/>
                                    <field name="payee_y"/>
                                    <field name="payee_width"/>
                                    <field name="payee_align"/>
                                </group>
                                <group string="Amount in Words">
                                    <field name="words_lang"/>
                                    <field name="words_x"/>
                                    <field name="words_y"/>
                                    <field name="words_width"/>
                                    <field name="words_line_height"/>
                                    <field name="words_prefix"/>
                                    <field name="words_suffix"/>
                                </group>
                                <group string="Crossing (Account Payee)">
                                    <field name="crossed"/>
                                    <field name="crossed_text" invisible="not crossed"/>
                                    <field name="cross_x" invisible="not crossed"/>
                                    <field name="cross_y" invisible="not crossed"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_check_print_templates" model="ir.actions.act_window">
        <field name="name">Check Print Templates</field>
        <field name="res_model">check.print.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a check print template</p>
            <p>Define where the date, payee, amount in words and amount in figures are printed on your bank's check leaf.</p>
        </field>
    </record>
</odoo>
