<odoo>
    <record id="view_check_config_form" model="ir.ui.view">
        <field name="name">check.config.form</field>
        <field name="model">check.config</field>
        <field name="arch" type="xml">
            <form string="Accounting Settings" create="0" delete="0">
                <header>
                    <button name="action_create_default_accounts" type="object" string="Create Missing Accounts" class="btn-primary"
                            help="Creates the accounts that are still empty below (they can be renamed afterwards)."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Check Accounting Settings</h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="auto_post"/>
                            <field name="journal_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Incoming Checks (Receipts)">
                            <field name="notes_receivable_account_id" options="{'no_create': True}"/>
                            <field name="under_collection_account_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Outgoing Checks">
                            <field name="notes_payable_account_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Bank">
                            <field name="bank_charges_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <strong>Entries posted automatically</strong>
                        <ul class="mb-0">
                            <li>Incoming – Receive: Dr Notes Receivable / Cr Customer (linked invoices are reconciled)</li>
                            <li>Incoming – Deposit: Dr Checks Under Collection / Cr Notes Receivable (skipped when "Checks Under Collection" is empty)</li>
                            <li>Incoming – Collect: Dr Bank / Cr Checks Under Collection</li>
                            <li>Outgoing – Hand Over: Dr Vendor / Cr Notes Payable (linked bills are reconciled)</li>
                            <li>Outgoing – Cleared: Dr Notes Payable / Cr Bank</li>
                            <li>Bounce: gives the debt back to the partner and re-opens the invoices; Cancel: reverses the entries.</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_check_config_open" model="ir.actions.server">
        <field name="name">Check Accounting Settings</field>
        <field name="model_id" ref="model_check_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>
</odoo>
