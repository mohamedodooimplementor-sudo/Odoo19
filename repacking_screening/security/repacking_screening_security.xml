<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_repacking_screening" model="ir.module.category">
        <field name="name">Repacking &amp; Screening</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_repacking_screening_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_repacking_screening"/>
    </record>

    <record id="group_repacking_screening_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_repacking_screening"/>
        <field name="implied_ids" eval="[(4, ref('group_repacking_screening_user'))]"/>
    </record>

    <!-- Multi-company: users only see operations of their allowed companies -->
    <record id="repacking_screening_operation_company_rule" model="ir.rule">
        <field name="name">Repacking &amp; Screening Operation: multi-company</field>
        <field name="model_id" ref="model_repacking_screening_operation"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
