<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_operation_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h2 class="mb-0">
                                    <span t-field="o.name"/>
                                </h2>
                                <span class="text-muted">
                                    <span t-field="o.operation_type"/> Operation
                                </span>
                            </div>
                            <div class="text-end">
                                <span t-attf-class="badge rounded-pill fs-6
                                      #{o.state == 'done' and 'text-bg-success' or
                                        o.state == 'cancelled' and 'text-bg-danger' or
                                        o.state == 'manufacturing' and 'text-bg-primary' or
                                        'text-bg-info'}">
                                    <span t-field="o.state"/>
                                </span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Product:</strong>
                                <span t-field="o.product_id"/><br/>
                                <strong>Source Location:</strong>
                                <span t-field="o.source_location_id"/><br/>
                                <strong>Manufacturing Location:</strong>
                                <span t-field="o.manufacturing_location_id"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Scheduled Date:</strong>
                                <span t-field="o.scheduled_date"/><br/>
                                <strong>Responsible:</strong>
                                <span t-field="o.user_id"/><br/>
                                <strong>Batch / Lot:</strong>
                                <span t-field="o.lot_id"/><br/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table mb-4">
                            <thead>
                                <tr class="border-black">
                                    <th>Input Qty</th>
                                    <th>Output Qty</th>
                                    <th>Yield %</th>
                                    <th>Loss %</th>
                                    <th>Total Input Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span t-field="o.quantity"/></td>
                                    <td><span t-field="o.output_quantity"/></td>
                                    <td><span t-field="o.yield_percentage"/>%</td>
                                    <td><span t-field="o.loss_percentage"/>%</td>
                                    <td>
                                        <span t-field="o.total_input_cost"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="o.operation_type == 'repacking' and o.packaging_line_ids">
                            <h4>Packaging Materials</h4>
                            <table class="table table-sm mb-4">
                                <thead>
                                    <tr class="border-black">
                                        <th>Product</th>
                                        <th>UoM</th>
                                        <th class="text-end">Quantity</th>
                                        <th>Withdraw From</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.packaging_line_ids" t-as="l">
                                        <td><span t-field="l.product_id"/></td>
                                        <td><span t-field="l.uom_id"/></td>
                                        <td class="text-end"><span t-field="l.quantity"/></td>
                                        <td><span t-field="l.location_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="o.secondary_product_ids">
                            <h4>Secondary Products</h4>
                            <table class="table table-sm mb-4">
                                <thead>
                                    <tr class="border-black">
                                        <th>Product</th>
                                        <th>UoM</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Cost %</th>
                                        <th>Store In</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.secondary_product_ids" t-as="s">
                                        <td><span t-field="s.product_id"/></td>
                                        <td><span t-field="s.uom_id"/></td>
                                        <td class="text-end"><span t-field="s.quantity"/></td>
                                        <td class="text-end"><span t-field="s.cost_percentage"/>%</td>
                                        <td><span t-field="s.location_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <h4>Cost Analysis</h4>
                        <table class="table table-sm mb-4">
                            <tbody>
                                <tr>
                                    <td>Total Input Cost</td>
                                    <td class="text-end">
                                        <span t-field="o.total_input_cost"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Secondary Cost %</td>
                                    <td class="text-end">
                                        <span t-field="o.secondary_cost_pct_total"/>%
                                    </td>
                                </tr>
                                <tr>
                                    <td>Main Product Cost (after secondary allocation)</td>
                                    <td class="text-end">
                                        <span t-field="o.main_product_cost"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="o.notes">
                            <strong>Notes</strong>
                            <p t-field="o.notes"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_repacking_screening_operation" model="ir.actions.report">
        <field name="name">Operation Report</field>
        <field name="model">repacking.screening.operation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">repacking_screening.report_operation_document</field>
        <field name="report_file">repacking_screening.report_operation_document</field>
        <field name="print_report_name">'Operation - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_repacking_screening_operation"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
