<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_repacking_screening_settings_form" model="ir.ui.view">
        <field name="name">repacking.screening.settings.form</field>
        <field name="model">repacking.screening.settings</field>
        <field name="arch" type="xml">
            <form string="Repacking &amp; Screening Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>Workflow Automation</h1>
                    </div>
                    <div class="text-muted mb-3">
                        For each of the 4 steps, choose whether its generated
                        Manufacturing Order / stock document is validated
                        automatically by the system, or left for you to
                        validate manually from Manufacturing / Inventory.
                    </div>

                    <group>
                        <group string="Step 0 — Internal Transfer to Manufacturing Location">
                            <field name="step0_auto_validate"
                                   string="Auto-validate transfer"/>
                        </group>
                        <group string="Step 1 — Intermediate Manufacturing Order">
                            <field name="step1_auto_validate"
                                   string="Auto-validate (mark Done)"/>
                        </group>
                    </group>
                    <group>
                        <group string="Step 2 — Final Manufacturing Order">
                            <field name="step2_auto_validate"
                                   string="Auto-validate (mark Done)"/>
                        </group>
                        <group string="Step 3 — Manufacturing → Destination(s)">
                            <field name="step3_auto_validate"
                                   string="Auto-validate transfer(s)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens the one settings record directly, as a normal page inside the
         module — not a popup, not part of Odoo's general Settings app. -->
    <record id="action_repacking_screening_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">repacking.screening.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_repacking_screening_settings_form"/>
        <field name="res_id" eval="ref('repacking_screening_settings_default')"/>
        <field name="target">current</field>
    </record>

</odoo>
