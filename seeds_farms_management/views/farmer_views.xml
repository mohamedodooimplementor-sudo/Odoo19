<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seeds_farmer_list" model="ir.ui.view">
        <field name="name">seeds.farmer.list</field>
        <field name="model">seeds.farmer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="country_id"/>
                <field name="state_id"/>
                <field name="city"/>
            </list>
        </field>
    </record>
    <record id="view_seeds_farmer_form" model="ir.ui.view">
        <field name="name">seeds.farmer.form</field>
        <field name="model">seeds.farmer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipts" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="Farmer name"/></h1></div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="land_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="area"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_seeds_farmer" model="ir.actions.act_window">
        <field name="name">Farmers</field>
        <field name="res_model">seeds.farmer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
