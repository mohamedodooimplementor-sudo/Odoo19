<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seeds_grade_list" model="ir.ui.view">
        <field name="name">seeds.quality.grade.list</field>
        <field name="model">seeds.quality.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="price_adjustment"/>
            </list>
        </field>
    </record>
    <record id="action_seeds_grade" model="ir.actions.act_window">
        <field name="name">Quality Grades</field>
        <field name="res_model">seeds.quality.grade</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
