<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seeds_season_list" model="ir.ui.view">
        <field name="name">seeds.season.list</field>
        <field name="model">seeds.season</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>
    <record id="action_seeds_season" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">seeds.season</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_seeds_land_list" model="ir.ui.view">
        <field name="name">seeds.land.list</field>
        <field name="model">seeds.land</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="farmer_id"/>
                <field name="area" sum="Total"/>
                <field name="latitude"/>
                <field name="longitude"/>
            </list>
        </field>
    </record>
    <record id="action_seeds_land" model="ir.actions.act_window">
        <field name="name">Fields</field>
        <field name="res_model">seeds.land</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
