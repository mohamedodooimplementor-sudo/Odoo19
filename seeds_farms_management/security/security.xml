<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_seeds_user" model="res.groups">
        <field name="name">Seeds Farms / User</field>
    </record>
    <record id="group_seeds_manager" model="res.groups">
        <field name="name">Seeds Farms / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_seeds_user'))]"/>
    </record>
    <record id="seeds_receipt_company_rule" model="ir.rule">
        <field name="name">Seed Receipt multi-company</field>
        <field name="model_id" ref="model_seeds_receipt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="seeds_settlement_company_rule" model="ir.rule">
        <field name="name">Seed Settlement multi-company</field>
        <field name="model_id" ref="model_seeds_settlement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="seeds_contract_company_rule" model="ir.rule">
        <field name="name">Seed Contract multi-company</field>
        <field name="model_id" ref="model_seeds_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
