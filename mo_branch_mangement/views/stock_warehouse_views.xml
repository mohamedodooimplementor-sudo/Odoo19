<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_form_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.form.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="branch_id" required="1"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_tree_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.list.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="branch_id"/>
            </field>
        </field>
    </record>

    <record id="view_warehouse_search_branch" model="ir.ui.view">
        <field name="name">stock.warehouse.search.branch</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.stock_warehouse_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="branch_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter string="Branch" name="group_by_branch_id" context="{'group_by': 'branch_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
