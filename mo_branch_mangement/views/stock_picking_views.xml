<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Show the Branch field on the stock picking form, right next to the
         Source Document field which has existed in this position across
         Odoo versions. -->
    <record id="view_picking_form_branch" model="ir.ui.view">
        <field name="name">stock.picking.form.branch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="branch_id" readonly="state == 'done'"/>
                <field name="transfer_source_branch_id" invisible="not transfer_source_branch_id"/>
            </field>
        </field>
    </record>

    <record id="view_picking_search_branch" model="ir.ui.view">
        <field name="name">stock.picking.search.branch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="picking_type_id" position="after">
                <field name="branch_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter string="Branch" name="group_by_branch_id" context="{'group_by': 'branch_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
