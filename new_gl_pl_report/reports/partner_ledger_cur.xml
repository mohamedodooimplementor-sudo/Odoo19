<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="partner_ledger_cur_report" model="account.report">
        <field name="name">Partner Ledger - USD $</field>
        <field name="availability_condition">always</field>
            <field name="root_report_id" ref="new_gl_pl_report.partner_ledger_multi_report"/>
        <field name="filter_show_draft" eval="True"/>
        <!-- <field name="filter_account_type" eval="True"/> -->
        <field name="filter_account_type">both</field>
        <field name="filter_partner" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_unreconciled" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="search_bar" eval="True"/>
        <field name="load_more_limit" eval="80"/>
        <field name="custom_handler_model_id" ref="model_account_partner_ledger_report_handler_multi"/>
        <!-- <field name="main_template">account_reports.template_partner_ledger_report</field>
        <field name="line_template">account_reports.line_template_partner_ledger_report</field> -->
        <field name="load_more_limit" eval="80"/>
        <field name="column_ids">
            <record id="partner_ledger_report_mt_journal_code_usd" model="account.report.column">
                <field name="name">JRNL</field>
                <field name="expression_label">journal_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_mt_account_code_usd" model="account.report.column">
                <field name="name">Account</field>
                <field name="expression_label">account_code</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_mt_ref_usd" model="account.report.column">
                <field name="name">Ref</field>
                <field name="expression_label">ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_mt_date_maturity_usd" model="account.report.column">
                <field name="name">Due Date</field>
                <field name="expression_label">date_maturity</field>
                <field name="figure_type">date</field>
            </record>
            <record id="partner_ledger_report_mt_matching_number_usd" model="account.report.column">
                <field name="name">Matching Number</field>
                <field name="expression_label">matching_number</field>
                <field name="figure_type">string</field>
            </record>
            <record id="partner_ledger_report_mt_amount_currency_usd" model="account.report.column">
                <field name="name">Amount Currency</field>
                <field name="expression_label">amount_currency</field>
                <!-- <field name="figure_type">monetary</field>
                <field name="blank_if_zero" eval="True"/> -->
            </record>
            <record id="partner_ledger_report_mt_balance_pl_debit_usd" model="account.report.column">
                    <field name="name">Debit $</field>
                    <field name="expression_label">pl_debit</field>
                    <!-- <field name="figure_type">float</field> -->
                    <!-- <field name="blank_if_zero" eval="True"/> -->
                </record>
                <record id="partner_ledger_report_mt_balance_pl_credit_usd" model="account.report.column">
                    <field name="name">Credit $</field>
                    <field name="expression_label">pl_credit</field>
                    <!-- <field name="figure_type">float</field> -->
                    <!-- <field name="blank_if_zero" eval="True"/> -->
                </record>
                <record id="partner_ledger_report_mt_balance_pl_amount_usd" model="account.report.column">
                    <field name="name">Amount $</field>
                    <field name="expression_label">pl_amount</field>
                </record>
                <record id="partner_ledger_report_mt_balance_pl_balance_usd" model="account.report.column">
                    <field name="name">Balance $</field>
                    <field name="expression_label">pl_balance</field>
                    <!-- <field name="figure_type">float</field> -->
                    <!-- <field name="blank_if_zero" eval="False"/> -->
                </record>
        </field>
    </record>

        <record id="action_account_report_partner_ledger_usd" model="ir.actions.client">
            <field name="name">Partner Ledger USD</field>
            <field name="tag">account_report</field>
            <field name="context" eval="{'report_id': ref('new_gl_pl_report.partner_ledger_cur_report')}"/>
        </record>

    </data>
</odoo>
