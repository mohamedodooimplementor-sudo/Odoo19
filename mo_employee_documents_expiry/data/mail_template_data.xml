<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--Editable (Settings > Technical > Email Templates) reminder email-->
        <record id="mail_template_document_expiry" model="mail.template">
            <field name="name">Employee Document Expiry Reminder</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">Document {{ object.name }} {{ 'expired on' if object.days_left &lt; 0 else 'expires on' }} {{ object.expiry_date }} | المستند {{ object.name }} {{ 'انتهى في' if object.days_left &lt; 0 else 'ينتهي في' }} {{ object.expiry_date }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hello <t t-out="object.employee_id.name or ''"/>,</p>
    <p>
        Your document <b><t t-out="object.name"/></b>
        (<t t-out="object.document_id.name or ''"/>)
        <t t-if="object.days_left &lt; 0">expired on</t>
        <t t-else="">expires on</t>
        <b><t t-out="object.expiry_date"/></b>.
        Please renew it as soon as possible.
    </p>
    <hr/>
    <p dir="rtl" style="text-align: right;">
        مرحبًا <t t-out="object.employee_id.name or ''"/>،<br/>
        المستند <b><t t-out="object.name"/></b>
        <t t-if="object.days_left &lt; 0">انتهت صلاحيته في</t>
        <t t-else="">تنتهي صلاحيته في</t>
        <b><t t-out="object.expiry_date"/></b>.
        برجاء تجديده في أقرب وقت.
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
