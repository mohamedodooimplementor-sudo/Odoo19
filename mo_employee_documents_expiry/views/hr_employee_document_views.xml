<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Form view of hr_employee_document model-->
    <record id='hr_employee_document_view_form' model='ir.ui.view'>
        <field name="name">hr.employee.document.view.form</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_renew_wizard" type="object"
                            string="Renew" class="btn-primary"
                            invisible="not id or not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="document_id"/>
                            <field name="doc_attachment_ids"
                                   widget="many2many_binary" class="oe_inline"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'valid'"
                                   decoration-warning="state == 'expiring'"
                                   decoration-danger="state == 'expired'"
                                   invisible="not expiry_date"/>
                            <field name="days_left"
                                   invisible="not expiry_date"/>
                            <field name="notify_user_ids"
                                   widget="many2many_tags"/>
                            <field name="previous_document_id"
                                   invisible="not previous_document_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--Tree view of hr_employee_document model-->
    <record id='hr_employee_document_view_tree' model='ir.ui.view'>
        <field name="name">hr.employee.document.view.tree</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <list string="docs"
                  decoration-danger="state == 'expired'"
                  decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_id"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="days_left"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'"
                       decoration-danger="state == 'expired'"/>
                <field name="activity_ids" widget="list_activity"/>
            </list>
        </field>
    </record>
    <!--Search view-->
    <record id="hr_employee_document_view_search" model="ir.ui.view">
        <field name="name">hr.employee.document.view.search</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="document_id"/>
                <field name="department_id"/>
                <filter name="expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="expiring" string="Expiring Soon"
                        domain="[('state', '=', 'expiring')]"/>
                <filter name="expiring_30" string="Expiring in 30 Days"
                        domain="[('expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="needs_attention" string="Needs Attention"
                        domain="[('state', 'in', ('expiring', 'expired'))]"/>
                <separator/>
                <filter name="archived" string="Archived (Renewed)"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_document" string="Document"
                            context="{'group_by': 'document_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <!--Graph and pivot (dashboard)-->
    <record id="hr_employee_document_view_graph" model="ir.ui.view">
        <field name="name">hr.employee.document.view.graph</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <graph string="Documents" type="bar">
                <field name="document_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <record id="hr_employee_document_view_pivot" model="ir.ui.view">
        <field name="name">hr.employee.document.view.pivot</field>
        <field name="model">hr.employee.document</field>
        <field name="arch" type="xml">
            <pivot string="Documents">
                <field name="department_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <!--Dashboard action and menu-->
    <record id="hr_employee_document_action" model="ir.actions.act_window">
        <field name="name">Documents Expiry</field>
        <field name="res_model">hr.employee.document</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="context">{'search_default_needs_attention': 1}</field>
    </record>
    <menuitem id="hr_employee_document_menu"
              name="Documents Expiry"
              action="hr_employee_document_action"
              parent="hr.menu_hr_root"
              sequence="90"
              groups="hr.group_hr_user"/>
</odoo>
