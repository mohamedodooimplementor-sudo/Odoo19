<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditor_action_list" model="ir.ui.view">
        <field name="name">odoo.auditor.action.list</field>
        <field name="model">odoo.auditor.action</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="name"/><field name="title"/><field name="finding_id"/>
                <field name="responsible_user_id" widget="many2one_avatar_user"/><field name="deadline"/>
                <field name="priority" widget="priority"/><field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_auditor_action_form" model="ir.ui.view">
        <field name="name">odoo.auditor.action.form</field>
        <field name="model">odoo.auditor.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'open'"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary"
                            invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_verify" type="object" string="Verify" class="btn-success"
                            invisible="state != 'completed'" groups="odoo_auditor.group_auditor_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('verified', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,completed,verified"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="title"/><field name="finding_id"/><field name="responsible_user_id"/>
                            <field name="responsible_department"/><field name="priority" widget="priority"/>
                            <field name="deadline"/><field name="is_overdue" invisible="1"/>
                        </group>
                        <group>
                            <field name="completed_by"/><field name="verified_by"/><field name="verification_date"/>
                            <field name="escalation_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/><field name="root_cause"/><field name="completion_notes"/>
                        <field name="completion_evidence_ids" widget="many2many_binary"/>
                        <field name="effectiveness_review"/><field name="escalation_history"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_auditor_action_search" model="ir.ui.view">
        <field name="name">odoo.auditor.action.search</field>
        <field name="model">odoo.auditor.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="title"/><field name="responsible_user_id"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="mine" string="My Actions" domain="[('responsible_user_id', '=', uid)]"/>
                <group><filter name="g_state" string="Status" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_auditor_action" model="ir.actions.act_window">
        <field name="name">Corrective Actions</field>
        <field name="res_model">odoo.auditor.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
