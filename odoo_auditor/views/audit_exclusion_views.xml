<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditor_exclusion_list" model="ir.ui.view">
        <field name="name">odoo.auditor.exclusion.list</field>
        <field name="model">odoo.auditor.exclusion</field>
        <field name="arch" type="xml">
            <list><field name="rule_id"/><field name="source_name"/><field name="reason"/><field name="finding_id"/>
                <field name="create_uid"/><field name="create_date"/></list>
        </field>
    </record>
    <record id="view_auditor_exclusion_form" model="ir.ui.view">
        <field name="name">odoo.auditor.exclusion.form</field>
        <field name="model">odoo.auditor.exclusion</field>
        <field name="arch" type="xml">
            <form><sheet>
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                <field name="active" invisible="1"/>
                <group><field name="rule_id"/><field name="source_name"/><field name="finding_id"/>
                    <field name="company_id" groups="base.group_multi_company"/><field name="reason"/></group>
                <p class="text-muted">Archive this record to make the condition reportable again in the next run.</p>
            </sheet></form>
        </field>
    </record>
    <record id="action_auditor_exclusion" model="ir.actions.act_window">
        <field name="name">Exclusions</field><field name="res_model">odoo.auditor.exclusion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
