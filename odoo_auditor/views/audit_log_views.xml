<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditor_log_list" model="ir.ui.view">
        <field name="name">odoo.auditor.log.list</field>
        <field name="model">odoo.auditor.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="timestamp"/><field name="user_id"/><field name="operation"/><field name="model_name"/>
                <field name="res_name"/><field name="old_values"/><field name="new_values"/><field name="reason"/>
            </list>
        </field>
    </record>
    <record id="view_auditor_log_form" model="ir.ui.view">
        <field name="name">odoo.auditor.log.form</field>
        <field name="model">odoo.auditor.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0"><sheet><group>
                <field name="timestamp"/><field name="user_id"/><field name="operation"/><field name="model_name"/>
                <field name="res_id"/><field name="res_name"/><field name="finding_id"/>
                <field name="old_values"/><field name="new_values"/><field name="reason"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="view_auditor_log_search" model="ir.ui.view">
        <field name="name">odoo.auditor.log.search</field>
        <field name="model">odoo.auditor.log</field>
        <field name="arch" type="xml">
            <search><field name="res_name"/><field name="user_id"/><field name="model_name"/>
                <group><filter name="g_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="g_model" string="Model" context="{'group_by': 'model_name'}"/></group></search>
        </field>
    </record>
    <record id="action_auditor_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field><field name="res_model">odoo.auditor.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
