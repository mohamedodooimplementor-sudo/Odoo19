<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditor_risk_list" model="ir.ui.view">
        <field name="name">odoo.auditor.risk.list</field>
        <field name="model">odoo.auditor.risk</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="category"/><field name="inherent_score"/>
                <field name="inherent_rating" widget="badge"/><field name="residual_score"/>
                <field name="residual_rating" widget="badge"/><field name="review_date"/></list>
        </field>
    </record>
    <record id="view_auditor_risk_form" model="ir.ui.view">
        <field name="name">odoo.auditor.risk.form</field>
        <field name="model">odoo.auditor.risk</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group>
                    <group><field name="name"/><field name="code"/><field name="category"/>
                        <field name="company_id" groups="base.group_multi_company"/><field name="review_date"/></group>
                    <group><field name="likelihood"/><field name="impact"/><field name="inherent_score"/>
                        <field name="inherent_rating"/><field name="residual_score"/><field name="residual_rating"/></group>
                </group>
                <notebook>
                    <page string="Controls &amp; Links">
                        <group><field name="control_ids" widget="many2many_tags"/><field name="rule_ids" widget="many2many_tags"/>
                            <field name="finding_ids" widget="many2many_tags"/></group>
                    </page>
                    <page string="Description &amp; Remediation"><group><field name="description"/><field name="remediation_plan"/></group></page>
                </notebook>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_auditor_risk" model="ir.actions.act_window">
        <field name="name">Risk Register</field><field name="res_model">odoo.auditor.risk</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_auditor_control_list" model="ir.ui.view">
        <field name="name">odoo.auditor.control.list</field>
        <field name="model">odoo.auditor.control</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="control_type"/><field name="frequency"/>
                <field name="owner_id"/><field name="design_effectiveness"/><field name="operating_effectiveness"/>
                <field name="last_test_date"/></list>
        </field>
    </record>
    <record id="view_auditor_control_form" model="ir.ui.view">
        <field name="name">odoo.auditor.control.form</field>
        <field name="model">odoo.auditor.control</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group>
                    <group><field name="name"/><field name="code"/><field name="control_type"/><field name="frequency"/>
                        <field name="owner_id"/></group>
                    <group><field name="design_effectiveness"/><field name="operating_effectiveness"/>
                        <field name="risk_reduction"/><field name="last_test_date"/></group>
                </group>
                <group><field name="description"/><field name="testing_history"/>
                    <field name="risk_ids" widget="many2many_tags"/><field name="rule_ids" widget="many2many_tags"/></group>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_auditor_control" model="ir.actions.act_window">
        <field name="name">Controls</field><field name="res_model">odoo.auditor.control</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
