<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_auditor_plan_list" model="ir.ui.view">
        <field name="name">odoo.auditor.plan.list</field>
        <field name="model">odoo.auditor.plan</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="title"/><field name="fiscal_year"/><field name="lead_user_id"/>
                <field name="date_start"/><field name="date_end"/><field name="state" widget="badge"/></list>
        </field>
    </record>
    <record id="view_auditor_plan_form" model="ir.ui.view">
        <field name="name">odoo.auditor.plan.form</field>
        <field name="model">odoo.auditor.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'draft'" groups="odoo_auditor.group_auditor_manager"/>
                    <button name="action_start" type="object" string="Start" invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Complete" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,in_progress,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group><field name="title"/><field name="fiscal_year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="lead_user_id"/><field name="team_ids" widget="many2many_tags"/></group>
                        <group><field name="date_start"/><field name="date_end"/><field name="budget_hours"/>
                            <field name="approved_by"/><field name="departments"/></group>
                    </group>
                    <notebook>
                        <page string="Objective &amp; Scope">
                            <group><field name="objective"/><field name="scope"/><field name="risk_assessment"/></group>
                        </page>
                        <page string="Programs">
                            <field name="program_ids">
                                <list editable="bottom"><field name="name"/><field name="objective"/><field name="procedures"/></list>
                            </field>
                        </page>
                        <page string="Conclusion"><field name="conclusion"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_auditor_plan" model="ir.actions.act_window">
        <field name="name">Audit Plans</field><field name="res_model">odoo.auditor.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_auditor_program_form" model="ir.ui.view">
        <field name="name">odoo.auditor.program.form</field>
        <field name="model">odoo.auditor.program</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><field name="name"/><field name="plan_id"/><field name="objective"/><field name="procedures"/></group>
                <field name="workpaper_ids"><list><field name="name"/><field name="test_result"/><field name="state"/></list></field>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="action_auditor_program" model="ir.actions.act_window">
        <field name="name">Audit Programs</field><field name="res_model">odoo.auditor.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_auditor_workpaper_list" model="ir.ui.view">
        <field name="name">odoo.auditor.workpaper.list</field>
        <field name="model">odoo.auditor.workpaper</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="program_id"/><field name="test_result" widget="badge"/>
                <field name="state" widget="badge"/><field name="prepared_by"/><field name="reviewed_by"/></list>
        </field>
    </record>
    <record id="view_auditor_workpaper_form" model="ir.ui.view">
        <field name="name">odoo.auditor.workpaper.form</field>
        <field name="model">odoo.auditor.workpaper</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare" type="object" string="Mark Prepared" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Review &amp; Approve" class="btn-primary" invisible="state != 'prepared'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="program_id"/><field name="objective"/>
                            <field name="sample_method"/><field name="sample_seed"/>
                            <field name="population_size"/><field name="sample_size"/></group>
                        <group><field name="test_result"/><field name="prepared_by"/><field name="prepared_date"/>
                            <field name="reviewed_by"/><field name="reviewed_date"/></group>
                    </group>
                    <notebook>
                        <page string="Testing">
                            <group><field name="sample_selection"/><field name="testing_performed"/>
                                <field name="exceptions"/><field name="reviewer_comments"/></group>
                        </page>
                        <page string="Findings &amp; Evidence">
                            <field name="finding_ids" widget="many2many_tags"/>
                            <field name="evidence_ids"><list><field name="name"/><field name="evidence_type"/></list></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_auditor_workpaper" model="ir.actions.act_window">
        <field name="name">Workpapers</field><field name="res_model">odoo.auditor.workpaper</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
