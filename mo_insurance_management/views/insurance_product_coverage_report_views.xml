<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_product_coverage_report_search" model="ir.ui.view">
        <field name="name">sale.order.line.insurance.coverage.report.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="insurance_company_report_id"/>
                <field name="insurance_patient_report_id"/>
                <field name="insurance_plan_report_id"/>
                <field name="order_id"/>
                <field name="insurance_invoice_report_id"/>
                <separator/>
                <filter string="Insurance Covered" name="insurance_covered"
                        domain="[('insurance_amount', '&gt;', 0)]"/>
                <filter string="Fully Covered" name="fully_covered"
                        domain="[('insurance_amount', '&gt;', 0), ('insurance_coverage_percent_report', '&gt;=', 99.99)]"/>
                <filter string="Partially Covered" name="partially_covered"
                        domain="[('insurance_amount', '&gt;', 0), ('insurance_coverage_percent_report', '&lt;', 99.99)]"/>
                <group>
                    <filter string="Insurance Company" name="group_insurance_company"
                            context="{'group_by': 'insurance_company_report_id'}"/>
                    <filter string="Product" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Customer" name="group_customer"
                            context="{'group_by': 'insurance_patient_report_id'}"/>
                    <filter string="Insurance Plan" name="group_plan"
                            context="{'group_by': 'insurance_plan_report_id'}"/>
                    <filter string="Sales Order" name="group_order"
                            context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_product_coverage_report_list" model="ir.ui.view">
        <field name="name">sale.order.line.insurance.coverage.report.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list string="Insurance Product Coverage">
                <field name="order_id" string="Sales Order"/>
                <field name="insurance_patient_report_id" string="Customer / Patient"/>
                <field name="insurance_company_report_id" string="Insurance Company"/>
                <field name="insurance_plan_report_id" string="Insurance Plan" optional="hide"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Qty" sum="Total Qty"/>
                <field name="full_sale_unit_price" string="Full Unit Price" optional="hide"/>
                <field name="full_sale_amount" string="Full Sale Value" sum="Total Sale Value"/>
                <field name="insurance_amount" string="Insurance Covered" sum="Total Insurance"/>
                <field name="customer_copay_amount" string="Customer Share" sum="Total Customer Share"/>
                <field name="amount_not_covered" string="Not Covered" sum="Total Not Covered" optional="hide"/>
                <field name="insurance_coverage_percent_report" string="Coverage %" optional="show"/>
                <field name="insurance_invoice_report_id" string="Customer Invoice" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_product_coverage_report_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.insurance.coverage.report.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Insurance Product Coverage">
                <field name="insurance_company_report_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="insurance_patient_report_id" type="col" optional="hide"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="full_sale_amount" type="measure"/>
                <field name="insurance_amount" type="measure"/>
                <field name="customer_copay_amount" type="measure"/>
                <field name="amount_not_covered" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_insurance_product_coverage_report" model="ir.actions.act_window">
        <field name="name">Insurance Product Coverage</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_insurance_product_coverage_report_search"/>
        <field name="domain">[('order_id.insurance_enabled', '=', True), ('insurance_amount', '>', 0)]</field>
        <field name="context">{'search_default_insurance_covered': 1}</field>
    </record>
</odoo>
