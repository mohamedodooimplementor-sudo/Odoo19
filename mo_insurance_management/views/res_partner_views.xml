<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_insurance_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.insurance.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Insurance" name="insurance" invisible="is_company"
                      groups="mo_insurance_management.group_insurance_user">
                    <group>
                        <field name="insurance_enabled"/>
                        <field name="primary_insurance_policy_id" readonly="1"/>
                    </group>
                    <field name="insurance_policy_ids" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="insurance_company_id"/>
                            <field name="plan_id"/>
                            <field name="policy_number"/>
                            <field name="member_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" decoration-success="state == 'active'" decoration-danger="state in ('expired','cancelled')" decoration-warning="state == 'suspended'"/>
                            <field name="is_primary"/>
                            <field name="coverage_remaining"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_insurance_policies" type="object" class="oe_stat_button"
                        icon="fa-id-card-o" invisible="is_company"
                        groups="mo_insurance_management.group_insurance_user">
                    <field name="insurance_policy_count" widget="statinfo" string="Policies"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
