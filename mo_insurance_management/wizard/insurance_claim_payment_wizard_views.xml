<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_claim_payment_wizard_form" model="ir.ui.view">
        <field name="name">insurance.claim.payment.wizard.form</field>
        <field name="model">insurance.claim.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <field name="claim_id" readonly="1"/>
                    <field name="insurance_company_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group>
                    <group string="Claim Balance">
                        <field name="total_claimed" readonly="1"/>
                        <field name="total_rejected" readonly="1" invisible="not total_rejected"/>
                        <field name="already_paid" readonly="1"/>
                        <field name="remaining_balance" readonly="1"/>
                    </group>
                    <group string="Payment">
                        <field name="amount_to_pay"/>
                        <field name="journal_id"/>
                        <field name="payment_date"/>
                        <field name="memo"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
