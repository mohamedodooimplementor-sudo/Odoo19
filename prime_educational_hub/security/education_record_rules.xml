        <!-- =================================================================
             PART 2 — TEACHER SCOPING (P0)
             Teachers are restricted to records tied to groups they teach.
             Because Supervisor/Admin groups imply the Teacher group (they
             inherit its menus/access), each restricted model also gets an
             unrestricted rule for Supervisor and Admin so the OR-combination
             of a user's applicable rules gives them full visibility again.
             ================================================================= -->

        <!-- Groups -->
        <record id="rule_teacher_group" model="ir.rule">
            <field name="name">Education Group: teacher sees only assigned groups</field>
            <field name="model_id" ref="model_education_group"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_education_teacher'))]"/>
        </record>
        <record id="rule_supervisor_group_all" model="ir.rule">
            <field name="name">Education Group: supervisor sees all</field>
            <field name="model_id" ref="model_education_group"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_supervisor'))]"/>
        </record>
        <record id="rule_admin_group_all" model="ir.rule">
            <field name="name">Education Group: admin sees all</field>
            <field name="model_id" ref="model_education_group"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_admin'))]"/>
        </record>

