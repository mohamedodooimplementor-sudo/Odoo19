            <field name="name">Education Student: teacher sees only their students</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="domain_force">[('enrollment_ids.group_id.teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_education_teacher'))]"/>
        </record>
        <record id="rule_supervisor_student_all" model="ir.rule">
            <field name="name">Education Student: supervisor sees all</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_supervisor'))]"/>
        </record>
        <record id="rule_admin_student_all" model="ir.rule">
            <field name="name">Education Student: admin sees all</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_admin'))]"/>
        </record>
        <record id="rule_cashier_student_all" model="ir.rule">
            <field name="name">Education Student: cashier sees all</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_cashier'))]"/>
        </record>
        <record id="rule_reception_student_all" model="ir.rule">
            <field name="name">Education Student: reception sees all</field>
            <field name="model_id" ref="model_education_student"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_reception'))]"/>
        </record>

        <!-- Teacher Payouts: a teacher with a System User only sees their own
             payout records (read-only, per access rights); Supervisor/Admin
             manage all payouts. -->
        <record id="rule_teacher_payout_self" model="ir.rule">
            <field name="name">Education Teacher Payout: teacher sees only their own</field>
            <field name="model_id" ref="model_education_teacher_payout"/>
            <field name="domain_force">[('teacher_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_education_teacher'))]"/>
        </record>
        <record id="rule_supervisor_payout_all" model="ir.rule">
            <field name="name">Education Teacher Payout: supervisor sees all</field>
            <field name="model_id" ref="model_education_teacher_payout"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_supervisor'))]"/>
        </record>
        <record id="rule_admin_payout_all" model="ir.rule">
            <field name="name">Education Teacher Payout: admin sees all</field>
            <field name="model_id" ref="model_education_teacher_payout"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_education_admin'))]"/>
        </record>
    </data>
</odoo>
