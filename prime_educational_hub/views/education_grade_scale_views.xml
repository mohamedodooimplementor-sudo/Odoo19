<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_grade_scale_list" model="ir.ui.view">
        <field name="name">education.grade.scale.list</field>
        <field name="model">education.grade.scale</field>
        <field name="arch" type="xml">
            <list string="Grade Scales" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="grade"/>
                <field name="label"/>
                <field name="min_percentage"/>
                <field name="max_percentage"/>
                <field name="pass_grade"/>
            </list>
        </field>
    </record>

    <record id="view_education_grade_scale_form" model="ir.ui.view">
        <field name="name">education.grade.scale.form</field>
        <field name="model">education.grade.scale</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Grade Scale">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="grade"/>
                            <field name="label"/>
                        </group>
                        <group>
                            <field name="min_percentage"/>
                            <field name="max_percentage"/>
                            <field name="pass_grade"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="action_education_grade_scale" model="ir.actions.act_window">
        <field name="name">Grade Scales</field>
        <field name="res_model">education.grade.scale</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define your grading scale (e.g. A: 90-100%)</p>
        </field>
    </record>
</odoo>
