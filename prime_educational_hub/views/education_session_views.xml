<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_session_list" model="ir.ui.view">
        <field name="name">education.session.list</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <list string="Sessions" decoration-muted="state == 'cancelled'" decoration-success="state == 'completed'"
                  decoration-danger="teacher_on_leave_warning">
                <field name="date"/>
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="topic"/>
                <field name="room_id"/>
                <field name="attendance_percentage" widget="percentage"/>
                <field name="teacher_on_leave_warning" string="⚠ Teacher on Leave"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-warning="state == 'open'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_education_session_calendar" model="ir.ui.view">
        <field name="name">education.session.calendar</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <calendar string="Sessions" date_start="start_datetime" date_stop="end_datetime"
                      color="group_id" mode="week">
                <field name="group_id"/>
                <field name="topic"/>
                <field name="room_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_education_session_form" model="ir.ui.view">
        <field name="name">education.session.form</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Session">
                <header>
                    <button name="action_open" type="object" string="Open"
                            invisible="state != 'planned'" class="btn-primary"/>
                    <button name="action_take_attendance" type="object" string="Take Attendance"
                            invisible="state not in ('planned', 'open') or attendance_method == 'qr'"
                            class="btn-primary"/>
                    <button name="action_take_attendance" type="object" string="Take Attendance (Override)"
                            invisible="state not in ('planned', 'open') or attendance_method != 'qr'" class="btn-secondary"
                            groups="prime_educational_hub.group_education_admin,prime_educational_hub.group_education_supervisor"/>
                    <button name="action_open_quick_checkin" type="object" string="Quick Check-in (Code Only)"
                            invisible="state not in ('planned', 'open')" class="btn-edu-teal"/>
                    <button name="action_generate_attendance_qr" type="object" string="Generate Attendance QR"
                            invisible="state not in ('planned', 'open')" class="btn-success"/>
                    <button name="action_revoke_attendance_qr" type="object" string="Revoke QR"
                            invisible="not qr_token" class="btn-secondary"/>
                    <button name="action_complete" type="object" string="Mark Completed"
                            invisible="state != 'open'" class="btn-success"/>
                    <button name="action_reopen" type="object" string="Reopen Session"
                            invisible="state != 'completed'" class="btn-secondary"
                            groups="prime_educational_hub.group_education_admin,prime_educational_hub.group_education_supervisor"/>
                    <button name="action_open_cancel_wizard" type="object" string="Cancel"
                            invisible="state in ('completed', 'cancelled')" class="btn-danger"/>
                    <button name="action_reset_to_planned" type="object" string="Reset to Planned"
                            invisible="state == 'planned'" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,open,completed"/>
                </header>
                <sheet>
                    <div class="alert alert-danger mb-3" role="alert" invisible="not teacher_on_leave_warning">
                        <strong>⚠ Teacher on leave:</strong> the assigned teacher has an approved leave
                        request covering this date. Assign a substitute or reschedule this session.
                    </div>
                    <div class="alert alert-secondary mb-3" role="alert" invisible="state != 'cancelled' or not cancellation_reason">
                        <strong>Cancelled:</strong> <field name="cancellation_reason" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="group_id"/>
                            <field name="teacher_id" readonly="1"/>
                            <field name="date"/>
                            <field name="room_id"/>
                            <field name="is_makeup"/>
                            <field name="substitute_teacher_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="topic"/>
                            <field name="attendance_method"/>
                        </group>
                    </group>
                    <group string="Syllabus Coverage">
                        <field name="syllabus_topic_ids" widget="many2many_tags" nolabel="1"
                               placeholder="Which syllabus topics were covered in this session?"/>
                    </group>
                    <group string="Attendance Summary" invisible="not attendance_taken">
                        <group>
                            <field name="present_count"/>
                            <field name="late_count"/>
                        </group>
                        <group>
                            <field name="absent_count"/>
                            <field name="excused_count"/>
                        </group>
                        <field name="attendance_percentage" widget="percentage"/>
                    </group>
                    <notebook>
                        <page string="Attendance" invisible="not attendance_taken">
                            <div class="mb-2">
                                <button name="action_mark_all_present" type="object" string="Mark All Present"
                                        class="btn-success"/>
                                <button name="action_mark_all_absent" type="object" string="Mark All Absent"
                                        class="btn-danger"/>
                                <button name="action_reset_attendance" type="object" string="Reset"
                                        class="btn-secondary" confirm="This will delete all attendance lines for this session. Continue?"/>
                            </div>
                            <field name="attendance_ids">
                                <list editable="bottom">
                                    <field name="student_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'present'"
                                           decoration-danger="status == 'absent'"
                                           decoration-warning="status == 'late'"
                                           decoration-info="status == 'excused'"/>
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                    <field name="registration_method" widget="badge"/>
                                    <field name="change_reason" optional="hide"/>
                                    <field name="previous_status" optional="hide" readonly="1"/>
                                    <field name="changed_by" optional="hide" readonly="1"/>
                                    <field name="changed_at" optional="hide" readonly="1"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Homework">
                            <field name="homework_text"/>
                        </page>
                        <page string="QR Self Check-in">
                            <group>
                                <group>
                                    <field name="attendance_open_before_minutes"/>
                                    <field name="attendance_close_after_minutes"/>
                                    <field name="late_after_minutes"/>
                                </group>
                                <group>
                                    <field name="attendance_window_open"/>
                                    <field name="attendance_window_close"/>
                                    <field name="attendance_url" widget="url" invisible="not qr_token"/>
                                </group>
                            </group>
                            <div class="text-center mt-3" invisible="not qr_image">
                                <field name="qr_image" widget="image" options="{'size': [220, 220]}"/>
                                <p class="text-muted small">Display this QR to the class — it expires
                                    automatically when the check-in window closes.</p>
                            </div>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_education_session_search" model="ir.ui.view">
        <field name="name">education.session.search</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <search string="Sessions">
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="date"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Teacher On Leave (Conflict)" name="teacher_on_leave"
                        domain="[('teacher_on_leave_warning', '=', True)]"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <group name="group_by">
                    <filter string="Group" name="group_by_group" context="{'group_by': 'group_id'}"/>
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_education_session_kanban" model="ir.ui.view">
        <field name="name">education.session.kanban</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="group_id"/>
                <field name="teacher_id"/>
                <field name="date"/>
                <field name="state"/>
                <field name="present_count"/>
                <field name="absent_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <strong><field name="group_id"/></strong>
                            <div class="text-muted small">
                                <field name="teacher_id"/> -- <field name="date"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-success"><field name="present_count"/> P</span>
                                <span class="badge text-bg-danger"><field name="absent_count"/> A</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_education_session_graph" model="ir.ui.view">
        <field name="name">education.session.graph</field>
        <field name="model">education.session</field>
        <field name="arch" type="xml">
            <graph string="Sessions Analysis" type="line">
                <field name="date" interval="week"/>
                <field name="present_count" type="measure"/>
                <field name="absent_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_education_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">education.session</field>
        <field name="view_mode">calendar,list,kanban,form,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sessions yet -- generate them from a group's schedule</p>
        </field>
    </record>

    <record id="action_education_session_calendar_dashboard" model="ir.actions.server">
        <field name="name">Sessions Calendar</field>
        <field name="model_id" ref="model_education_session"/>
        <field name="state">code</field>
        <field name="code">
# Make sure every active group's weekly schedule is materialized into real
# sessions up to the configured horizon *right now*, so nothing that should
# happen soon is missing just because the daily cron hasn't run yet, or the
# group/schedule was only just created. Safe to run repeatedly -- it never
# creates a session for a date that already has one.
env['education.group']._cron_generate_upcoming_sessions()
action = {
    'type': 'ir.actions.client',
    'name': 'Session Calendar',
    'tag': 'education_session_calendar_dashboard_action',
}
        </field>
    </record>
</odoo>
