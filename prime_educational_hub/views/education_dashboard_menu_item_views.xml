<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_dashboard_menu_item_list" model="ir.ui.view">
        <field name="name">education.dashboard.menu.item.list</field>
        <field name="model">education.dashboard.menu.item</field>
        <field name="arch" type="xml">
            <list string="Dashboard Navigation Items">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="action_id"/>
                <field name="group_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_education_dashboard_menu_item_form" model="ir.ui.view">
        <field name="name">education.dashboard.menu.item.form</field>
        <field name="model">education.dashboard.menu.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Navigation Item">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="icon" placeholder="fa-graduation-cap"/>
                            <field name="color" widget="color"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="action_id"/>
                            <field name="res_model" invisible="1"/>
                            <field name="group_id"/>
                            <field name="is_dashboard_home"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Optional short description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_dashboard_menu_item" model="ir.actions.act_window">
        <field name="name">Dashboard Navigation Items</field>
        <field name="res_model">education.dashboard.menu.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a sidebar icon for the Prime Education Hub dashboard
            </p>
            <p>
                Each item opens a real Odoo action - list/create as many as you like without
                touching any code.
            </p>
        </field>
    </record>
</odoo>
