<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_group_attendance_sheet_wizard_form" model="ir.ui.view">
        <field name="name">education.group.attendance.sheet.wizard.form</field>
        <field name="model">education.group.attendance.sheet.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Print Attendance Sheet">
                <group>
                    <field name="group_id" readonly="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print" class="btn-info"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_education_collection_report_wizard_form" model="ir.ui.view">
        <field name="name">education.collection.report.wizard.form</field>
        <field name="model">education.collection.report.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Collection Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="group_id"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-info"/>
                    <button name="action_export_excel" type="object" string="Export to Excel" class="btn-success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_education_collection_report_wizard" model="ir.actions.act_window">
        <field name="name">Collection Report</field>
        <field name="res_model">education.collection.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_education_outstanding_fees_report_wizard_form" model="ir.ui.view">
