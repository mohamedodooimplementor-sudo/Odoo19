    </record>

    <record id="action_education_outstanding_fees_report_wizard" model="ir.actions.act_window">
        <field name="name">Outstanding Fees Report</field>
        <field name="res_model">education.outstanding.fees.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_education_aging_report_wizard_form" model="ir.ui.view">
        <field name="name">education.aging.report.wizard.form</field>
