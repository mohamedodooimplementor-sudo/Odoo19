<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_dashboard_stat_card_list" model="ir.ui.view">
        <field name="name">education.dashboard.stat.card.list</field>
        <field name="model">education.dashboard.stat.card</field>
        <field name="arch" type="xml">
            <list string="Dashboard Statistics Cards">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="measure"/>
                <field name="group_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_education_dashboard_stat_card_form" model="ir.ui.view">
        <field name="name">education.dashboard.stat.card.form</field>
        <field name="model">education.dashboard.stat.card</field>
        <field name="arch" type="xml">
            <form string="Dashboard Statistics Card">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="icon" placeholder="fa-graduation-cap"/>
                            <field name="color" widget="color"/>
                            <field name="suffix" placeholder="%"/>
                            <field name="sequence"/>
                            <field name="group_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="res_model" placeholder="education.student"/>
                            <field name="domain" widget="text"/>
                            <field name="date_today_field" placeholder="e.g. session_date"/>
                            <field name="measure"/>
                            <field name="measure_field"
                                   invisible="measure not in ('sum', 'avg_percentage')"
                                   placeholder="e.g. amount, percentage"/>
                            <field name="domain_numerator" widget="text"
                                   invisible="measure != 'ratio_percentage'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_dashboard_stat_card" model="ir.actions.act_window">
        <field name="name">Dashboard Statistics Cards</field>
        <field name="res_model">education.dashboard.stat.card</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a headline statistic card for the Prime Education Hub dashboard
            </p>
            <p>
                Every card reads a live number straight from the database - never a hardcoded
                or cached figure.
            </p>
        </field>
    </record>
</odoo>
