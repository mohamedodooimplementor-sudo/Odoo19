<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_income_statement_wizard_form" model="ir.ui.view">
        <field name="name">education.income.statement.wizard.form</field>
        <field name="model">education.income.statement.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Income Statement">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-info"/>
                    <button name="action_export_excel" type="object" string="Export to Excel" class="btn-success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_education_income_statement_wizard" model="ir.actions.act_window">
        <field name="name">Income Statement</field>
        <field name="res_model">education.income.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_education_cash_book_wizard_form" model="ir.ui.view">
        <field name="name">education.cash.book.wizard.form</field>
        <field name="model">education.cash.book.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Cash Book">
                <group>
                    <field name="cash_account_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-info"/>
                    <button name="action_export_excel" type="object" string="Export to Excel" class="btn-success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_education_cash_book_wizard" model="ir.actions.act_window">
        <field name="name">Cash Book</field>
        <field name="res_model">education.cash.book.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_education_expense_report_wizard_form" model="ir.ui.view">
        <field name="name">education.expense.report.wizard.form</field>
        <field name="model">education.expense.report.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Expense Report">
                <group>
                    <field name="category_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="include_states"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-info"/>
                    <button name="action_export_excel" type="object" string="Export to Excel" class="btn-success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_education_expense_report_wizard" model="ir.actions.act_window">
        <field name="name">Expense Report</field>
        <field name="res_model">education.expense.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
