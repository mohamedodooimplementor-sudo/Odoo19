<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_holiday_list" model="ir.ui.view">
        <field name="name">education.holiday.list</field>
        <field name="model">education.holiday</field>
        <field name="arch" type="xml">
            <list string="Holidays" editable="bottom">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_education_holiday_form" model="ir.ui.view">
        <field name="name">education.holiday.form</field>
        <field name="model">education.holiday</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Holiday">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="active"/>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="action_education_holiday" model="ir.actions.act_window">
        <field name="name">Holidays</field>
        <field name="res_model">education.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add holidays/excluded dates to skip when generating sessions</p>
        </field>
    </record>
</odoo>
