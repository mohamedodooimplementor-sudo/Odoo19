<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_level_list" model="ir.ui.view">
        <field name="name">education.level.list</field>
        <field name="model">education.level</field>
        <field name="arch" type="xml">
            <list string="Levels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_education_level_form" model="ir.ui.view">
        <field name="name">education.level.form</field>
        <field name="model">education.level</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Level">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>

    <record id="action_education_level" model="ir.actions.act_window">
        <field name="name">Levels</field>
        <field name="res_model">education.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first grade/level</p>
        </field>
    </record>
</odoo>
