<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_syllabus_topic_list" model="ir.ui.view">
        <field name="name">education.syllabus.topic.list</field>
        <field name="model">education.syllabus.topic</field>
        <field name="arch" type="xml">
            <list string="Syllabus Topics" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="subject_id"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_education_syllabus_topic_form" model="ir.ui.view">
        <field name="name">education.syllabus.topic.form</field>
        <field name="model">education.syllabus.topic</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Syllabus Topic">
                <sheet>
                    <group>
                        <field name="subject_id"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description" placeholder="What this topic covers..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_syllabus_topic_search" model="ir.ui.view">
        <field name="name">education.syllabus.topic.search</field>
        <field name="model">education.syllabus.topic</field>
        <field name="arch" type="xml">
            <search string="Syllabus Topics">
                <field name="name"/>
                <field name="subject_id"/>
                <group>
                    <filter name="group_by_subject" string="Subject" context="{'group_by': 'subject_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_syllabus_topic" model="ir.actions.act_window">
        <field name="name">Syllabus Topics</field>
        <field name="res_model">education.syllabus.topic</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_subject': 1}</field>
    </record>
</odoo>
