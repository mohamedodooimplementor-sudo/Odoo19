<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_feedback_list" model="ir.ui.view">
        <field name="name">education.feedback.list</field>
        <field name="model">education.feedback</field>
        <field name="arch" type="xml">
            <list string="Student Feedback" decoration-danger="rating in ('1','2')"
                  decoration-success="rating in ('4','5')">
                <field name="create_date"/>
                <field name="student_id"/>
                <field name="rating"/>
                <field name="context_label"/>
                <field name="comment" optional="hide"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="view_education_feedback_form" model="ir.ui.view">
        <field name="name">education.feedback.form</field>
        <field name="model">education.feedback</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Student Feedback">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="rating"/>
                            <field name="context_label"/>
                        </group>
                        <group>
                            <field name="source"/>
                        </group>
                    </group>
                    <field name="comment"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_education_feedback_search" model="ir.ui.view">
        <field name="name">education.feedback.search</field>
        <field name="model">education.feedback</field>
        <field name="arch" type="xml">
            <search string="Student Feedback">
                <field name="student_id"/>
                <field name="context_label"/>
                <filter name="low_ratings" string="Low Ratings (1-2)" domain="[('rating', 'in', ('1', '2'))]"/>
                <group>
                    <filter name="group_by_rating" string="Rating" context="{'group_by': 'rating'}"/>
                    <filter name="group_by_context" string="Context" context="{'group_by': 'context_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_education_feedback" model="ir.actions.act_window">
        <field name="name">Student Feedback</field>
        <field name="res_model">education.feedback</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
