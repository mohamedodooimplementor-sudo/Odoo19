<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="student_portal_page" name="Student Portal">
        <html>
            <head>
                <meta charset="utf-8"/>
                <title>Student Portal</title>
                <style>
                    body { font-family: -apple-system, Arial, sans-serif; background: #f4f6f8; margin: 0; padding: 30px 16px; }
                    .brand { text-align: center; margin-bottom: 18px; }
                    .brand img { width: 56px; height: 56px; border-radius: 14px; box-shadow: 0 4px 14px rgba(0,0,0,0.12); }
                    .brand h3 { margin: 8px 0 0; font-size: 15px; color: #2c3e50; font-weight: 700; }
                    .card { max-width: 520px; margin: 0 auto 16px auto; background: #fff; border-radius: 12px;
                            box-shadow: 0 2px 12px rgba(0,0,0,0.08); padding: 24px; }
                    h2 { margin: 0 0 4px 0; color: #1a1a1a; }
                    .muted { color: #888; font-size: 13px; margin-bottom: 16px; }
                    .kpi_grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
                    .kpi { background: #f4f6f8; border-radius: 8px; padding: 12px; text-align: center; }
                    .kpi .value { font-size: 20px; font-weight: 700; color: #2c3e50; }
                    .kpi .label { font-size: 11px; color: #888; text-transform: uppercase; }
                    .balance { background: #fff8e6; border: 1px solid #f6ad55; border-radius: 8px;
                               padding: 12px; margin-bottom: 16px; }
                    .balance .amount { font-size: 22px; font-weight: 700; color: #c0392b; }
                    .attendance_breakdown { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
                    .chip { flex: 1; min-width: 70px; border-radius: 8px; padding: 8px; text-align: center; }
                    .chip .value { font-size: 16px; font-weight: 700; }
                    .chip .label { font-size: 10px; text-transform: uppercase; color: #666; }
                    .chip.present { background: #e6f9f0; } .chip.present .value { color: #1e8e5a; }
                    .chip.late { background: #fff8e6; } .chip.late .value { color: #b58900; }
                    .chip.absent { background: #fdecea; } .chip.absent .value { color: #c0392b; }
                    .chip.excused { background: #eaf1fb; } .chip.excused .value { color: #2c6bbf; }
                    table { width: 100%; border-collapse: collapse; font-size: 13px; }
                    td { padding: 6px 4px; border-bottom: 1px solid #eee; }
                    .text-muted { color: #999; }
                </style>
            </head>
            <body>
                <div class="brand">
                    <img src="/prime_educational_hub/static/description/icon.png" alt="Prime Educational Hub"/>
                    <h3>Prime Educational Hub · Student Portal</h3>
                </div>
                <t t-if="not data.get('found')">
                    <div class="card">
                        <h2>Link Not Available</h2>
                        <p class="muted">This portal link is invalid, disabled, or has been revoked.</p>
                    </div>
                </t>
                <t t-else="">
                    <div class="card">
                        <h2 t-esc="data.get('student_name')"/>
                        <div class="muted">
                            <span t-esc="data.get('student_code')"/>
                            <t t-if="data.get('grade_level')"> — <span t-esc="data.get('grade_level')"/></t>
                        </div>

                        <div class="kpi_grid">
                            <div class="kpi">
                                <div class="value"><t t-esc="data.get('attendance_percentage')"/>%</div>
                                <div class="label">Attendance</div>
                            </div>
                            <div class="kpi">
                                <div class="value"><t t-esc="data.get('exam_average_percentage')"/>%</div>
                                <div class="label">Exam Average</div>
                            </div>
                            <div class="kpi">
                                <div class="value"><t t-esc="data.get('assignment_completion_percentage')"/>%</div>
                                <div class="label">Assignments</div>
                            </div>
                        </div>

                        <div class="attendance_breakdown">
                            <div class="chip present">
                                <div class="value"><t t-esc="data.get('attendance_breakdown', {}).get('present', 0)"/></div>
                                <div class="label">Present</div>
                            </div>
                            <div class="chip late">
                                <div class="value"><t t-esc="data.get('attendance_breakdown', {}).get('late', 0)"/></div>
                                <div class="label">Late</div>
                            </div>
                            <div class="chip absent">
                                <div class="value"><t t-esc="data.get('attendance_breakdown', {}).get('absent', 0)"/></div>
                                <div class="label">Absent</div>
                            </div>
                            <div class="chip excused">
                                <div class="value"><t t-esc="data.get('attendance_breakdown', {}).get('excused', 0)"/></div>
                                <div class="label">Excused</div>
                            </div>
                        </div>

                        <div class="balance" t-if="data.get('total_outstanding')">
                            <div class="label" style="color:#888; font-size: 12px;">Outstanding Balance</div>
                            <div class="amount">
                                <t t-esc="data.get('currency_symbol')"/><t t-esc="data.get('total_outstanding')"/>
                            </div>
                            <div class="muted" t-if="data.get('next_installment_due')">
                                Next due: <span t-esc="data.get('next_installment_due')"/> —
                                <t t-esc="data.get('currency_symbol')"/><t t-esc="data.get('next_installment_amount')"/>
                            </div>
                        </div>

                        <div t-if="data.get('active_groups')">
                            <strong>Active Groups:</strong> <span t-esc="', '.join(data.get('active_groups'))"/>
                        </div>
                    </div>

                    <div class="card">
                        <h2 style="font-size: 16px;">Recent Exam Results</h2>
                        <table>
                            <t t-foreach="data.get('recent_results')" t-as="r">
                                <tr>
                                    <td t-esc="r['exam']"/>
                                    <td class="text-muted" t-esc="r['subject']"/>
                                    <td style="text-align:right;"><t t-esc="r['percentage']"/>%</td>
                                    <td style="text-align:right;" t-esc="r['grade']"/>
                                </tr>
                            </t>
                            <t t-if="not data.get('recent_results')">
                                <tr><td class="text-muted">No exam results yet</td></tr>
                            </t>
                        </table>
                    </div>

                    <div class="card">
                        <h2>Share Your Feedback</h2>
                        <t t-if="request.params.get('feedback')">
                            <p style="color:#15803d; font-weight:600;">Thank you - your feedback was submitted!</p>
                        </t>
                        <form method="post" t-attf-action="/education/portal/student/#{data.get('portal_token', '')}/feedback">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label class="muted">How satisfied are you so far?</label><br/>
                            <select name="rating" required="required" style="padding:8px; border-radius:6px; border:1px solid #dfe3e8; margin:6px 0 12px; width:100%;">
                                <option value="5">5 - Very Satisfied</option>
                                <option value="4">4 - Satisfied</option>
                                <option value="3">3 - Neutral</option>
                                <option value="2">2 - Dissatisfied</option>
                                <option value="1">1 - Very Dissatisfied</option>
                            </select>
                            <textarea name="comment" rows="2" placeholder="Any comments? (optional)"
                                      style="width:100%; box-sizing:border-box; padding:8px; border-radius:6px; border:1px solid #dfe3e8; margin-bottom:12px;"/>
                            <button type="submit" style="background:#4f46e5; color:#fff; border:none; padding:9px 18px; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer;">Submit Feedback</button>
                        </form>
                    </div>
                </t>
            </body>
        </html>
    </template>
</odoo>
