<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_session_generate_wizard_form" model="ir.ui.view">
        <field name="name">education.session.generate.wizard.form</field>
        <field name="model">education.session.generate.wizard</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Generate Sessions from Schedule">
                <group>
                    <field name="group_id" readonly="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="skip_existing"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
