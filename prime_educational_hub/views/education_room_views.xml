<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_education_room_kanban" model="ir.ui.view">
        <field name="name">education.room.kanban</field>
        <field name="model">education.room</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="status"
                    group_create="false" group_delete="false" group_edit="false" quick_create="false">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="capacity"/>
                <field name="status"/>
                <field name="current_session_id"/>
                <field name="next_session_id"/>
                <field name="today_session_count"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click o_kanban_card p-3 border-start"
                             t-attf-style="border-inline-start-width: 4px !important; border-inline-start-color: #{record.status.raw_value === 'occupied' ? '#ff1744' : '#00c853'} !important;">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="fs-5"><field name="name"/></strong>
                                <span class="badge" t-if="record.branch_id.raw_value"
                                      style="background-color: #4361ee; color: #ffffff;">
                                    <field name="branch_id"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.capacity.raw_value">
                                <i class="fa fa-users me-1"/><field name="capacity"/> seats
                            </div>
                            <div class="mt-2" t-if="record.current_session_id.raw_value">
                                <div class="small" style="color: #ff1744; font-weight: 600;">
                                    <i class="fa fa-play-circle me-1"/>Now: <field name="current_session_id"/>
                                </div>
                            </div>
                            <div class="mt-1" t-if="record.next_session_id.raw_value">
                                <div class="small text-muted">
                                    <i class="fa fa-clock-o me-1"/>Next: <field name="next_session_id"/>
                                </div>
                            </div>
                            <div class="mt-2">
                                <span class="badge" style="background-color: #b026ff; color: #ffffff;">
                                    <field name="today_session_count"/> session(s) today
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_education_room_list" model="ir.ui.view">
        <field name="name">education.room.list</field>
        <field name="model">education.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="branch_id"/>
                <field name="capacity"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'free'"
                       decoration-danger="status == 'occupied'"/>
                <field name="today_session_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_education_room_form" model="ir.ui.view">
        <field name="name">education.room.form</field>
        <field name="model">education.room</field>
        <field name="arch" type="xml">
            <form class="o_peh_view" string="Room">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_today_sessions" type="object"
                                class="oe_stat_button" icon="fa-calendar text-primary">
                            <field name="today_session_count" widget="statinfo" string="Today's Sessions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Occupied" bg_color="bg-danger"
                            invisible="status != 'occupied'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="show_branch_field" invisible="1"/>
                            <field name="branch_id" invisible="not show_branch_field" required="show_branch_field"/>
                            <field name="capacity"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="current_session_id" readonly="1"/>
                            <field name="next_session_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_education_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">education.room</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your classrooms/halls to track live availability</p>
        </field>
    </record>
</odoo>
