<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epo_alternative_form" model="ir.ui.view">
        <field name="name">employee.purchase.order.alternative.form</field>
        <field name="model">employee.purchase.order.alternative</field>
        <field name="arch" type="xml">
            <form string="Create Alternative">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="copy_products"/>
                </group>
                <footer>
                    <button name="action_create_alternatives" string="Create Alternative"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_epo_alternative_warning_form" model="ir.ui.view">
        <field name="name">employee.purchase.order.alternative.warning.form</field>
        <field name="model">employee.purchase.order.alternative.warning</field>
        <field name="arch" type="xml">
            <form string="Alternatives">
                <field name="order_id" invisible="1"/>
                <field name="message" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_cancel_alternatives" string="Cancel Alternatives"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button name="action_keep_alternatives" string="Keep Alternatives"
                            type="object" class="btn-secondary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
