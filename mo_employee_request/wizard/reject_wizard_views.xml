<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_request_reject_wizard_form" model="ir.ui.view">
        <field name="name">employee.request.reject.wizard.form</field>
        <field name="model">employee.request.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Request">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this request rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
