<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epo_discount_form" model="ir.ui.view">
        <field name="name">employee.purchase.order.discount.form</field>
        <field name="model">employee.purchase.order.discount</field>
        <field name="arch" type="xml">
            <form string="Discount">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="discount_type" widget="radio"/>
                    <field name="discount_percentage" widget="percentage"
                           invisible="discount_type == 'amount'"/>
                    <field name="discount_amount" invisible="discount_type != 'amount'"/>
                </group>
                <footer>
                    <button name="action_apply_discount" string="Apply" type="object"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_epo_discount" model="ir.actions.act_window">
        <field name="name">Discount</field>
        <field name="res_model">employee.purchase.order.discount</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
