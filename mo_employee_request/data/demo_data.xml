<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_department_operations" model="hr.department">
            <field name="name">Operations (Employee Requests demo)</field>
        </record>
        <record id="demo_employee_manager" model="hr.employee">
            <field name="name">Demo Department Manager</field>
            <field name="department_id" ref="demo_department_operations"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>
        <record id="demo_department_operations" model="hr.department">
            <field name="manager_id" ref="demo_employee_manager"/>
        </record>
        <record id="demo_employee_requester" model="hr.employee">
            <field name="name">Demo Requester</field>
            <field name="department_id" ref="demo_department_operations"/>
            <field name="user_id" ref="base.user_demo"/>
        </record>

        <record id="demo_product_cement_template" model="product.template">
            <field name="name">Demo Cement Bag</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">9.0</field>
            <field name="standard_price">6.0</field>
        </record>
        <record id="demo_product_helmet_template" model="product.template">
            <field name="name">Demo Safety Helmet</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="list_price">15.0</field>
            <field name="standard_price">10.0</field>
        </record>

        <!-- Make the demo approval flow runnable out of the box -->
        <record id="base.main_company" model="res.company">
            <field name="er_warehouse_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="er_budget_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="er_purchase_budget_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="er_budget_control_user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="er_purchase_manager_user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="demo_request_1" model="employee.request">
            <field name="employee_id" ref="demo_employee_requester"/>
            <field name="request_date" eval="time.strftime('%Y-%m-%d')"/>
        </record>
        <record id="demo_request_1_line_1" model="employee.request.line">
            <field name="request_id" ref="demo_request_1"/>
            <field name="product_id" search="[('product_tmpl_id', '=', ref('demo_product_cement_template'))]"/>
            <field name="product_uom_qty">20</field>
        </record>
        <record id="demo_request_1_line_2" model="employee.request.line">
            <field name="request_id" ref="demo_request_1"/>
            <field name="product_id" search="[('product_tmpl_id', '=', ref('demo_product_helmet_template'))]"/>
            <field name="product_uom_qty">5</field>
        </record>
    </data>
</odoo>
