<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_employee_request" model="ir.sequence">
            <field name="name">Employee Request</field>
            <field name="code">employee.request</field>
            <field name="prefix">REQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_employee_purchase_order" model="ir.sequence">
            <field name="name">Employee Purchase Order</field>
            <field name="code">employee.purchase.order</field>
            <field name="prefix">EPO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="location_employee_consumption" model="stock.location">
            <field name="name">Employee Consumption</field>
            <field name="usage">inventory</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
