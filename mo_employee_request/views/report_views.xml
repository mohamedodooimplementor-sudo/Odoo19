<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Request Report (one row per request line) -->
    <record id="view_er_report_request_list" model="ir.ui.view">
        <field name="name">employee.request.line.report.list</field>
        <field name="model">employee.request.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Employee Request Report" create="0" edit="0" delete="0">
                <field name="request_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="project_id"/>
                <field name="analytic_account_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Requested" sum="Requested"/>
                <field name="qty_issued" sum="Issued"/>
                <field name="qty_purchase_planned" sum="Purchased"/>
                <field name="qty_received" sum="Received"/>
                <field name="qty_remaining" sum="Remaining"/>
                <field name="request_state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_er_report_request_pivot" model="ir.ui.view">
        <field name="name">employee.request.line.report.pivot</field>
        <field name="model">employee.request.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Employee Request Report">
                <field name="department_id" type="row"/>
                <field name="product_uom_qty" type="measure" string="Requested"/>
                <field name="qty_issued" type="measure"/>
                <field name="qty_purchase_planned" type="measure"/>
                <field name="qty_received" type="measure"/>
                <field name="qty_remaining" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_er_report_request_search" model="ir.ui.view">
        <field name="name">employee.request.line.report.search</field>
        <field name="model">employee.request.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="employee_id"/>
                <field name="product_id"/>
                <field name="project_id"/>
                <group>
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="g_analytic" string="Analytic Account" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'request_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_er_report_request" model="ir.actions.act_window">
        <field name="name">Employee Request Report</field>
        <field name="res_model">employee.request.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_er_report_request_search"/>
        <field name="domain">[('request_state', 'not in', ('draft', 'cancelled'))]</field>
    </record>
    <record id="action_er_report_request_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_er_report_request_list"/>
        <field name="act_window_id" ref="action_er_report_request"/>
    </record>
    <record id="action_er_report_request_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_er_report_request_pivot"/>
        <field name="act_window_id" ref="action_er_report_request"/>
    </record>

    <!-- Purchase Report (one row per employee PO line) -->
    <record id="view_er_report_purchase_list" model="ir.ui.view">
        <field name="name">employee.purchase.order.line.report.list</field>
        <field name="model">employee.purchase.order.line</field>
        <field name="arch" type="xml">
            <list string="Purchase Report" create="0" edit="0" delete="0">
                <field name="order_id"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty" sum="Quantity"/>
                <field name="price_subtotal" sum="Amount"/>
                <field name="project_id"/>
                <field name="analytic_account_id"/>
                <field name="request_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_er_report_purchase_pivot" model="ir.ui.view">
        <field name="name">employee.purchase.order.line.report.pivot</field>
        <field name="model">employee.purchase.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Purchase Report">
                <field name="partner_id" type="row"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_er_report_purchase_search" model="ir.ui.view">
        <field name="name">employee.purchase.order.line.report.search</field>
        <field name="model">employee.purchase.order.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <group>
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="g_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="g_analytic" string="Analytic Account" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="g_request" string="Request" context="{'group_by': 'request_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_er_report_purchase" model="ir.actions.act_window">
        <field name="name">Purchase Report</field>
        <field name="res_model">employee.purchase.order.line</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_er_report_purchase_search"/>
        <field name="domain">[('order_state', 'not in', ('draft', 'cancelled', 'rejected'))]</field>
    </record>
    <record id="action_er_report_purchase_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_er_report_purchase_list"/>
        <field name="act_window_id" ref="action_er_report_purchase"/>
    </record>
    <record id="action_er_report_purchase_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_er_report_purchase_pivot"/>
        <field name="act_window_id" ref="action_er_report_purchase"/>
    </record>

    <!-- Project Stock Report: how much stock is held for each project -->
    <record id="view_er_project_stock_list" model="ir.ui.view">
        <field name="name">er.project.stock.report.list</field>
        <field name="model">er.project.stock.report</field>
        <field name="arch" type="xml">
            <list string="Project Stock" create="0" edit="0" delete="0">
                <field name="project_id"/>
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="product_uom_id"/>
                <field name="qty_received" sum="Received"/>
                <field name="qty_allocated" sum="Allocated"/>
                <field name="qty_issued" sum="Issued"/>
                <field name="qty_held" sum="Held" decoration-success="qty_held &gt; 0"/>
                <field name="value_held" sum="Value"/>
            </list>
        </field>
    </record>
    <record id="view_er_project_stock_pivot" model="ir.ui.view">
        <field name="name">er.project.stock.report.pivot</field>
        <field name="model">er.project.stock.report</field>
        <field name="arch" type="xml">
            <pivot string="Project Stock">
                <field name="project_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="qty_held" type="measure"/>
                <field name="value_held" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_er_project_stock_search" model="ir.ui.view">
        <field name="name">er.project.stock.report.search</field>
        <field name="model">er.project.stock.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter name="f_held" string="Still Held" domain="[('qty_held', '&gt;', 0)]"/>
                <group>
                    <filter name="g_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="g_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="g_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_er_project_stock" model="ir.actions.act_window">
        <field name="name">Project Stock Report</field>
        <field name="res_model">er.project.stock.report</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_er_project_stock_search"/>
        <field name="context">{'search_default_f_held': 1, 'search_default_g_project': 1}</field>
    </record>

    <!-- Project Allocations menu: the products held (reserved) in projects -->
    <record id="action_er_project_allocated_stock" model="ir.actions.act_window">
        <field name="name">Project Allocations</field>
        <field name="res_model">er.project.stock.report</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_er_project_stock_search"/>
        <field name="context">{'search_default_f_held': 1, 'search_default_g_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No product is held for a project yet</p>
            <p>Products received for a project, or reserved for it with an Allocation Order,
               are listed here.</p>
        </field>
    </record>

    <!-- Graph views: the first view of every report -->
    <record id="view_er_report_request_graph" model="ir.ui.view">
        <field name="name">employee.request.line.report.graph</field>
        <field name="model">employee.request.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Employee Request Report" type="bar">
                <field name="project_id"/>
                <field name="product_uom_qty" type="measure" string="Requested"/>
            </graph>
        </field>
    </record>
    <record id="action_er_report_request_graph" model="ir.actions.act_window.view">
        <field name="sequence">0</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_er_report_request_graph"/>
        <field name="act_window_id" ref="action_er_report_request"/>
    </record>
    <record id="view_er_report_purchase_graph" model="ir.ui.view">
        <field name="name">employee.purchase.order.line.report.graph</field>
        <field name="model">employee.purchase.order.line</field>
        <field name="arch" type="xml">
            <graph string="Purchase Report" type="bar">
                <field name="partner_id"/>
                <field name="price_subtotal" type="measure" string="Amount"/>
            </graph>
        </field>
    </record>
    <record id="action_er_report_purchase_graph" model="ir.actions.act_window.view">
        <field name="sequence">0</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_er_report_purchase_graph"/>
        <field name="act_window_id" ref="action_er_report_purchase"/>
    </record>
    <record id="view_er_project_stock_graph" model="ir.ui.view">
        <field name="name">er.project.stock.report.graph</field>
        <field name="model">er.project.stock.report</field>
        <field name="arch" type="xml">
            <graph string="Project Stock" type="bar">
                <field name="project_id"/>
                <field name="qty_held" type="measure" string="Held for Project"/>
            </graph>
        </field>
    </record>
    <record id="action_er_project_stock_graph" model="ir.actions.act_window.view">
        <field name="sequence">0</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_er_project_stock_graph"/>
        <field name="act_window_id" ref="action_er_project_stock"/>
    </record>
</odoo>
