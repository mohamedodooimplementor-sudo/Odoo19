<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_epo_list" model="ir.ui.view">
        <field name="name">employee.purchase.order.list</field>
        <field name="model">employee.purchase.order</field>
        <field name="arch" type="xml">
            <list string="Employee Purchase Orders"
                  decoration-info="state in ('manager', 'budget', 'budget_control')"
                  decoration-success="state in ('approved', 'done', 'invoiced')"
                  decoration-danger="state in ('rejected', 'budget_rejected')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="request_id" optional="show"/>
                <field name="project_id" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_epo_form" model="ir.ui.view">
        <field name="name">employee.purchase.order.form</field>
        <field name="model">employee.purchase.order</field>
        <field name="arch" type="xml">
            <form string="Employee Purchase Order" class="er-mobile-form">
                <header>
                    <button name="action_confirm" string="To Approve" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_rfq" string="Print RFQ" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Manager Approval" type="object"
                            class="btn-primary"
                            invisible="state != 'manager' or not can_approve"/>
                    <button name="action_approve" string="Budget Approval" type="object"
                            class="btn-primary"
                            invisible="state != 'budget' or not can_approve"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('manager', 'budget') or not can_approve"/>
                    <button name="action_send_budget_control" string="Send to Budget Control"
                            type="object" class="btn-primary" invisible="state != 'budget_rejected'"/>
                    <button name="action_resubmit_budget" string="Confirm / Resubmit Budget"
                            type="object" class="btn-primary"
                            invisible="state != 'budget_control' or not can_edit_budget"/>
                    <button name="action_create_odoo_po" string="Create Odoo Purchase Order"
                            type="object" class="btn-primary"
                            invisible="state != 'approved' or odoo_po_id"/>
                    <button name="action_create_bill" string="Create Bill" type="object"
                            invisible="state not in ('approved', 'done') or not odoo_po_id"/>
                    <button name="action_send_email" string="Send by Email" type="object"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'cancelled', 'budget_rejected')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            confirm="Cancel this purchase order?"
                            invisible="state in ('cancelled', 'done', 'invoiced') or odoo_po_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,manager,budget,approved,done,invoiced"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Budget Rejected" bg_color="text-bg-danger"
                            invisible="state != 'budget_rejected'"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger"
                            invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Budget Control" bg_color="er-ribbon-orange"
                            invisible="state != 'budget_control'"/>
                    <widget name="web_ribbon" title="Closed" bg_color="er-ribbon-teal"
                            invisible="state != 'done'"/>
                    <widget name="web_ribbon" title="Invoiced" bg_color="text-bg-success"
                            invisible="state != 'invoiced'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-dark"
                            invisible="state != 'cancelled'"/>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_edit_budget" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="er_required_fields" invisible="1"/>
                    <field name="er_required_line_fields" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_odoo_po" type="object" class="oe_stat_button"
                                icon="fa-shopping-cart" invisible="not odoo_po_id">
                            <div class="o_stat_info"><span class="o_stat_text">Odoo PO</span></div>
                        </button>
                        <button name="action_view_receipts" type="object" class="oe_stat_button"
                                icon="fa-download" invisible="receipt_count == 0">
                            <field name="receipt_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button name="action_view_bills" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="bill_count == 0">
                            <field name="bill_count" widget="statinfo" string="Vendor Bills"/>
                        </button>
                        <button name="action_view_request" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not request_id">
                            <div class="o_stat_info"><span class="o_stat_text">Employee Request</span></div>
                        </button>
                        <button name="action_view_agreement" type="object" class="oe_stat_button"
                                icon="fa-handshake-o" invisible="not agreement_id">
                            <div class="o_stat_info"><span class="o_stat_text">Agreement</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group name="left">
                            <field name="partner_id" readonly="state not in ('draft', 'budget_control')"/>
                            <field name="agreement_id" readonly="state not in ('draft', 'budget_control')"
                                   required="state in ('draft', 'budget_control') and 'agreement_id' in er_required_fields"/>
                            <field name="date_order" readonly="state != 'draft'"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="department_id"/>
                            <field name="pending_approver_ids" widget="many2many_tags" invisible="1"/>
                        </group>
                        <group name="right" class="d-none d-md-block">
                            <field name="request_id" readonly="1"/>
                            <field name="warehouse_id" readonly="state != 'draft'"
                                   required="state == 'draft' and 'warehouse_id' in er_required_fields"/>
                            <field name="project_id" readonly="state != 'draft'"
                                   required="state == 'draft' and 'project_id' in er_required_fields"/>
                            <field name="analytic_account_id" readonly="state != 'draft'"
                                   required="state == 'draft' and 'analytic_account_id' in er_required_fields"/>
                            <field name="currency_id" readonly="state != 'draft'"
                                   groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="lines">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'budget_control') or (state == 'budget_control' and not can_edit_budget)">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name" optional="show"
                                           required="parent.state in ('draft', 'budget_control') and 'name' in parent.er_required_line_fields"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"
                                           required="parent.state in ('draft', 'budget_control') and 'tax_ids' in parent.er_required_line_fields"/>
                                    <field name="price_subtotal"/>
                                    <field name="project_id" optional="show"
                                           required="parent.state in ('draft', 'budget_control') and 'project_id' in parent.er_required_line_fields"/>
                                    <field name="analytic_account_id" optional="show"
                                           required="parent.state in ('draft', 'budget_control') and 'analytic_account_id' in parent.er_required_line_fields"/>
                                    <field name="warehouse_id" optional="show"
                                           required="parent.state in ('draft', 'budget_control') and 'warehouse_id' in parent.er_required_line_fields"/>
                                    <field name="request_line_id" optional="hide" readonly="1"/>
                                    <field name="received_qty" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="d-flex justify-content-start mb-2"
                                 invisible="state != 'draft' and (state != 'budget_control' or not can_edit_budget)">
                                <button name="%(mo_employee_request.action_epo_discount)d"
                                        string="Discount" type="action" class="btn btn-secondary"/>
                            </div>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="discount_total"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Other Info" name="other">
                            <group>
                                <group>
                                    <field name="payment_term_id" readonly="state not in ('draft', 'budget_control')"
                                           required="state in ('draft', 'budget_control') and 'payment_term_id' in er_required_fields"/>
                                    <field name="fiscal_position_id" readonly="state not in ('draft', 'budget_control')"
                                           required="state in ('draft', 'budget_control') and 'fiscal_position_id' in er_required_fields"/>
                                    <field name="incoterm_id" readonly="state not in ('draft', 'budget_control')"
                                           required="state in ('draft', 'budget_control') and 'incoterm_id' in er_required_fields"/>
                                    <field name="odoo_po_id"/>
                                </group>
                                <group invisible="not reject_reason">
                                    <field name="reject_reason"/>
                                </group>
                            </group>
                            <field name="notes" placeholder="Terms and conditions..."
                                   required="state in ('draft', 'budget_control') and 'notes' in er_required_fields"/>
                        </page>
                        <page string="Approval History" name="approvals">
                            <field name="approval_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="user_id"/>
                                    <field name="stage"/>
                                    <field name="action"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_epo_kanban" model="ir.ui.view">
        <field name="name">employee.purchase.order.kanban</field>
        <field name="model">employee.purchase.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column er-mobile-kanban"
                    group_create="false" group_edit="false" group_delete="false"
                    quick_create="false" records_draggable="false" sample="1">
                <field name="state"/>
                <field name="activity_state"/>
                <field name="currency_id"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                             sum_field="amount_total"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <field name="name" class="fw-bold"/>
                            <field name="amount_total" widget="monetary" class="fw-bold text-primary"/>
                        </div>
                        <div class="text-muted small text-truncate" invisible="not partner_id">
                            <i class="fa fa-truck me-1" title="Vendor"/><field name="partner_id"/>
                        </div>
                        <div class="text-success small d-none d-md-block" invisible="not discount_total">
                            <i class="fa fa-tag me-1" title="Discount"/><field name="discount_total" widget="monetary"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <div class="d-flex align-items-center text-muted small">
                                <field name="employee_id" widget="many2one_avatar_employee" class="me-1"/>
                                <field name="date_order" widget="date"/>
                                <span class="ms-2"><i class="fa fa-list me-1" title="Lines"/><field name="line_count"/></span>
                                <i class="fa fa-check-circle text-success ms-2" title="Odoo purchase order created"
                                   invisible="not odoo_po_id"/>
                            </div>
                            <field name="activity_ids" widget="kanban_activity"/>
                        </div>
                        <field name="odoo_po_id" invisible="1"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_epo_search" model="ir.ui.view">
        <field name="name">employee.purchase.order.search</field>
        <field name="model">employee.purchase.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="request_id"/>
                <field name="project_id"/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_approval" string="In Approval"
                        domain="[('state', 'in', ('manager', 'budget', 'budget_control'))]"/>
                <filter name="f_budget_rejected" string="Budget Rejected"
                        domain="[('state', '=', 'budget_rejected')]"/>
                <filter name="f_to_approve" string="To Approve"
                        domain="[('pending_approver_ids', 'in', [uid])]"/>
                <filter name="f_ordered" string="Odoo PO Created"
                        domain="[('odoo_po_id', '!=', False)]"/>
                <filter name="f_open" string="Open" domain="[('state', '=', 'approved')]"/>
                <filter name="f_closed" string="Closed" domain="[('state', '=', 'done')]"/>
                <filter name="f_invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_epo_new" model="ir.actions.act_window">
        <field name="name">New Purchase Order</field>
        <field name="res_model">employee.purchase.order</field>
        <field name="view_mode">form,list</field>
        <field name="target">current</field>
    </record>

    <record id="action_epo_all" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">employee.purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_epo_search"/>
    </record>

    <record id="action_epo_requests" model="ir.actions.act_window">
        <field name="name">Requests Purchase Orders</field>
        <field name="res_model">employee.purchase.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('request_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_epo_search"/>
    </record>

    <record id="action_er_agreements" model="ir.actions.act_window">
        <field name="name">Agreements</field>
        <field name="res_model">purchase.requisition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
