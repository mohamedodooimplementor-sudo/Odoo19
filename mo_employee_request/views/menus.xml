              parent="stock.menu_warehouse_report" action="action_er_expiry"
              groups="stock.group_stock_user" sequence="47"/>
    <!-- Same report inside Inventory > Reporting -->
    <menuitem id="menu_stock_project_stock_report" name="Project Stock"
              parent="stock.menu_warehouse_report" action="action_er_project_stock"
              groups="stock.group_stock_user" sequence="45"/>

    <!-- ===== Configuration ===== -->
    <menuitem id="menu_employee_request_config" name="Configuration"
              parent="menu_employee_request_root" groups="base.group_system" sequence="90"/>
    <menuitem id="menu_employee_request_settings" name="Settings"
              parent="menu_employee_request_config" action="action_employee_request_settings"
              groups="base.group_system" sequence="10"/>
    <menuitem id="menu_er_required_field" name="Required Field"
              parent="menu_employee_request_config" action="action_er_required_field"
              groups="base.group_system" sequence="20"/>
</odoo>
