<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_er_required_field_list" model="ir.ui.view">
        <field name="name">er.required.field.list</field>
        <field name="model">er.required.field</field>
        <field name="arch" type="xml">
            <list string="Required Fields" editable="bottom" create="0" delete="0" expand="1">
                <field name="sequence" widget="handle"/>
                <field name="document_type" readonly="1" column_invisible="1"/>
                <field name="scope" readonly="1"/>
                <field name="field_id" readonly="1" options="{'no_open': True}"/>
                <field name="is_required"/>
            </list>
        </field>
    </record>

    <record id="view_er_required_field_search" model="ir.ui.view">
        <field name="name">er.required.field.search</field>
        <field name="model">er.required.field</field>
        <field name="arch" type="xml">
            <search string="Required Fields">
                <field name="field_id"/>
                <filter name="filter_required" string="Required" domain="[('is_required', '=', True)]"/>
                <filter name="filter_not_required" string="Not Required" domain="[('is_required', '=', False)]"/>
                <group>
                    <filter name="group_document" string="Document" context="{'group_by': 'document_type'}"/>
                    <filter name="group_scope" string="Section" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_er_required_field" model="ir.actions.act_window">
        <field name="name">Required Fields</field>
        <field name="res_model">er.required.field</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_er_required_field_search"/>
        <field name="context">{'search_default_group_document': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No configurable fields</p>
        </field>
    </record>
</odoo>
