<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_employee_purchase_order" model="ir.actions.report">
        <field name="name">Employee Purchase Order</field>
        <field name="model">employee.purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mo_employee_request.report_epo_document</field>
        <field name="report_file">mo_employee_request.report_epo_document</field>
        <field name="print_report_name">'EPO - %s' % object.name</field>
        <field name="binding_model_id" ref="model_employee_purchase_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_epo_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><t t-if="o.state == 'draft'">Request for Quotation</t><t t-else="">Purchase Order</t> <span t-field="o.name"/></h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Vendor</strong>
                                <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <div><strong>Date:</strong> <span t-field="o.date_order"/></div>
                                <div t-if="o.employee_id"><strong>Employee:</strong> <span t-field="o.employee_id"/></div>
                                <div t-if="o.request_id"><strong>Request:</strong> <span t-field="o.request_id.name"/></div>
                                <div t-if="o.agreement_id"><strong>Agreement:</strong> <span t-field="o.agreement_id.name"/></div>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Disc.%</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/> <span t-field="line.product_uom_id"/></td>
                                    <td class="text-end"><span t-field="line.price_unit"/></td>
                                    <td class="text-end"><span t-field="line.discount"/></td>
                                    <td class="text-end"><span t-out="', '.join(line.tax_ids.mapped('name'))"/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="clearfix">
                            <div class="row justify-content-end">
                                <div class="col-5">
                                    <table class="table table-sm">
                                        <tr><td>Untaxed Amount</td><td class="text-end"><span t-field="o.amount_untaxed"/></td></tr>
                                        <tr><td>Total Discount</td><td class="text-end"><span t-field="o.discount_total"/></td></tr>
                                        <tr><td>Taxes</td><td class="text-end"><span t-field="o.amount_tax"/></td></tr>
                                        <tr class="fw-bold"><td>Total</td><td class="text-end"><span t-field="o.amount_total"/></td></tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div t-if="o.notes" t-field="o.notes"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
