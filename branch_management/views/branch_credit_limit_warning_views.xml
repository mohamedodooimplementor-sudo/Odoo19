<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_branch_credit_limit_warning_form" model="ir.ui.view">
        <field name="name">branch.credit.limit.warning.form</field>
        <field name="model">branch.credit.limit.warning</field>
        <field name="arch" type="xml">
            <form string="Credit Limit Exceeded">
                <div class="alert alert-danger" role="alert">
                    <strong>Credit Limit Exceeded</strong><br/>
                    This customer or branch has exceeded the available credit limit.
                </div>
                <group>
                    <group>
                        <field name="branch_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="branch_limit" readonly="1"/>
                        <field name="branch_exposure" readonly="1"/>
                        <field name="customer_limit" readonly="1"/>
                        <field name="customer_exposure" readonly="1"/>
                    </group>
                </group>
                <p>Do you want to proceed?</p>
                <footer>
                    <button string="Proceed" name="action_proceed" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
