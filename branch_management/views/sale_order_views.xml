<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_branch" model="ir.ui.view">
        <field name="name">sale.order.form.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">['|', ('branch_ids', '=', False), ('branch_ids', 'in', [branch_id])]</attribute>
            </field>
            <field name="partner_id" position="before">
                <div class="alert alert-danger" role="alert"
                     invisible="not credit_limit_exceeded" colspan="2">
                    <field name="credit_limit_message" nolabel="1" readonly="1"/>
                </div>
            </field>
            <field name="partner_id" position="after">
                <field name="branch_id" options="{'no_create': True}" readonly="state in ('sale', 'done')"/>
                <field name="allowed_branch_ids" invisible="1"/>
            </field>
            <field name="warehouse_id" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), '|', ('branch_id', '=', False), ('branch_id', '=', branch_id)]</attribute>
            </field>
            <field name="warehouse_id" position="after">
                <field name="sale_journal_id" invisible="1"/>
                <field name="branch_analytic_account_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_branch" model="ir.ui.view">
        <field name="name">sale.order.filter.branch</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="branch_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter string="Branch" name="group_by_branch_id" context="{'group_by': 'branch_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
