<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_branch_sales_dashboard">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Branch Sales Performance Report</h2>
                    <p>
                        Period:
                        <span t-esc="data['dashboard']['date_from'] or 'N/A'"/>
                        -
                        <span t-esc="data['dashboard']['date_to'] or 'N/A'"/>
                    </p>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th class="text-end">Sales Amount</th>
                                <th class="text-end">Paid Amount</th>
                                <th class="text-end">Outstanding Amount</th>
                                <th class="text-end">Orders Count</th>
                                <th class="text-end">Customers Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="data['dashboard']['lines']" t-as="line">
                                <td><span t-esc="line['branch_name']"/></td>
                                <td class="text-end"><span t-esc="'%.2f' % line['sales_amount']"/></td>
                                <td class="text-end"><span t-esc="'%.2f' % line['paid_amount']"/></td>
                                <td class="text-end"><span t-esc="'%.2f' % line['outstanding_amount']"/></td>
                                <td class="text-end"><span t-esc="line['orders_count']"/></td>
                                <td class="text-end"><span t-esc="line['customers_count']"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td><strong>Total</strong></td>
                                <td class="text-end"><strong t-esc="'%.2f' % data['dashboard']['totals']['sales_amount']"/></td>
                                <td class="text-end"><strong t-esc="'%.2f' % data['dashboard']['totals']['paid_amount']"/></td>
                                <td class="text-end"><strong t-esc="'%.2f' % data['dashboard']['totals']['outstanding_amount']"/></td>
                                <td class="text-end"><strong t-esc="data['dashboard']['totals']['orders_count']"/></td>
                                <td class="text-end"><strong t-esc="data['dashboard']['totals']['customers_count']"/></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_branch_sales_dashboard" model="ir.actions.report">
        <field name="name">Branch Sales Performance</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">branch_management.report_branch_sales_dashboard</field>
        <field name="print_report_name">'Branch Sales Performance Report'</field>
    </record>

</odoo>
