<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="branch_management.BranchPurchaseDashboard">
        <div class="o_branch_purchase_dashboard p-3" t-ref="root">
            <div class="row">
                <div class="col-lg-3 col-md-4">
                    <div class="card p-3 mb-3">
                        <h5>Filters</h5>
                        <div class="mb-2">
                            <label class="form-label">Date From</label>
                            <input type="date" class="form-control"
                                   t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Date To</label>
                            <input type="date" class="form-control"
                                   t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Branch</label>
                            <select class="form-select"
                                    t-on-change="(ev) => this.onFilterChange('branch_id', ev)">
                                <option value="">All</option>
                                <t t-foreach="state.branches" t-as="branch" t-key="branch.id">
                                    <option t-att-value="branch.id"><t t-esc="branch.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Vendor</label>
                            <select class="form-select"
                                    t-on-change="(ev) => this.onFilterChange('partner_id', ev)">
                                <option value="">All</option>
                                <t t-foreach="state.partners" t-as="partner" t-key="partner.id">
                                    <option t-att-value="partner.id"><t t-esc="partner.name"/></option>
                                </t>
                            </select>
                        </div>
                        <button class="btn btn-primary w-100" t-on-click="onApply">Apply</button>
                    </div>
                </div>

                <div class="col-lg-9 col-md-8">
                    <div class="row mb-3 g-2">
                        <div class="col">
                            <div class="card p-3 text-center h-100">
                                <div class="text-muted small">Total Purchases</div>
                                <h4><t t-esc="formatMoney(state.data.totals.purchase_amount)"/></h4>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card p-3 text-center h-100">
                                <div class="text-muted small">Total Paid</div>
                                <h4><t t-esc="formatMoney(state.data.totals.paid_amount)"/></h4>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card p-3 text-center h-100">
                                <div class="text-muted small">Total Outstanding</div>
                                <h4 class="text-danger"><t t-esc="formatMoney(state.data.totals.outstanding_amount)"/></h4>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card p-3 text-center h-100">
                                <div class="text-muted small">Orders Count</div>
                                <h4><t t-esc="state.data.totals.orders_count"/></h4>
                            </div>
                        </div>
                        <div class="col">
                            <div class="card p-3 text-center h-100">
                                <div class="text-muted small">Vendors</div>
                                <h4><t t-esc="state.data.totals.vendors_count"/></h4>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <button class="btn btn-outline-success me-2" t-on-click="onExportExcel">
                            <i class="fa fa-file-excel-o me-1"/> Export Excel
                        </button>
                        <button class="btn btn-outline-danger" t-on-click="onExportPdf">
                            <i class="fa fa-file-pdf-o me-1"/> Print PDF
                        </button>
                    </div>

                    <div class="row">
                        <div class="col-lg-8">
                            <table class="table table-striped table-sm">
                                <thead>
                                    <tr>
                                        <th>Branch</th>
                                        <th class="text-end">Purchase Amount</th>
                                        <th class="text-end">Paid Amount</th>
                                        <th class="text-end">Outstanding Amount</th>
                                        <th class="text-end">Orders Count</th>
                                        <th class="text-end">Vendors Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.lines" t-as="line" t-key="line.branch_id">
                                        <tr>
                                            <td><t t-esc="line.branch_name"/></td>
                                            <td class="text-end"><t t-esc="formatMoney(line.purchase_amount)"/></td>
                                            <td class="text-end"><t t-esc="formatMoney(line.paid_amount)"/></td>
                                            <td class="text-end"><t t-esc="formatMoney(line.outstanding_amount)"/></td>
                                            <td class="text-end"><t t-esc="line.orders_count"/></td>
                                            <td class="text-end"><t t-esc="line.vendors_count"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong t-esc="formatMoney(state.data.totals.purchase_amount)"/></td>
                                        <td class="text-end"><strong t-esc="formatMoney(state.data.totals.paid_amount)"/></td>
                                        <td class="text-end"><strong t-esc="formatMoney(state.data.totals.outstanding_amount)"/></td>
                                        <td class="text-end"><strong t-esc="state.data.totals.orders_count"/></td>
                                        <td class="text-end"><strong t-esc="state.data.totals.vendors_count"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        <div class="col-lg-4 text-center">
                            <canvas class="branch_purchase_pie_chart" width="220" height="220"/>
                            <div class="mt-2 text-start d-inline-block">
                                <t t-foreach="state.data.lines" t-as="line" t-key="line.branch_id">
                                    <div>
                                        <span t-attf-style="display:inline-block;width:10px;height:10px;background-color:{{ getColor(line_index) }};margin-inline-end:6px;"/>
                                        <t t-esc="line.branch_name"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
