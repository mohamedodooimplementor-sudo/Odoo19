<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rc_room_stock_view_list" model="ir.ui.view">
        <field name="name">stock.quant.rc.room.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="rc_room_stock_view_search" model="ir.ui.view">
        <field name="name">stock.quant.rc.room.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="lot_id"/>
                <group>
                    <filter name="group_room" string="Room" context="{'group_by': 'location_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="rc_room_stock_action" model="ir.actions.act_window">
        <field name="name">Room Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.usage', '=', 'internal'), '|', ('location_id.is_room', '=', True), ('location_id.is_lab', '=', True), ('quantity', '>', 0)]</field>
        <field name="context">{'search_default_group_room': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rc_room_stock_view_list')})]"/>
        <field name="search_view_id" ref="rc_room_stock_view_search"/>
    </record>
</odoo>
