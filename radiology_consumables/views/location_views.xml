<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rc_room_view_list" model="ir.ui.view">
        <field name="name">stock.location.rc.room.list</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="is_room"/>
                <field name="is_lab"/>
                <field name="rc_responsible_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="rc_room_view_form" model="ir.ui.view">
        <field name="name">stock.location.rc.room.form</field>
        <field name="model">stock.location</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="%(action_report_rc_room)d" string="Print Room Stock" type="action" class="btn-secondary"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location_id" string="Parent Location"/>
                            <field name="usage"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="is_room"/>
                            <field name="is_lab"/>
                        </group>
                    </group>
                    <group string="Room Staff (can receive items and record exams for this room)">
                        <field name="rc_responsible_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rc_room_action" model="ir.actions.act_window">
        <field name="name">Rooms and Labs</field>
        <field name="res_model">stock.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('is_room', '=', True), ('is_lab', '=', True)]</field>
        <field name="context">{'default_usage': 'internal', 'default_is_room': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rc_room_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('rc_room_view_form')})]"/>
    </record>

    <record id="rc_company_view_list" model="ir.ui.view">
        <field name="name">res.company.rc.list</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="rc_company_view_form" model="ir.ui.view">
        <field name="name">res.company.rc.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="rc_consumption_location_id"/>
                        <field name="rc_loss_location_id"/>
                        <field name="rc_transit_location_id"/>
                        <field name="rc_auto_validate_exam_transfers"/>
                        <field name="rc_expiry_alert_days"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rc_company_action" model="ir.actions.act_window">
        <field name="name">Consumables Setup</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rc_company_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('rc_company_view_form')})]"/>
    </record>
</odoo>
