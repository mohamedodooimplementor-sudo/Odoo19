<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rc_template_view_list" model="ir.ui.view">
        <field name="name">rc.consumption.template.list</field>
        <field name="model">rc.consumption.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_tmpl_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="rc_template_view_form" model="ir.ui.view">
        <field name="name">rc.consumption.template.form</field>
        <field name="model">rc.consumption.template</field>
        <field name="arch" type="xml">
            <form>
                <header><button name="%(action_report_rc_template)d" string="Print Template" type="action" class="btn-secondary"/></header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="service_tmpl_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consumables">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="phase"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="condition"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="rc_template_action" model="ir.actions.act_window">
        <field name="name">Consumption Templates</field>
        <field name="res_model">rc.consumption.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
