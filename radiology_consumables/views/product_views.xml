<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rc_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.rc.consumables</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Exam Consumables" name="rc_consumables"
                      invisible="type != 'service'"
                      groups="radiology_consumables.group_rc_manager">
                    <group>
                        <group>
                            <field name="rc_is_exam"/>
                            <field name="rc_room_id" invisible="not rc_is_exam"/>
                        </group>
                        <group>
                            <field name="rc_template_id"/>
                        </group>
                    </group>
                    <button name="action_rc_create_template" type="object"
                            string="Create Consumables List" class="btn-primary"
                            invisible="rc_template_id or not id"/>
                    <field name="rc_line_ids" invisible="not rc_template_id">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="phase"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="condition"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
