<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="group_rc_nurse" model="res.groups">
        <field name="name">Consumables / Room Nurse</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_rc_storekeeper" model="res.groups">
        <field name="name">Consumables / Storekeeper</field>
        <field name="implied_ids" eval="[(4, ref('group_rc_nurse'))]"/>
    </record>
    <record id="group_rc_manager" model="res.groups">
        <field name="name">Consumables / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_rc_storekeeper'))]"/>
    </record>
    <record id="group_rc_analytics" model="res.groups">
        <field name="name">Consumables / Cost &amp; Performance Analyst</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <!-- Administrators can always open the analytics screens. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_rc_analytics'))]"/>
    </record>
</odoo>
