<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="rule_intercompany_operation_user" model="ir.rule">
        <field name="name">Intercompany Operation: User sees own companies</field>
        <field name="model_id" search="[('model','=','intercompany.operation')]" model="ir.model"/>
        <field name="domain_force">
            ['|', ('company_ids', 'in', company_ids), ('company_ids', '=', False)]
        </field>
        <field name="groups" eval="[(4, ref('group_intercompany_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
