<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <record id="ir_cron_intercompany_operation_approval_reminder" model="ir.cron">
        <field name="name">Intercompany: Remind Pending Operation Approvals</field>
        <field name="model_id" ref="model_intercompany_operation"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_pending_approvals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_intercompany_payment_approval_reminder" model="ir.cron">
        <field name="name">Intercompany: Remind Pending Payment Distribution Approvals</field>
        <field name="model_id" ref="model_intercompany_payment"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_pending_approvals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</data>
</odoo>
