<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_intercompany_operation_sale" model="ir.sequence">
        <field name="name">Intercompany Operation - Sale</field>
        <field name="code">intercompany.operation.sale</field>
