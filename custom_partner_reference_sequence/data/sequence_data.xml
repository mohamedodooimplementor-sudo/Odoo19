<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default global sequences (shared fallback across all companies).
         The post_init_hook also creates a company-specific copy of each
         of these for every existing company, so each company gets its
         own independent numbering once installed. -->
    <record id="seq_partner_customer" model="ir.sequence">
        <field name="name">Customer Reference</field>
        <field name="code">partner.customer.seq</field>
        <field name="prefix">C</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_partner_supplier" model="ir.sequence">
        <field name="name">Supplier Reference</field>
        <field name="code">partner.supplier.seq</field>
        <field name="prefix">S</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Used for plain contacts that are neither a customer nor a supplier -->
    <record id="seq_partner_contact" model="ir.sequence">
        <field name="name">Contact Reference</field>
        <field name="code">partner.contact.seq</field>
        <field name="prefix">P</field>
        <field name="padding">4</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
