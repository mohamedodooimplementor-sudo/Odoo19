<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Barcode Report Action -->
    <record id="action_report_product_uom_barcode" model="ir.actions.report">
        <field name="name">Print UoM Barcodes</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">uom_barcode_product_base.report_product_uom_barcode</field>
        <field name="report_file">uom_barcode_product_base.report_product_uom_barcode</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Barcode Report Template -->
    <template id="report_product_uom_barcode">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="product">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <t t-esc="product.name"/>
                            - UoM Barcodes
                        </h2>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Unit of Measure</th>
                                    <th>Category</th>
                                    <th>Barcode</th>
                                    <th>Barcode Image</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="product.uom_barcode_ids" t-as="uom_barcode">
                                    <tr>
                                        <td>
                                            <t t-esc="uom_barcode.uom_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="uom_barcode.uom_category_id.name"/>
                                        </td>
                                        <td>
                                            <t t-esc="uom_barcode.barcode"/>
                                        </td>
                                        <td>
                                            <img t-att-src="'/report/barcode/Code128/' + uom_barcode.barcode"
                                                 style="max-height: 50px;"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
