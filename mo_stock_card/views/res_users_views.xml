<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_stock_card" model="ir.ui.view">
        <field name="name">res.users.form.stock.card.permissions</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Stock Card Permissions" name="stock_card_permissions">
                    <group>
                        <field name="group_ids"
                               widget="many2many_checkboxes"
                               nolabel="1"
                               domain="[('id', 'in', [%(mo_stock_card.group_stock_card_costs)d, %(mo_stock_card.group_stock_card_schedule)d])]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
