<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_card_schedule_list" model="ir.ui.view">
        <field name="name">stock.card.schedule.list</field>
        <field name="model">stock.card.schedule</field>
        <field name="arch" type="xml">
            <list string="Stock Card Schedules">
                <field name="name"/>
                <field name="frequency"/>
                <field name="report_format"/>
                <field name="location_ids" widget="many2many_tags"/>
                <field name="recipient_ids" widget="many2many_tags"/>
                <field name="last_sent_date"/>
                <field name="last_run_status" widget="badge" decoration-success="last_run_status == 'success'" decoration-danger="last_run_status == 'failed'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_stock_card_schedule_form" model="ir.ui.view">
        <field name="name">stock.card.schedule.form</field>
        <field name="model">stock.card.schedule</field>
        <field name="arch" type="xml">
            <form string="Stock Card Schedule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_send_now" type="object" string="Send Now" class="btn-primary" icon="fa-paper-plane"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="last_run_status != 'failed'">
                        <strong>&#9888; Last run failed:</strong>
                        <field name="last_error_message" readonly="1" nolabel="1" class="oe_inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="frequency"/>
                            <field name="report_format"/>
                            <field name="next_period_note"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="location_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="include_child_locations"/>
                            <field name="group_by" widget="radio"/>
                        </group>
                    </group>
                    <group string="Filters (leave empty to include everything)">
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="categ_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="picking_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group string="Recipients">
                        <field name="recipient_ids" widget="many2many_tags" options="{'no_create': True}" nolabel="1"/>
                    </group>
                    <group string="Status">
                        <field name="last_sent_date" readonly="1"/>
                        <field name="last_run_status" readonly="1" widget="badge" decoration-success="last_run_status == 'success'" decoration-danger="last_run_status == 'failed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_card_schedule" model="ir.actions.act_window">
        <field name="name">Stock Card Schedules</field>
        <field name="res_model">stock.card.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_stock_card_schedule"
              name="Stock Card Schedules"
              parent="stock.menu_warehouse_report"
              action="action_stock_card_schedule"
              sequence="100"
              groups="mo_stock_card.group_stock_card_schedule"/>
</odoo>
