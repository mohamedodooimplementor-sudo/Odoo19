<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_tender_user" model="res.groups">
        <field name="name">Tender: User</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_tender_manager" model="res.groups">
        <field name="name">Tender: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_tender_user'))]"/>
    </record>

    <!-- Administrators get the manager role automatically -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('tender_management.group_tender_manager'))]"/>
    </record>

    <record id="tm_tender_company_rule" model="ir.rule">
        <field name="name">Tender: multi-company</field>
        <field name="model_id" ref="model_tm_tender"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
