<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_tm_landscape" model="report.paperformat">
        <field name="name">Tender Landscape A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">33</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_tender_proposal" model="ir.actions.report">
        <field name="name">Tender Proposal</field>
        <field name="model">tm.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.report_tender_proposal</field>
        <field name="report_file">tender_management.report_tender_proposal</field>
        <field name="print_report_name">'Tender Proposal - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_tm_tender"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tender_costing" model="ir.actions.report">
        <field name="name">Tender Costing Sheet</field>
        <field name="model">tm.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.report_tender_costing</field>
        <field name="report_file">tender_management.report_tender_costing</field>
        <field name="print_report_name">'Tender Costing - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_tm_landscape"/>
        <field name="binding_model_id" ref="model_tm_tender"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tender_variance" model="ir.actions.report">
        <field name="name">Tender Actual vs Estimated Cost</field>
        <field name="model">tm.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.report_tender_variance</field>
        <field name="report_file">tender_management.report_tender_variance</field>
        <field name="print_report_name">'Actual vs Estimated - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_tm_landscape"/>
        <field name="binding_model_id" ref="model_tm_tender"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_tender_summary" model="ir.actions.report">
        <field name="name">Tenders Summary</field>
        <field name="model">tm.tender</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.report_tender_summary</field>
        <field name="report_file">tender_management.report_tender_summary</field>
        <field name="print_report_name">'Tenders Summary'</field>
        <field name="paperformat_id" ref="paperformat_tm_landscape"/>
        <field name="binding_model_id" ref="model_tm_tender"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_bom_cost" model="ir.actions.report">
        <field name="name">BOM Cost Sheet</field>
        <field name="model">mrp.bom</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.report_bom_cost</field>
        <field name="report_file">tender_management.report_bom_cost</field>
        <field name="print_report_name">'BOM Cost - %s' % (object.display_name or '')</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================ Tender Proposal (customer facing, no costs) -->
    <template id="report_tender_proposal">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mb-3">Tender Proposal <span t-field="o.name"/></h2>
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer</strong>
                                <div t-field="o.partner_id"
                                     t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True}'/>
                            </div>
                            <div class="col-6">
                                <div><strong>Tender Date:</strong> <span t-field="o.tender_date"/></div>
                                <div t-if="o.validity_days"><strong>Validity:</strong> <span t-field="o.validity_days"/> <span>days</span></div>
                                <div t-if="o.payment_term_id"><strong>Payment Terms:</strong> <span t-field="o.payment_term_id"/></div>
                                <div t-if="o.user_id"><strong>Responsible:</strong> <span t-field="o.user_id"/></div>
                            </div>
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-start">#</th>
                                    <th class="text-start">Product</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-start">UoM</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <tr t-foreach="o.line_ids.sorted('sequence')" t-as="line">
                                    <t t-set="i" t-value="i + 1"/>
                                    <td><t t-esc="i"/></td>
                                    <td><span t-field="line.product_id"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.uom_id"/></td>
                                    <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    <td class="text-end"><span t-field="line.total_price" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr class="border-black">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end"><strong><span t-field="o.amount_sale" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div t-if="o.note" class="mt-3">
                            <strong>Notes</strong>
                            <div t-field="o.note"/>
                        </div>
                        <div class="row mt-5 pt-5">
                            <div class="col-6 text-center"><div style="border-top:1px solid currentColor;margin:0 40px;padding-top:4px;">Prepared by</div></div>
                            <div class="col-6 text-center"><div style="border-top:1px solid currentColor;margin:0 40px;padding-top:4px;">Customer acceptance</div></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================ Tender Costing Sheet (internal) -->
    <template id="report_tender_costing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:11px;">
                        <h3 class="mb-2">Tender Costing Sheet <span t-field="o.name"/></h3>
                        <div class="row mb-3">
                            <div class="col-4"><strong>Customer:</strong> <span t-field="o.partner_id"/></div>
                            <div class="col-3"><strong>Date:</strong> <span t-field="o.tender_date"/></div>
                            <div class="col-3"><strong>Deadline:</strong> <span t-field="o.deadline"/></div>
                            <div class="col-2"><strong>Status:</strong> <span t-field="o.state"/></div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th class="text-end">Qty</th>
                                    <th>UoM</th>
                                    <th>BOM</th>
                                    <th class="text-end">Materials / Unit</th>
                                    <th class="text-end">Labour / Unit</th>
                                    <th class="text-end">Overhead / Unit</th>
                                    <th class="text-end">Other / Unit</th>
                                    <th class="text-end">BOM Cost / Unit</th>
                                    <th class="text-end">Total BOM Cost</th>
                                    <th class="text-end">Sale Price</th>
                                    <th class="text-end">Total Sale</th>
                                    <th class="text-end">Profit</th>
                                    <th class="text-end">Margin %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <tr t-foreach="o.line_ids.sorted('sequence')" t-as="line">
                                    <t t-set="i" t-value="i + 1"/>
                                    <td><t t-esc="i"/></td>
                                    <td><span t-field="line.product_id"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                    <td><span t-field="line.uom_id"/></td>
                                    <td><span t-esc="line.bom_id.display_name or '-'"/></td>
                                    <td class="text-end"><span t-esc="line.material_cost_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.labour_cost_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.overhead_cost_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.other_cost_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><strong><span t-esc="line.bom_cost_unit" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    <td class="text-end"><span t-esc="line.total_bom_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.total_price" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.profit" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-esc="line.margin_percent" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row">
                            <div class="col-7">
                                <div t-if="o.cost_ids">
                                    <strong>Tender Additional Costs</strong>
                                    <table class="table table-sm table-bordered mt-1">
                                        <thead><tr><th>Type</th><th>Description</th><th class="text-end">Amount</th></tr></thead>
                                        <tbody>
                                            <tr t-foreach="o.cost_ids" t-as="cost">
                                                <td><span t-field="cost.cost_type"/></td>
                                                <td><span t-field="cost.name"/></td>
                                                <td class="text-end"><span t-field="cost.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="col-5">
                                <table class="table table-sm table-bordered">
                                    <tr><td>Total Sale</td><td class="text-end"><span t-field="o.amount_sale" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                    <tr><td>BOM Costs</td><td class="text-end"><span t-field="o.amount_bom_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                    <tr><td>Tender Additional Costs</td><td class="text-end"><span t-field="o.amount_extra_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td></tr>
                                    <tr><td><strong>Tender Total Cost</strong></td><td class="text-end"><strong><span t-field="o.amount_total_cost" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td></tr>
                                    <tr><td><strong>Profit</strong></td><td class="text-end"><strong><span t-field="o.profit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></strong></td></tr>
                                    <tr><td><strong>Margin %</strong></td><td class="text-end"><strong><span t-esc="o.margin_percent" t-options='{"widget": "float", "precision": 2}'/>%</strong></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================ Actual vs Estimated cost -->
    <template id="report_tender_variance">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="rows" t-value="o._tm_actual_vs_estimated()"/>
                    <div class="page">
                        <h3 class="mb-2">Actual vs Estimated Cost <span t-field="o.name"/></h3>
                        <div class="row mb-3">
                            <div class="col-6"><strong>Customer:</strong> <span t-field="o.partner_id"/></div>
                            <div class="col-3"><strong>Date:</strong> <span t-field="o.tender_date"/></div>
                            <div class="col-3"><strong>Status:</strong> <span t-field="o.state"/></div>
                        </div>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Manufacturing Orders</th>
                                    <th class="text-end">Ordered</th>
                                    <th class="text-end">Produced</th>
                                    <th>UoM</th>
                                    <th class="text-end">Estimated Cost</th>
                                    <th class="text-end">Actual Cost</th>
                                    <th class="text-end">Variance</th>
                                    <th class="text-end">Variance %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="rows" t-as="row">
                                    <td><t t-esc="row['product']"/></td>
                                    <td><t t-esc="row['orders']"/></td>
                                    <td class="text-end"><t t-esc="row['qty_ordered']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="row['qty_produced']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td><t t-esc="row['uom']"/></td>
                                    <td class="text-end"><t t-esc="row['estimated']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="row['actual']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td t-attf-class="text-end #{row['variance'] &gt; 0 and 'text-danger' or 'text-success'}"><t t-esc="row['variance']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="row['variance_percent']" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                </tr>
                                <tr t-if="not rows">
                                    <td colspan="9" class="text-center text-muted">No completed manufacturing orders yet.</td>
                                </tr>
                            </tbody>
                            <tfoot t-if="rows">
                                <tr class="fw-bold">
                                    <td colspan="5">Total</td>
                                    <td class="text-end"><t t-esc="o.estimated_produced_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="o.actual_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="o.cost_variance" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="o.cost_variance_percent" t-options='{"widget": "float", "precision": 2}'/>%</td>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="text-muted" style="font-size:10px;">
                            Estimated = produced quantity x tender BOM cost per unit. Actual = value of the finished
                            product of the completed manufacturing orders (materials + BOM manufacturing costs).
                            A positive variance means the production cost more than estimated.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================ Tenders Summary (multi record) -->
    <template id="report_tender_summary">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-call="web.external_layout">
                <div class="page" style="font-size:11px;">
                    <h3 class="mb-3">Tenders Summary</h3>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Deadline</th>
                                <th>Status</th>
                                <th>Delivery</th>
                                <th>Invoicing</th>
                                <th class="text-end">Total Sale</th>
                                <th class="text-end">BOM Costs</th>
                                <th class="text-end">Additional Costs</th>
                                <th class="text-end">Total Cost</th>
                                <th class="text-end">Profit</th>
                                <th class="text-end">Margin %</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="t">
                                <td><span t-field="t.name"/></td>
                                <td><span t-field="t.partner_id"/></td>
                                <td><span t-field="t.tender_date"/></td>
                                <td><span t-field="t.deadline"/></td>
                                <td><span t-field="t.state"/></td>
                                <td><span t-field="t.delivery_status"/></td>
                                <td><span t-field="t.invoicing_status"/></td>
                                <td class="text-end"><span t-esc="t.amount_sale" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><span t-esc="t.amount_bom_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><span t-esc="t.amount_extra_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><span t-esc="t.amount_total_cost" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><span t-esc="t.profit" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><span t-esc="t.margin_percent" t-options='{"widget": "float", "precision": 2}'/>%</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="7">Total (<t t-esc="len(docs)"/> tenders)</td>
                                <td class="text-end"><t t-esc="sum(docs.mapped('amount_sale'))" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><t t-esc="sum(docs.mapped('amount_bom_cost'))" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><t t-esc="sum(docs.mapped('amount_extra_cost'))" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><t t-esc="sum(docs.mapped('amount_total_cost'))" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end"><t t-esc="sum(docs.mapped('profit'))" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================ BOM Cost Sheet -->
    <template id="report_bom_cost">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="bom" t-value="o.sudo()"/>
                    <div class="page">
                        <h2 class="mb-3">BOM Cost Sheet</h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <div><strong>Product:</strong> <span t-esc="bom.product_tmpl_id.display_name"/></div>
                                <div><strong>Reference:</strong> <span t-esc="bom.code or '-'"/></div>
                            </div>
                            <div class="col-6">
                                <div><strong>Quantity:</strong> <span t-esc="bom.product_qty"/> <span t-esc="bom.product_uom_id.name"/></div>
                                <div t-if="bom.company_id"><strong>Company:</strong> <span t-esc="bom.company_id.name"/></div>
                            </div>
                        </div>
                        <h5>Materials</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Component</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bom._tm_report_lines()" t-as="row">
                                    <td><t t-esc="row['product']"/></td>
                                    <td class="text-end"><t t-esc="row['qty']"/></td>
                                    <td><t t-esc="row['uom']"/></td>
                                    <td class="text-end"><t t-esc="row['unit_cost']" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><t t-esc="row['cost']" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 class="mt-4">Manufacturing Costs</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Description</th>
                                    <th>Account</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="bom.mfg_cost_line_ids" t-as="cost">
                                    <td><span t-field="cost.cost_type"/></td>
                                    <td><t t-esc="cost.name or ''"/></td>
                                    <td><t t-esc="cost.account_id.display_name or ''"/></td>
                                    <td class="text-end"><t t-esc="cost.amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row justify-content-end mt-3">
                            <div class="col-5">
                                <table class="table table-sm">
                                    <tr><td>Material Cost</td><td class="text-end"><t t-esc="bom.tm_material_cost" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    <tr><td>Manufacturing Costs</td><td class="text-end"><t t-esc="bom.tm_mfg_cost" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    <tr class="fw-bold"><td>Total BOM Cost</td><td class="text-end"><t t-esc="bom.tm_total_cost" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                    <tr><td>Cost / Unit</td><td class="text-end"><t t-esc="bom.tm_unit_cost" t-options='{"widget": "float", "precision": 2}'/></td></tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
