<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Dedicated product category for Tender Additional Cost. -->
    <record id="product_category_tm_landed_cost" model="product.category">
        <field name="name">Landed Cost</field>
    </record>

    <!-- Generic product used to carry each Additional Cost line onto an Odoo Landed Cost.
         Its own account/price/split method are overridden per line when the Landed Cost is created. -->
    <record id="product_tm_landed_cost" model="product.template">
        <field name="name">Tender Additional Cost</field>
        <field name="categ_id" ref="product_category_tm_landed_cost"/>
        <field name="type">service</field>
        <field name="landed_cost_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
        <field name="standard_price">0.0</field>
        <field name="split_method_landed_cost">equal</field>
    </record>
</odoo>
