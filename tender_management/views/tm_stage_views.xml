<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tm_tender_stage_view_list" model="ir.ui.view">
        <field name="name">tm.tender.stage.list</field>
        <field name="model">tm.tender.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" readonly="1"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="tm_tender_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">tm.tender.stage</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
