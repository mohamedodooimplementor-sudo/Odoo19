<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_landed_cost_form_inherit_tm" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.inherit.tender.management</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_tm_tender" type="object" class="btn-secondary" icon="fa-gavel" string="Tender"
                        invisible="not tender_id" groups="tender_management.group_tender_manager">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
