<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tm_tender_report_wizard_view_form" model="ir.ui.view">
        <field name="name">tm.tender.report.wizard.form</field>
        <field name="model">tm.tender.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tenders Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="state"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="tm_tender_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Tenders Report</field>
        <field name="res_model">tm.tender.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
