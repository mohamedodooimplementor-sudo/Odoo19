<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_tm" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tender.management</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tender" type="object" class="oe_stat_button" icon="fa-gavel"
                        invisible="not tender_id" groups="tender_management.group_tender_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tender</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
