<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_construction_budget_category_list" model="ir.ui.view">
        <field name="name">construction.budget.category.list</field>
        <field name="model">construction.budget.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type"/>
                <field name="expense_account_id"/>
                <field name="allowed_company_ids" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_construction_project_budget_list" model="ir.ui.view">
        <field name="name">construction.project.budget.list</field>
        <field name="model">construction.project.budget</field>
        <field name="arch" type="xml">
            <list decoration-danger="utilization &gt; 100"
                  decoration-warning="utilization &gt;= 80 and utilization &lt;= 100">
                <field name="name"/>
                <field name="project_id"/>
                <field name="stage_id"/>
                <field name="planned_total"/>
                <field name="committed_total" optional="show"/>
                <field name="actual_total"/>
                <field name="remaining_total"/>
                <field name="utilization"/>
                <field name="income_total" optional="hide"/>
                <field name="profit_total" optional="hide"
                       decoration-danger="profit_total &lt; 0" decoration-success="profit_total &gt;= 0"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_construction_project_budget_form" model="ir.ui.view">
        <field name="name">construction.project.budget.form</field>
        <field name="model">construction.project.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_previous_stage" type="object" string="◀ Move Back"
                            invisible="not previous_stage_id"
                            confirm="Move this budget back to a previous stage?"/>
                    <button name="action_next_stage" type="object" class="btn-primary"
                            invisible="not next_stage_id"
                            string="Move to Next Stage"/>
                    <field name="stage_id" widget="statusbar"/>
                    <field name="next_stage_id" invisible="1"/>
                    <field name="previous_stage_id" invisible="1"/>
                </header>
                <sheet>
                    <!-- 1. Smart buttons: where the money came from -->
                    <div class="oe_button_box o_cbd_form_button_box" name="button_box">
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-money"><field name="expense_count" widget="statinfo" string="Actual Spending"/></button>
                        <button name="action_view_project_expenses" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="project_expense_count" widget="statinfo" string="Manual Expenses"/></button>
                        <button name="action_view_labor_costs" type="object" class="oe_stat_button" icon="fa-users"><field name="labor_cost_count" widget="statinfo" string="Labor Entries"/></button>
                        <button name="action_view_stock_pickings" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_count"><field name="picking_count" widget="statinfo" string="Stock Transfers"/></button>
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_count"><field name="purchase_count" widget="statinfo" string="Purchase Orders"/></button>
                        <button name="action_view_vendor_bills" type="object" class="oe_stat_button" icon="fa-file-text" invisible="not vendor_bill_count"><field name="vendor_bill_count" widget="statinfo" string="Vendor Bills"/></button>
                        <button name="action_view_customer_invoices" type="object" class="oe_stat_button" icon="fa-line-chart" invisible="not customer_invoice_count"><field name="customer_invoice_count" widget="statinfo" string="Customer Invoices"/></button>
                        <button name="action_view_journal_entries" type="object" class="oe_stat_button" icon="fa-book" invisible="not journal_entry_count"><field name="journal_entry_count" widget="statinfo" string="Journal Entries"/></button>
                    </div>

                    <!-- 2. Identity -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tower A - Construction Budget"/></h1>
                    </div>

                    <!-- 3. Left: what this budget belongs to. Right: how it is performing -->
                    <group name="main">
                        <group name="general" string="General">
                            <field name="project_id"/>
                            <field name="analytic_account_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id"/>
                        </group>
                        <group name="summary" string="Financial Summary">
                            <field name="planned_total" readonly="1"/>
                            <field name="committed_total" readonly="1"/>
                            <field name="actual_total" readonly="1"/>
                            <field name="remaining_total" readonly="1"
                                   decoration-danger="remaining_total &lt; 0"/>
                            <field name="utilization" readonly="1"
                                   decoration-danger="utilization &gt; 100"
                                   decoration-warning="utilization &gt;= 80 and utilization &lt;= 100"
                                   decoration-success="utilization &lt; 80"/>
                            <separator string="Profitability"/>
                            <field name="income_total" readonly="1"/>
                            <field name="profit_total" readonly="1"
                                   decoration-danger="profit_total &lt; 0" decoration-success="profit_total &gt;= 0"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Budget" name="budget_lines">
                            <div class="mb-2">
                                <button name="action_copy_categories_from_budget" type="object"
                                        string="Copy Categories From..." class="btn-secondary"
                                        invisible="line_ids"/>
                            </div>
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-danger="utilization &gt; 100"
                                      decoration-warning="utilization &gt;= 80 and utilization &lt;= 100">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category_id"/>
                                    <field name="planned_amount" sum="Planned"/>
                                    <field name="committed_amount" readonly="1" sum="Committed"/>
                                    <field name="actual_amount" readonly="1" sum="Actual"/>
                                    <field name="remaining_amount" readonly="1" sum="Remaining"/>
                                    <field name="utilization" readonly="1"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actual Spending" name="actual_spending">
                            <field name="expense_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="source_type"/>
                                    <field name="reference" optional="show"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="quantity" optional="hide"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group string="Defaults for Manual Expenses &amp; Labor Entries">
                                <field name="expense_journal_id"/>
                                <field name="expense_counterpart_account_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_construction_project_budget_expense_list" model="ir.ui.view">
        <field name="name">construction.project.budget.expense.list</field>
        <field name="model">construction.project.budget.expense</field>
        <field name="arch" type="xml">
            <list decoration-muted="cost_is_estimated" decoration-danger="amount &lt; 0">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_id" optional="hide"/>
                <field name="category_id"/>
                <field name="source_type"/>
                <field name="reference" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="quantity" optional="hide"/>
                <field name="cost_is_estimated" readonly="1" optional="hide"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_construction_project_budget_expense_form" model="ir.ui.view">
        <field name="name">construction.project.budget.expense.form</field>
        <field name="model">construction.project.budget.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_source" type="object" string="Open Source Document" class="btn-secondary" invisible="not source_model"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not cost_is_estimated">
                        This amount is an estimate based on the product's current Cost Price - no exact
                        accounting valuation was available when it was posted (e.g. manual/periodic
                        inventory valuation is configured for this product).
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="What was this cost for?"/></h1>
                    </div>
                    <group name="main">
                        <group name="allocation" string="Allocation">
                            <field name="budget_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="category_id"/>
                        </group>
                        <group name="entry" string="Entry">
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <group name="source" string="Source">
                        <group>
                            <field name="source_type" readonly="1"/>
                            <field name="cost_is_estimated" readonly="1" invisible="not source_model"/>
                        </group>
                        <group invisible="not product_id">
                            <field name="product_id" readonly="1"/>
                            <field name="quantity" readonly="1"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ Manual Project Expense ============ -->
    <record id="view_construction_project_expense_list" model="ir.ui.view">
        <field name="name">construction.project.expense.list</field>
        <field name="model">construction.project.expense</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_id" optional="hide"/>
                <field name="category_id"/>
                <field name="employee_id" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_project_expense_search" model="ir.ui.view">
        <field name="name">construction.project.expense.search</field><field name="model">construction.project.expense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_id"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <filter name="my_expenses" string="My Expenses" domain="[('create_uid', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="date_filter" date="date" string="Date"/>
                <group name="group_by">
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_construction_project_expense_form" model="ir.ui.view">
        <field name="name">construction.project.expense.form</field>
        <field name="model">construction.project.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','confirmed')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="construction_project_budget.group_construction_budget_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not move_id">
                            <div class="o_stat_info"><span class="o_stat_text">Journal Entry</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="What was this expense for?"/></h1>
                    </div>
                    <group name="main">
                        <group name="allocation" string="Allocation">
                            <field name="project_id"/>
                            <field name="budget_id"/>
                            <field name="category_id"/>
                        </group>
                        <group name="details" string="Details">
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="employee_id"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <field name="move_id" invisible="1"/>
                    <field name="available_budget_category_ids" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="allowed_company_ids" invisible="1"/>
                    <notebook>
                        <page string="Accounting" name="accounting">
                            <group>
                                <field name="expense_account_id"/>
                                <field name="counterpart_account_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ Labor Cost Entry ============ -->
    <record id="view_construction_labor_cost_list" model="ir.ui.view">
        <field name="name">construction.labor.cost.list</field>
        <field name="model">construction.labor.cost</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="project_id"/>
                <field name="budget_id" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="hours" sum="Hours"/>
                <field name="hourly_rate"/>
                <field name="total_cost" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="view_construction_labor_cost_search" model="ir.ui.view">
        <field name="name">construction.labor.cost.search</field><field name="model">construction.labor.cost</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="budget_id"/>
                <field name="category_id"/>
                <field name="employee_id"/>
                <filter name="my_entries" string="My Entries" domain="[('create_uid', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="date_filter" date="date" string="Date"/>
                <group name="group_by">
                    <filter name="group_by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_construction_labor_cost_form" model="ir.ui.view">
        <field name="name">construction.labor.cost.form</field>
        <field name="model">construction.labor.cost</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','confirmed')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="construction_project_budget.group_construction_budget_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-book" invisible="not move_id">
                            <div class="o_stat_info"><span class="o_stat_text">Journal Entry</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Description (auto-filled from the employee and date)"/></h1>
                    </div>
                    <group name="main">
                        <group name="allocation" string="Who &amp; Where">
                            <field name="employee_id"/>
                            <field name="project_id"/>
                            <field name="budget_id"/>
                            <field name="category_id"/>
                        </group>
                        <group name="cost" string="Time &amp; Cost">
                            <field name="date"/>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="total_cost" readonly="1" class="fw-bold"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <field name="move_id" invisible="1"/>
                    <field name="available_budget_category_ids" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="allowed_company_ids" invisible="1"/>
                    <notebook>
                        <page string="Accounting" name="accounting">
                            <group>
                                <field name="expense_account_id"/>
                                <field name="counterpart_account_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
