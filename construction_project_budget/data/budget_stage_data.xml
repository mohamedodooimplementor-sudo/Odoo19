<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="budget_stage_draft" model="construction.budget.stage">
        <field name="name">Draft</field>
        <field name="sequence">10</field>
    </record>
    <record id="budget_stage_submitted" model="construction.budget.stage">
        <field name="name">Pending Approval</field>
        <field name="sequence">20</field>
    </record>
    <record id="budget_stage_approved" model="construction.budget.stage">
        <field name="name">Approved</field>
        <field name="sequence">30</field>
        <field name="is_approved">True</field>
    </record>
    <record id="budget_stage_in_progress" model="construction.budget.stage">
        <field name="name">In Progress</field>
        <field name="sequence">40</field>
        <field name="is_approved">True</field>
    </record>
    <record id="budget_stage_closed" model="construction.budget.stage">
        <field name="name">Closed</field>
        <field name="sequence">50</field>
        <field name="fold">True</field>
        <field name="is_closed">True</field>
        <field name="is_approved">True</field>
    </record>
</odoo>
