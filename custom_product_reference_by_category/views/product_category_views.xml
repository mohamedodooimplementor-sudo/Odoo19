<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_inherit_sequence" model="ir.ui.view">
        <field name="name">product.category.form.inherit.sequence</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="sequence_id"/>
            </xpath>
        </field>
    </record>

    <!-- Make the product's Category field mandatory on the product form -->
    <record id="view_product_template_form_inherit_categ_required" model="ir.ui.view">
        <field name="name">product.template.form.inherit.categ.required</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_view_inherit_sequence" model="ir.ui.view">
        <field name="name">product.category.list.inherit.sequence</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="sequence_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
