<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_insurance_claim" model="ir.sequence">
        <field name="name">Insurance Claim</field>
        <field name="code">insurance.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_insurance_authorization" model="ir.sequence">
        <field name="name">Insurance Authorization</field>
        <field name="code">insurance.authorization</field>
        <field name="prefix">AUTH/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Suggested codes for new Insurance Companies / Plans: they are filled in
         automatically and can be changed by the user. -->
    <record id="seq_insurance_company_code" model="ir.sequence">
        <field name="name">Insurance Company Code</field>
        <field name="code">insurance.company.code</field>
        <field name="prefix">INS</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_insurance_plan_code" model="ir.sequence">
        <field name="name">Insurance Plan Code</field>
        <field name="code">insurance.plan.code</field>
        <field name="prefix">PLN</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
