<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_company_list" model="ir.ui.view">
        <field name="name">insurance.company.list</field>
        <field name="model">insurance.company</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="contact_person"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="plan_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_company_form" model="ir.ui.view">
        <field name="name">insurance.company.form</field>
        <field name="model">insurance.company</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_plans" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="plan_count" widget="statinfo" string="Plans"/>
                        </button>
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button name="action_view_policies" type="object" class="oe_stat_button" icon="fa-id-card-o">
                            <field name="policy_count" widget="statinfo" string="Policies"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-invoice">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. AXA"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Contact">
                            <field name="contact_person"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Financial">
                            <field name="payment_term_id"/>
                            <field name="default_payment_due_days"/>
                            <field name="credit_limit"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="default_coverage_percentage"/>
                                    <field name="annual_coverage_limit"/>
                                    <field name="requires_authorization"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_company" model="ir.actions.act_window">
        <field name="name">Insurance Companies</field>
        <field name="res_model">insurance.company</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
