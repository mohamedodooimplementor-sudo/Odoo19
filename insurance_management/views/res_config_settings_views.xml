<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone form (NOT inherited from base.res_config_settings_view_form) -
         the base "Settings" mega-page's internal structure has changed across
         Odoo versions and inheriting it via xpath is fragile. This gives the
         module its own simple settings screen instead, opened directly from
         Insurance > Configuration > Settings. -->
    <record id="res_config_settings_view_form_insurance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.insurance</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Insurance Settings">
                <header>
                    <button string="Save" type="object" name="execute" class="oe_highlight" data-hotkey="s"/>
                    <button string="Discard" type="object" name="cancel" class="oe_link" data-hotkey="j"/>
                </header>
                <sheet>
                    <div class="app_settings_block" data-string="Insurance" string="Insurance"
                         data-key="insurance_management">
                        <h2>Insurance Billing</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="insurance_invoice_journal_id"/>
                                    <div class="text-muted">
                                        Journal used for the insurance company's own invoice, generated
                                        automatically when a patient invoice with an Insurance Company set
                                        is posted. Leave empty to use the same journal as the patient's
                                        invoice.
                                    </div>
                                    <field name="insurance_invoice_journal_id"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="insurance_rejection_account_id"/>
                                    <div class="text-muted">
                                        Expense account charged when an insurance company rejects part of
                                        an invoice. Used by the credit note that "Post Rejections" books on
                                        a claim.
                                    </div>
                                    <field name="insurance_rejection_account_id"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <label for="insurance_default_payment_journal_id"/>
                                    <div class="text-muted">
                                        Pre-filled as the default "Payment Journal" on every new Insurance
                                        Claim.
                                    </div>
                                    <field name="insurance_default_payment_journal_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_insurance_config_settings" model="ir.actions.act_window">
        <field name="name">Insurance Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="res_config_settings_view_form_insurance"/>
        <field name="target">current</field>
        <field name="context">{'module': 'insurance_management'}</field>
    </record>
</odoo>
