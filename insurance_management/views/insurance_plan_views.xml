<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_plan_list" model="ir.ui.view">
        <field name="name">insurance.plan.list</field>
        <field name="model">insurance.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="insurance_company_id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_coverage_percentage"/>
                <field name="annual_coverage_limit"/>
                <field name="requires_authorization"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_plan_form" model="ir.ui.view">
        <field name="name">insurance.plan.form</field>
        <field name="model">insurance.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_policies" type="object" class="oe_stat_button" icon="fa-id-card-o">
                            <field name="policy_count" widget="statinfo" string="Policies"/>
                        </button>
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button name="action_view_coverage_rules" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="coverage_rule_count" widget="statinfo" string="Coverage Rules"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Gold"/></h1>
                    </div>
                    <group>
                        <group string="Plan">
                            <field name="insurance_company_id"/>
                            <field name="code"/>
                            <field name="active"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="requires_authorization"/>
                        </group>
                        <group string="Default Coverage">
                            <field name="default_coverage_percentage"/>
                            <field name="default_copay_percentage" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Coverage Limits">
                        <group>
                            <field name="max_coverage_amount"/>
                            <field name="annual_coverage_limit"/>
                        </group>
                        <group>
                            <field name="coverage_limit_per_transaction"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Coverage Rules">
                            <field name="coverage_rule_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="category_id"/>
                                    <field name="coverage_type"/>
                                    <field name="coverage_percentage"/>
                                    <field name="fixed_insurance_amount"/>
                                    <field name="max_coverage_amount"/>
                                    <field name="fixed_copay_amount"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Policies">
                            <field name="policy_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="policy_number"/>
                                    <field name="state"/>
                                    <field name="is_primary"/>
                                    <field name="coverage_remaining"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_plan" model="ir.actions.act_window">
        <field name="name">Insurance Plans</field>
        <field name="res_model">insurance.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
