<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_visit" model="ir.sequence">
            <field name="name">Customer Visit</field>
            <field name="code">mo.sales.visit</field>
            <field name="prefix">VIS/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_expense" model="ir.sequence">
            <field name="name">Rep Expense</field>
            <field name="code">mo.sales.expense</field>
            <field name="prefix">EXP/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_cheque" model="ir.sequence">
            <field name="name">Rep Cheque</field>
            <field name="code">mo.sales.cheque</field>
            <field name="prefix">CHQ/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="reason_damaged" model="mo.return.reason"><field name="name">Damaged</field><field name="sequence">1</field></record>
        <record id="reason_wrong" model="mo.return.reason"><field name="name">Wrong Product</field><field name="sequence">2</field></record>
        <record id="reason_request" model="mo.return.reason"><field name="name">Customer Request</field><field name="sequence">3</field></record>
        <record id="reason_expired" model="mo.return.reason"><field name="name">Expired</field><field name="sequence">4</field></record>
        <record id="reason_quality" model="mo.return.reason"><field name="name">Quality Issue</field><field name="sequence">5</field></record>
        <record id="reason_other" model="mo.return.reason"><field name="name">Other</field><field name="sequence">6</field></record>
        <record id="settings_default" model="mo.sales.rep.settings"/>
        <record id="cron_daily_visits" model="ir.cron">
            <field name="name">Sales Rep: generate today's visits &amp; mark missed</field>
            <field name="model_id" ref="model_mo_sales_visit"/>
            <field name="state">code</field>
            <field name="code">model.cron_daily()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
