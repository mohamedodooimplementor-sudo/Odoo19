<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Back-office access groups (the module itself, not the portal) ===== -->
    <record id="module_category_mo_sales_rep" model="ir.module.category">
        <field name="name">Sales Representative</field>
        <field name="sequence">46</field>
    </record>
    <record id="privilege_mo_sales_rep" model="res.groups.privilege">
        <field name="name">Sales Representative</field>
        <field name="category_id" ref="module_category_mo_sales_rep"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_mo_sales_rep_finance" model="res.groups.privilege">
        <field name="name">Sales Rep Finance</field>
        <field name="category_id" ref="module_category_mo_sales_rep"/>
        <field name="sequence">20</field>
    </record>
    <record id="group_mo_rep_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_mo_sales_rep_finance"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">Finance: sees all cheques, expenses, payments and invoices, approves expenses and moves cheques (deposit / clear / return). No dashboard, no configuration.</field>
    </record>
    <record id="group_mo_rep_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_mo_sales_rep"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Back-office user: sees reps, routes, visits, customers, orders, invoices, payments and creates visits / expenses / follow-ups.</field>
    </record>
    <record id="group_mo_rep_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_mo_sales_rep"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_mo_rep_user')), (4, ref('sales_team.group_sale_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full control: dashboard, configuration, approvals (expenses, cheques, customers) and all CRUD.</field>
    </record>

    <record id="group_sales_rep_portal" model="res.groups">
        <field name="name">Sales Representative Portal</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_mc_rep" model="ir.rule">
        <field name="name">Sales Rep Portal: multi-company (rep)</field>
        <field name="model_id" ref="model_mo_sales_rep"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mc_route" model="ir.rule">
        <field name="name">Sales Rep Portal: multi-company (route)</field>
        <field name="model_id" ref="model_mo_sales_route"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
