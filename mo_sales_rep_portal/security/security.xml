        <field name="name">Sales Rep back-office: own/team rep</field>
        <field name="model_id" ref="model_mo_sales_rep"/>
        <field name="groups" eval="[(4, ref('group_mo_rep_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
    </record>
