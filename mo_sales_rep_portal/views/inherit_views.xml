<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rep" model="ir.ui.view">
        <field name="name">sale.order.form.rep</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sales Representative Portal" invisible="not mo_rep_id">
                    <field name="mo_source"/>
                    <field name="mo_rep_id"/>
                    <field name="mo_visit_id"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_rep" model="ir.ui.view">
        <field name="name">account.move.form.rep</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sales Representative Portal" invisible="not mo_rep_id">
                    <field name="mo_source"/>
                    <field name="mo_rep_id"/>
                    <field name="mo_visit_id"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_payment_form_rep" model="ir.ui.view">
        <field name="name">account.payment.form.rep</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sales Representative Portal" invisible="not mo_rep_id">
                    <field name="mo_source"/>
                    <field name="mo_rep_id"/>
                    <field name="mo_visit_id"/>
                    <field name="mo_method_id"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_picking_form_rep" model="ir.ui.view">
        <field name="name">stock.picking.form.rep</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Sales Representative Portal" invisible="not mo_rep_id">
                    <field name="mo_source"/>
                    <field name="mo_rep_id"/>
                    <field name="mo_operation"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
