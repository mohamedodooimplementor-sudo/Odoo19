<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_accounting_date" model="ir.ui.view">
        <field name="name">stock.picking.form.accounting.date</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="use_accounting_date"
                       readonly="state in ('done', 'cancel')"/>
                <field name="accounting_date"
                       invisible="not use_accounting_date"
                       required="use_accounting_date"
                       readonly="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
