<odoo>
    <!-- Paper format: one check leaf per page, no margins. Edit size here if your leaf differs. -->
    <record id="paperformat_check_leaf" model="report.paperformat">
        <field name="name">Check Leaf (175 x 80 mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">175</field>
        <field name="page_height">80</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="True"/>
    </record>

    <record id="action_report_check_print" model="ir.actions.report">
        <field name="name">Print Check</field>
        <field name="model">check.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">check_management.report_check_print</field>
        <field name="report_file">check_management.report_check_print</field>
        <field name="print_report_name">'Check - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_check_leaf"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_report_check_print_sample" model="ir.actions.report">
        <field name="name">Print Sample Check</field>
        <field name="model">check.print.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">check_management.report_check_print_sample</field>
        <field name="report_file">check_management.report_check_print_sample</field>
        <field name="print_report_name">'Sample - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_check_leaf"/>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- One check leaf. `tpl` = check.print.template, `layout` = its inline styles, `values` = printed texts -->
    <template id="check_leaf">
        <div t-attf-class="o_check_leaf#{' o_check_leaf_full' if layout['full'] else ''}" t-att-style="layout['page']">
            <!-- ============ Full Check Design chrome (blank-paper mode only) ============ -->
            <t t-if="layout['full']">
                <div class="o_cl_border" t-att-style="layout['border']"/>
                <div class="o_cl_header" t-att-style="layout['header']">
                    <span class="o_cl_header_bank" t-out="values['bank_name']"/>
                    <span class="o_cl_header_ref" t-if="values['reference']" t-out="values['reference']"/>
                </div>
                <!-- Check Number: large, boxed, unmistakable — this is what real checks show top-right -->
                <div class="o_cl_abs o_cl_checkno" t-att-style="layout['checkno_wrap']">
                    <span class="o_cl_checkno_label">No.</span>
                    <span class="o_cl_checkno_value" t-out="values['check_number']"/>
                </div>
                <div class="o_cl_abs o_cl_amount_box" t-att-style="layout['amount_box']"/>
                <div class="o_cl_abs o_cl_rule" t-att-style="layout['payee_rule']"/>
                <div class="o_cl_abs o_cl_rule" t-att-style="layout['words_rule']"/>
                <div class="o_cl_abs o_cl_rule" t-if="layout.get('memo_rule')" t-att-style="layout['memo_rule']"/>
                <div class="o_cl_abs" t-if="layout.get('memo')" t-att-style="layout['memo']" t-out="values['reference']"/>
                <t t-foreach="layout['labels']" t-as="lbl" t-key="lbl_index">
                    <div class="o_cl_abs o_cl_label" t-att-style="lbl['style']" t-out="lbl['text']"/>
                </t>
                <div t-if="layout.get('signature')" class="o_cl_abs o_cl_signature" t-att-style="layout['signature']">
                    <div class="o_cl_signature_rule"/>
                    <span class="o_cl_signature_caption">Authorized Signature</span>
                </div>
                <div t-if="layout.get('micr')" class="o_cl_abs o_cl_micr" t-att-style="layout['micr']">
                    ⑈<t t-out="values['check_number']"/>⑈ <t t-out="values['bank_name']"/>⑈
                </div>
            </t>
            <div t-if="layout['crossed']" class="o_cl_abs o_cl_crossed" t-att-style="layout['crossed']">
                <span t-out="values['crossed_text']"/>
            </div>
            <div class="o_cl_abs" t-att-style="layout['date']" t-out="values['date']"/>
            <div class="o_cl_abs" t-att-dir="values['payee_dir']" t-attf-style="#{layout['payee']}text-align:#{values['payee_align']};" t-out="values['payee']"/>
            <div class="o_cl_abs" t-att-dir="values['words_dir']" t-attf-style="#{layout['words']}text-align:#{values['words_align']};" t-out="values['words']"/>
            <div class="o_cl_abs" t-att-style="layout['amount']" t-out="values['amount']"/>
        </div>
    </template>

    <template id="check_print_styles">
        <style>
            html, body { margin: 0 !important; padding: 0 !important; background: #fff; }
            .o_check_article { margin: 0; padding: 0; }
            .o_check_leaf { position: relative; overflow: hidden; page-break-after: always; page-break-inside: avoid; }
            .o_check_leaf:last-child { page-break-after: auto; }
            .o_cl_abs { position: absolute; white-space: nowrap; }
            .o_cl_crossed span { display: inline-block; padding: 0 2mm; border-top: 0.3mm solid #000; border-bottom: 0.3mm solid #000; font-size: 0.75em; text-transform: uppercase; }

            /* ============ Full Check Design chrome ============ */
            .o_check_leaf_full {
                background:
                    repeating-linear-gradient(135deg, rgba(0,0,0,.025) 0mm, rgba(0,0,0,.025) .3mm, transparent .3mm, transparent 2.2mm),
                    #fffdf7;
            }
            .o_cl_border { position: absolute; inset: 2.5mm; border: 0.6mm solid; border-radius: 1.5mm; pointer-events: none; }
            .o_cl_header {
                position: absolute; left: 2.5mm; right: 2.5mm; top: 2.5mm; height: 9mm;
                display: flex; align-items: center; justify-content: space-between;
                padding: 0 3mm; color: #fff; font-weight: bold; font-size: 9pt;
                border-radius: 1.2mm 1.2mm 0 0; letter-spacing: .2mm;
            }
            .o_cl_header_ref { font-size: 7.5pt; font-weight: normal; opacity: .9; font-family: 'Courier New', 'Liberation Mono', monospace; }
            .o_cl_checkno {
                display: flex; align-items: center; justify-content: center; gap: 1.5mm;
                height: 9mm; border: 0.4mm solid #000; border-radius: 1mm; background: #fff;
            }
            .o_cl_checkno_label { font-size: 8pt; opacity: .6; }
            .o_cl_checkno_value { font-size: 14pt; font-weight: 700; letter-spacing: .3mm; font-family: 'Courier New', 'Liberation Mono', monospace; }
            .o_cl_amount_box { border: 0.4mm solid; border-radius: 1mm; pointer-events: none; }
            .o_cl_rule { border-bottom: 0.25mm solid #000; height: 0; width: 0; }
            .o_cl_label { text-transform: uppercase; white-space: nowrap; }
            .o_cl_signature { text-align: center; }
            .o_cl_signature_rule { border-top: 0.25mm solid #000; margin-bottom: .8mm; }
            .o_cl_signature_caption { font-size: 6.5pt; text-transform: uppercase; letter-spacing: .3mm; opacity: .7; }
            .o_cl_micr { font-size: 11pt; letter-spacing: .6mm; opacity: .55; font-family: 'Courier New', 'Liberation Mono', monospace; }
        </style>
    </template>

    <template id="report_check_print">
        <t t-call="web.html_container">
            <!-- A single "article": Odoo wraps it in its minimal layout, which declares the charset
                 (without it wkhtmltopdf reads Arabic as Latin-1) and loads the report assets. -->
            <div class="article o_check_article">
                <t t-call="check_management.check_print_styles"/>
                <t t-foreach="pages" t-as="page">
                    <t t-call="check_management.check_leaf">
                        <t t-set="tpl" t-value="page['tpl']"/>
                        <t t-set="layout" t-value="page['layout']"/>
                        <t t-set="values" t-value="page['values']"/>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <template id="report_check_print_sample">
        <t t-call="web.html_container">
            <!-- A single "article": Odoo wraps it in its minimal layout, which declares the charset
                 (without it wkhtmltopdf reads Arabic as Latin-1) and loads the report assets. -->
            <div class="article o_check_article">
                <t t-call="check_management.check_print_styles"/>
                <t t-foreach="pages" t-as="page">
                    <t t-call="check_management.check_leaf">
                        <t t-set="tpl" t-value="page['tpl']"/>
                        <t t-set="layout" t-value="page['layout']"/>
                        <t t-set="values" t-value="page['values']"/>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- On-screen preview inside the template form (scaled up, optional scanned background) -->
    <template id="check_print_preview">
        <div class="o_check_preview_frame">
            <t t-call="check_management.check_print_styles"/>
            <style>
                .o_check_preview_frame { overflow-x: auto; padding: 8px 0; }
                .o_check_preview_sheet { position: relative; display: inline-block; zoom: 1.6; border: 1px solid #94a3b8; box-shadow: 0 2px 10px rgba(15,23,42,.25); background: #fffdf5; }
                .o_check_preview_sheet .o_check_leaf { page-break-after: auto; }
                .o_check_preview_bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: .55; }
                .o_check_preview_sheet .o_check_leaf { background: transparent; }
            </style>
            <div class="o_check_preview_sheet" t-att-style="'width:%smm;height:%smm;' % (tpl.width, tpl.height)">
                <img t-if="background" class="o_check_preview_bg" t-att-src="background" alt=""/>
                <t t-call="check_management.check_leaf"/>
            </div>
        </div>
    </template>
</odoo>
