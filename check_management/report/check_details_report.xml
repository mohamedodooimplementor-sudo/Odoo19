<odoo>
    <!-- ============ Check Details (the check FORM itself, one A4 page per check) ============ -->
    <record id="action_report_check_details" model="ir.actions.report">
        <field name="name">Check Details</field>
        <field name="model">check.management</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">check_management.report_check_details</field>
        <field name="report_file">check_management.report_check_details</field>
        <field name="print_report_name">'Check - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_check_management"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_check_details">
        <t t-call="web.html_container">
            <t t-set="state_colors" t-value="{
                'draft': '#64748b', 'received': '#2563eb', 'deposited': '#4f46e5',
                'under_collection': '#7c3aed', 'collected': '#059669', 'handed_over': '#0284c7',
                'cleared': '#0d9488', 'bounced': '#dc2626', 'cancelled': '#94a3b8',
            }"/>
            <t t-foreach="docs" t-as="check">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="check.company_id"/>
                    <div class="page">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h2 class="mb-1"><span t-field="check.name"/></h2>
                                <div class="text-muted">
                                    <span t-esc="'Incoming Check' if check.check_type == 'incoming' else 'Outgoing Check'"/>
                                </div>
                            </div>
                            <span class="badge rounded-pill px-3 py-2"
                                  t-attf-style="background-color:#{state_colors.get(check.state, '#94a3b8')};color:#fff;font-size:11pt;">
                                <span t-field="check.state"/>
                            </span>
                        </div>

                        <div t-if="check.is_overdue" class="alert alert-danger py-2 mb-3">
                            <strong>Overdue</strong> — this check was due on <span t-field="check.due_date"/>.
                        </div>

                        <table class="table table-sm o_main_table mb-4">
                            <tbody>
                                <tr>
                                    <td class="text-muted" style="width:32%;">Partner</td>
                                    <td><span t-field="check.partner_id"/></td>
                                    <td class="text-muted" style="width:32%;">Check Number</td>
                                    <td><strong><span t-field="check.check_number"/></strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Payee (as printed)</td>
                                    <td><span t-field="check.payee_name"/></td>
                                    <td class="text-muted">Issue Date</td>
                                    <td><span t-field="check.issue_date"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Bank</td>
                                    <td><span t-field="check.bank_id"/></td>
                                    <td class="text-muted">Due Date</td>
                                    <td t-attf-class="#{'text-danger fw-bold' if check.is_overdue else ''}"><span t-field="check.due_date"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Bank Journal</td>
                                    <td><span t-field="check.journal_id"/></td>
                                    <td class="text-muted">Amount</td>
                                    <td><strong t-field="check.amount" t-options="{'widget': 'monetary', 'display_currency': check.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Account Number</td>
                                    <td><span t-field="check.bank_account"/></td>
                                    <td class="text-muted">Print Count</td>
                                    <td><span t-field="check.print_count"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="check.invoice_ids">
                            <h5>Linked Invoices / Bills</h5>
                            <table class="table table-sm o_main_table mb-4">
                                <thead><tr><th>Reference</th><th>Date</th><th class="text-end">Total</th><th class="text-end">Residual</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="check.invoice_ids" t-as="inv">
                                        <td><span t-field="inv.name"/></td>
                                        <td><span t-field="inv.invoice_date"/></td>
                                        <td class="text-end"><span t-field="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/></td>
                                        <td class="text-end"><span t-field="inv.amount_residual" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="check.move_ids">
                            <h5>Journal Entries</h5>
                            <table class="table table-sm o_main_table mb-4">
                                <thead><tr><th>Reference</th><th>Date</th><th>Status</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="check.move_ids" t-as="move">
                                        <td><span t-field="move.name"/></td>
                                        <td><span t-field="move.date"/></td>
                                        <td><span t-field="move.state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="check.movement_ids">
                            <h5>Movement History</h5>
                            <table class="table table-sm o_main_table mb-4">
                                <thead><tr><th>Date</th><th>Status</th><th>User</th><th>Note</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="check.movement_ids.sorted('date')" t-as="mv">
                                        <td><span t-field="mv.date"/></td>
                                        <td><span t-field="mv.state_at_movement"/></td>
                                        <td><span t-field="mv.user_id"/></td>
                                        <td><span t-field="mv.note"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <t t-if="check.notes">
                            <h5>Notes</h5>
                            <p t-field="check.notes"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
