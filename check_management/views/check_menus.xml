<odoo>
    <record id="action_check_dashboard" model="ir.actions.client">
        <field name="name">Check Dashboard</field>
        <field name="tag">check_management_dashboard</field>
    </record>

    <menuitem id="menu_check_root" name="Checks" sequence="10" web_icon="check_management,static/description/icon.svg"/>

    <menuitem id="menu_check_dashboard" name="Dashboard" parent="menu_check_root" action="action_check_dashboard" sequence="1"/>
    <menuitem id="menu_check_incoming" name="Incoming Checks" parent="menu_check_root" action="action_check_incoming" sequence="10"/>
    <menuitem id="menu_check_outgoing" name="Outgoing Checks" parent="menu_check_root" action="action_check_outgoing" sequence="20"/>
    <menuitem id="menu_check_all" name="All Checks" parent="menu_check_root" action="action_check_management" sequence="30"/>
    <menuitem id="menu_check_entries" name="Journal Entries" parent="menu_check_root" action="action_check_journal_entries" sequence="35" groups="account.group_account_invoice,account.group_account_readonly"/>

    <menuitem id="menu_check_reports" name="Reports" parent="menu_check_root" sequence="50"/>
    <menuitem id="menu_report_incoming" name="Checks Received (Incoming)" parent="menu_check_reports" action="action_report_incoming" sequence="10"/>
    <menuitem id="menu_report_outgoing" name="Checks Sent (Outgoing)" parent="menu_check_reports" action="action_report_outgoing" sequence="20"/>
    <menuitem id="menu_report_maturity" name="Maturity Analysis" parent="menu_check_reports" action="action_report_maturity" sequence="30"/>
    <menuitem id="menu_report_overdue" name="Overdue Checks" parent="menu_check_reports" action="action_report_overdue" sequence="40"/>
    <menuitem id="menu_report_bounced" name="Bounced Checks" parent="menu_check_reports" action="action_report_bounced" sequence="50"/>

    <menuitem id="menu_check_config" name="Configuration" parent="menu_check_root" sequence="90" groups="check_management_group_manager"/>
    <menuitem id="menu_check_banks" name="Banks" parent="menu_check_config" action="action_check_banks" sequence="10"/>
    <menuitem id="menu_check_print_templates" name="Print Templates" parent="menu_check_config" action="action_check_print_templates" sequence="15"/>
    <menuitem id="menu_check_accounting_settings" name="Accounting Settings" parent="menu_check_config" action="action_check_config_open" sequence="20"/>
</odoo>
